// Сборка расширения решения вместе с модульными тестами.
//
// Зачем так. Расширение 1С видит конфигурацию и себя, но НЕ видит другие
// расширения: ни при компиляции, ни через Вычислить в рантайме. Поэтому
// тесты YAxUnit, лежащие отдельным расширением, не могут вызвать код решения.
//
// Тесты хранятся отдельными исходниками в tests/cfe/package-manager-tests,
// а перед прогоном накладываются на копию расширения решения. Получается одно
// расширение package-manager, где тесты и код видят друг друга. Поставляемая
// сборка при этом остаётся без тестов.
//
// Запуск:
//   oscript tasks/build-test-extension.os

#Использовать fs

Перем КаталогПроекта;
Перем КаталогРешения;
Перем КаталогТестов;
Перем КаталогСборки;

Процедура ОпределитьКаталоги()

	КаталогПроекта = Новый Файл(ТекущийСценарий().Каталог).Путь;

	КаталогРешения = ФС.ОбъединитьПути(КаталогПроекта, "src", "cfe", "package-manager");
	КаталогТестов = ФС.ОбъединитьПути(КаталогПроекта, "tests", "cfe", "package-manager-tests");

	КаталогВыхода = ФС.ОбъединитьПути(КаталогПроекта, "build", "out", "tests");
	КаталогСборки = ФС.ОбъединитьПути(КаталогВыхода, "cfe", "package-manager");

КонецПроцедуры

Функция ИменаТестовыхМодулей()

	Имена = Новый Массив;
	КаталогМодулей = ФС.ОбъединитьПути(КаталогТестов, "CommonModules");

	Для Каждого Файл Из НайтиФайлы(КаталогМодулей, "*.xml") Цикл
		Имена.Добавить(Лев(Файл.Имя, СтрДлина(Файл.Имя) - 4));
	КонецЦикла;

	Возврат Имена;

КонецФункции

Процедура СкопироватьРешение()

	ФС.ОбеспечитьПустойКаталог(КаталогСборки);
	ФС.КопироватьСодержимоеКаталога(КаталогРешения, КаталогСборки);

КонецПроцедуры

Процедура ПеренестиТестовыеМодули(Имена)

	ИсходныйКаталог = ФС.ОбъединитьПути(КаталогТестов, "CommonModules");
	ЦелевойКаталог = ФС.ОбъединитьПути(КаталогСборки, "CommonModules");

	Для Каждого Имя Из Имена Цикл

		КопироватьФайл(
			ФС.ОбъединитьПути(ИсходныйКаталог, Имя + ".xml"),
			ФС.ОбъединитьПути(ЦелевойКаталог, Имя + ".xml"));

		ЦелевойМодуль = ФС.ОбъединитьПути(ЦелевойКаталог, Имя);
		ФС.ОбеспечитьПустойКаталог(ЦелевойМодуль);
		ФС.КопироватьСодержимоеКаталога(ФС.ОбъединитьПути(ИсходныйКаталог, Имя), ЦелевойМодуль);

	КонецЦикла;

КонецПроцедуры

Процедура ОбъявитьТестовыеМодули(Имена)

	ПутьКонфигурации = ФС.ОбъединитьПути(КаталогСборки, "Configuration.xml");

	Чтение = Новый ЧтениеТекста(ПутьКонфигурации, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	// Общие модули объявляются одним блоком, порядок внутри блока
	// для платформы не важен, поэтому добавляем в его начало.
	Отступ = Символы.Таб + Символы.Таб + Символы.Таб;
	Якорь = Отступ + "<CommonModule>";
	Позиция = СтрНайти(Текст, Якорь);
	Если Позиция = 0 Тогда
		ВызватьИсключение "В Configuration.xml не найден блок общих модулей";
	КонецЕсли;

	Блок = "";
	Для Каждого Имя Из Имена Цикл
		Блок = Блок + Якорь + Имя + "</CommonModule>" + Символы.ВК + Символы.ПС;
	КонецЦикла;

	Текст = Лев(Текст, Позиция - 1) + Блок + Сред(Текст, Позиция);

	// Пометка, чтобы собранный каталог нельзя было спутать с поставкой.
	// Заменяется только первое вхождение - комментарий самой конфигурации.
	ПустойКомментарий = "<Comment/>";
	Метка = "<Comment>СБОРКА С ТЕСТАМИ. Не поставлять: содержит модули пмТест_*.</Comment>";
	ПозицияКомментария = СтрНайти(Текст, ПустойКомментарий);
	Если ПозицияКомментария > 0 Тогда
		Текст = Лев(Текст, ПозицияКомментария - 1) + Метка
			+ Сред(Текст, ПозицияКомментария + СтрДлина(ПустойКомментарий));
	КонецЕсли;

	Запись = Новый ЗаписьТекста(ПутьКонфигурации, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();

КонецПроцедуры

// Точка входа

ОпределитьКаталоги();

Если Не ФС.Существует(КаталогРешения) Тогда
	Сообщить("Нет исходников решения: " + КаталогРешения);
	ЗавершитьРаботу(1);
КонецЕсли;

Если Не ФС.Существует(КаталогТестов) Тогда
	Сообщить("Нет исходников тестов: " + КаталогТестов);
	ЗавершитьРаботу(1);
КонецЕсли;

ИменаМодулей = ИменаТестовыхМодулей();

СкопироватьРешение();
ПеренестиТестовыеМодули(ИменаМодулей);
ОбъявитьТестовыеМодули(ИменаМодулей);

Сообщить("Собрано: build/out/tests/cfe/package-manager");
Сообщить("Тестовых модулей добавлено: " + ИменаМодулей.Количество());
Для Каждого Имя Из ИменаМодулей Цикл
	Сообщить("  " + Имя);
КонецЦикла;
Сообщить("");
Сообщить("В тестовую базу грузится ЭТОТ каталог, а не src/cfe/package-manager.");
