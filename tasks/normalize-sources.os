// Приведение исходников к формату выгрузки Конфигуратора: UTF-8 с BOM и CRLF.
//
// Конфигуратор выгружает именно так. Файл, отредактированный сторонним
// инструментом с LF или без BOM, даст шумный diff при следующей выгрузке,
// а иногда и вовсе не загрузится.
//
// Запуск:
//   oscript tasks/normalize-sources.os          проверить и исправить
//   oscript tasks/normalize-sources.os --check  только проверить (для CI)
//
// Обрабатываются .bsl и .xml в src и tests/cfe/package-manager-tests.
// Движок YAxUnit не трогается: он сторонний и лежит вне этих каталогов.

#Использовать fs

Перем КаталогПроекта;
Перем ТолькоПроверка;
Перем Нарушений;
Перем Исправлено;

Функция КаталогиИсходников()

	Каталоги = Новый Массив;
	Каталоги.Добавить(ФС.ОбъединитьПути(КаталогПроекта, "src"));
	Каталоги.Добавить(ФС.ОбъединитьПути(КаталогПроекта, "tests", "cfe", "package-manager-tests"));

	Возврат Каталоги;

КонецФункции

Функция ОтносительныйПуть(Знач Путь)

	Остаток = Сред(Путь, СтрДлина(КаталогПроекта) + 1);

	// Каталог проекта может прийти как со слешем на конце, так и без него.
	Пока СтрНачинаетсяС(Остаток, "\") Или СтрНачинаетсяС(Остаток, "/") Цикл
		Остаток = Сред(Остаток, 2);
	КонецЦикла;

	Возврат СтрЗаменить(Остаток, "\", "/");

КонецФункции

// Возвращает Истина, если файл пришлось менять.
Функция ОбработатьФайл(Файл)

	Данные = Новый ДвоичныеДанные(Файл.ПолноеИмя);

	// ПолучитьСтрокуИзДвоичныхДанных снимает BOM молча, поэтому его
	// наличие определяется по первым трем байтам файла.
	ЕстьBOM = Ложь;
	Если Данные.Размер() >= 3 Тогда
		Чтение = Новый ЧтениеДанных(Файл.ПолноеИмя);
		Буфер = Чтение.ПрочитатьВБуферДвоичныхДанных(3);
		Чтение.Закрыть();
		ЕстьBOM = Буфер[0] = 239 И Буфер[1] = 187 И Буфер[2] = 191;
	КонецЕсли;

	Текст = ПолучитьСтрокуИзДвоичныхДанных(Данные, "UTF-8");

	// Сначала схлопываем CRLF в LF, затем разворачиваем обратно:
	// так смешанные переводы строк приводятся к одному виду.
	Эталон = СтрЗаменить(СтрЗаменить(Текст, Символы.ВК + Символы.ПС, Символы.ПС),
		Символы.ПС, Символы.ВК + Символы.ПС);

	Если ЕстьBOM И Эталон = Текст Тогда
		Возврат Ложь;
	КонецЕсли;

	Причина = "";
	Если Не ЕстьBOM Тогда
		Причина = "нет BOM";
	КонецЕсли;
	Если Эталон <> Текст Тогда
		Причина = ?(Причина = "", "", Причина + ", ") + "переводы строк не CRLF";
	КонецЕсли;

	Сообщить("  " + ОтносительныйПуть(Файл.ПолноеИмя) + " - " + Причина);
	Нарушений = Нарушений + 1;

	Если ТолькоПроверка Тогда
		Возврат Ложь;
	КонецЕсли;

	// BOM дописывается явным символом: ЗаписатьСимволы своего не добавляет.
	Запись = Новый ЗаписьДанных(Файл.ПолноеИмя);
	Запись.ЗаписатьСимволы(Символ(65279) + Эталон, "UTF-8");
	Запись.Закрыть();

	Исправлено = Исправлено + 1;

	Возврат Истина;

КонецФункции

Процедура ОбойтиКаталог(Путь)

	Для Каждого Файл Из НайтиФайлы(Путь, "*", Истина) Цикл

		Если Не Файл.ЭтоФайл() Тогда
			Продолжить;
		КонецЕсли;

		Расширение = НРег(Файл.Расширение);
		Если Расширение <> ".bsl" И Расширение <> ".xml" Тогда
			Продолжить;
		КонецЕсли;

		ОбработатьФайл(Файл);

	КонецЦикла;

КонецПроцедуры

// Точка входа

КаталогПроекта = Новый Файл(ТекущийСценарий().Каталог).Путь;
ТолькоПроверка = Ложь;

Для Каждого Аргумент Из АргументыКоманднойСтроки Цикл
	Если НРег(Аргумент) = "--check" Тогда
		ТолькоПроверка = Истина;
	КонецЕсли;
КонецЦикла;

Нарушений = 0;
Исправлено = 0;

Для Каждого Каталог Из КаталогиИсходников() Цикл
	Если ФС.Существует(Каталог) Тогда
		ОбойтиКаталог(Каталог);
	КонецЕсли;
КонецЦикла;

Если Нарушений = 0 Тогда
	Сообщить("Формат исходников в порядке: UTF-8 с BOM, CRLF");
	ЗавершитьРаботу(0);
КонецЕсли;

Если ТолькоПроверка Тогда
	Сообщить("");
	Сообщить("Файлов не в формате выгрузки: " + Нарушений);
	Сообщить("Исправить: oscript tasks/normalize-sources.os");
	ЗавершитьРаботу(1);
КонецЕсли;

Сообщить("");
Сообщить("Исправлено файлов: " + Исправлено);
