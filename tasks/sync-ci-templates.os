// Синхронизация шаблонов CI/CD в общие макеты расширения.
//
// Единственный источник истины для шаблонов публикации - каталог templates/ci.
// Расширение во время работы не имеет доступа к репозиторию, поэтому тексты
// шаблонов дублируются внутрь расширения как общие макеты (текстовые
// документы). Этот сценарий переносит их туда.
//
// Запускать после любой правки файлов в templates/ci:
//   oscript tasks/sync-ci-templates.os
//
// Правило проверяется дымовым тестом пмТест_Смоук.МакетыШаблоновПубликацииНаМесте:
// пустой макет означает, что синхронизацию забыли.

#Использовать fs

Перем КаталогПроекта;
Перем КаталогРасширения;

Функция Соответствия()

	// имя макета -> файл шаблона относительно templates/ci
	Результат = Новый Соответствие;
	Результат.Вставить("пм_ШаблонПубликацииGitLab", "gitlab/package.gitlab-ci.yml");
	Результат.Вставить("пм_ШаблонПубликацииJenkins", "jenkins/Jenkinsfile.package");
	Результат.Вставить("пм_ШаблонПубликацииGitHub", "github/package-release.yml");

	Возврат Результат;

КонецФункции

Функция ПутьШаблона(ОтносительныйПуть)

	Части = СтрРазделить(ОтносительныйПуть, "/");

	Возврат ФС.ОбъединитьПути(
		ФС.ОбъединитьПути(КаталогПроекта, "templates", "ci"),
		Части[0], Части[1]);

КонецФункции

Функция ПрочитатьТекст(Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат Текст;

КонецФункции

Процедура ЗаписатьТекст(Путь, Текст)

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();

КонецПроцедуры

// Точка входа

КаталогПроекта = Новый Файл(ТекущийСценарий().Каталог).Путь;
КаталогРасширения = ФС.ОбъединитьПути(КаталогПроекта, "src", "cfe", "package-manager");
КаталогМакетов = ФС.ОбъединитьПути(КаталогРасширения, "CommonTemplates");

Перенесено = 0;

Для Каждого Элемент Из Соответствия() Цикл

	ИмяМакета = Элемент.Ключ;
	Источник = ПутьШаблона(Элемент.Значение);

	Если Не ФС.Существует(Источник) Тогда
		Сообщить("НЕТ ИСХОДНИКА: " + Источник);
		ЗавершитьРаботу(1);
	КонецЕсли;

	КаталогМакета = ФС.ОбъединитьПути(КаталогМакетов, ИмяМакета, "Ext");
	Если Не ФС.Существует(КаталогМакета) Тогда
		Сообщить("НЕТ МАКЕТА В РАСШИРЕНИИ: " + ИмяМакета);
		Сообщить("Заведите общий макет типа ""Текстовый документ"" и объявите его в Configuration.xml");
		ЗавершитьРаботу(1);
	КонецЕсли;

	ЗаписатьТекст(ФС.ОбъединитьПути(КаталогМакета, "Template.txt"), ПрочитатьТекст(Источник));

	Сообщить(ИмяМакета + " <- templates/ci/" + Элемент.Значение);
	Перенесено = Перенесено + 1;

КонецЦикла;

Сообщить("");
Сообщить("Синхронизировано макетов: " + Перенесено);
