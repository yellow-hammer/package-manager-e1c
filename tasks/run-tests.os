// Полный цикл модульных тестов: сборка, загрузка в базу, прогон, разбор отчета.
//
// Запуск:
//   oscript tasks/run-tests.os
//
// Зачем отдельный сценарий, а не голый vrunner. YAxUnit возвращает нулевой код
// возврата и тогда, когда тестовый модуль не смог скомпилироваться: такой модуль
// молча выпадает из прогона, а отчет остается зеленым. Дважды поймали это на
// клиентском контексте (ТаблицаЗначений на тонком клиенте). Поэтому после прогона
// сверяем отчет со списком модулей на диске и читаем лог на ошибки загрузки.
//
// Прогон идет на ТОНКОМ клиенте (--ordinaryapp false). Толстый клиент видит
// серверные типы и пропускает ровно те ошибки, ради которых заведены
// клиентские тесты.

#Использовать fs
#Использовать 1commands

Перем КаталогПроекта;
Перем КаталогТестов;
Перем ПутьОтчета;
Перем ПутьЛога;
Перем ПутьКодаВозврата;
Перем Vrunner;

Функция ВыполнитьКоманду(Заголовок, Исполняемый, Параметры)

	Сообщить("==> " + Заголовок);

	Команда = Новый Команда;
	Команда.УстановитьКоманду(Исполняемый);
	Для Каждого Параметр Из Параметры Цикл
		Команда.ДобавитьПараметр(Параметр);
	КонецЦикла;
	Команда.УстановитьРабочийКаталог(КаталогПроекта);
	Команда.ПоказыватьВыводНемедленно(Ложь);

	КодВозврата = Команда.Исполнить();

	Если КодВозврата <> 0 Тогда
		Сообщить(Команда.ПолучитьВывод());
		Сообщить("ПРОВАЛ: " + Заголовок + ", код возврата " + КодВозврата);
		ЗавершитьРаботу(1);
	КонецЕсли;

	Возврат Команда.ПолучитьВывод();

КонецФункции

Функция ОжидаемыеМодули()

	Имена = Новый Соответствие;

	Для Каждого Файл Из НайтиФайлы(ФС.ОбъединитьПути(КаталогТестов, "CommonModules"), "*.xml") Цикл
		Имена.Вставить(Лев(Файл.Имя, СтрДлина(Файл.Имя) - 4), Ложь);
	КонецЦикла;

	Возврат Имена;

КонецФункции

// Имя набора в отчете выглядит как "пмТест_Адреса [Сервер]".
Функция ИмяМодуляНабора(ИмяНабора)

	Позиция = СтрНайти(ИмяНабора, " [");

	Возврат ?(Позиция = 0, ИмяНабора, Лев(ИмяНабора, Позиция - 1));

КонецФункции

Процедура РазобратьОтчет(Модули, Итоги)

	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ПутьОтчета);

	Пока Чтение.Прочитать() Цикл

		Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Или Чтение.Имя <> "testsuite" Тогда
			Продолжить;
		КонецЕсли;

		ИмяНабора = Чтение.ПолучитьАтрибут("name");
		Всего = Число(Чтение.ПолучитьАтрибут("tests"));
		Провалов = Число(?(Чтение.ПолучитьАтрибут("failures") = Неопределено, 0, Чтение.ПолучитьАтрибут("failures")));
		Ошибок = Число(?(Чтение.ПолучитьАтрибут("errors") = Неопределено, 0, Чтение.ПолучитьАтрибут("errors")));

		Итоги.Вставить("Всего", Итоги["Всего"] + Всего);
		Итоги.Вставить("Провалов", Итоги["Провалов"] + Провалов);
		Итоги.Вставить("Ошибок", Итоги["Ошибок"] + Ошибок);

		ИмяМодуля = ИмяМодуляНабора(ИмяНабора);
		Если Модули[ИмяМодуля] <> Неопределено Тогда
			Модули.Вставить(ИмяМодуля, Истина);
		КонецЕсли;

		Сообщить(?(Провалов + Ошибок = 0, "  ok   ", "  ПЛОХО") + " " + ИмяНабора + ": " + Всего);

	КонецЦикла;

	Чтение.Закрыть();

КонецПроцедуры

// Строка лога начинается с отметки вида "23:19:16.031".
Функция ЭтоОтметкаВремени(Строка)

	Если СтрДлина(Строка) < 9 Тогда
		Возврат Ложь;
	КонецЕсли;

	Шаблон = Лев(Строка, 9);

	Возврат СтрНайти(Шаблон, ":") = 3 И Сред(Шаблон, 6, 1) = ":" И Сред(Шаблон, 9, 1) = ".";

КонецФункции

Функция ОшибкиЗагрузки()

	Найденные = Новый Массив;

	Если Не ФС.Существует(ПутьЛога) Тогда
		Возврат Найденные;
	КонецЕсли;

	// Причина ошибки лежит в строках после нее, до следующей отметки времени.
	// Без них сообщение вида "ЗагрузкаТестов:" ничего не объясняет.
	Чтение = Новый ЧтениеТекста(ПутьЛога, КодировкаТекста.UTF8);
	Собираем = Ложь;
	Строка = Чтение.ПрочитатьСтроку();
	Пока Строка <> Неопределено Цикл

		Если СтрНайти(Строка, "[ERR]") > 0 Тогда
			Найденные.Добавить(СокрП(Строка));
			Собираем = Истина;
		ИначеЕсли Собираем Тогда
			Если ЭтоОтметкаВремени(Строка) Тогда
				Собираем = Ложь;
			ИначеЕсли Не ПустаяСтрока(Строка) Тогда
				Найденные.Добавить("    " + СокрП(Строка));
			КонецЕсли;
		КонецЕсли;

		Строка = Чтение.ПрочитатьСтроку();
	КонецЦикла;
	Чтение.Закрыть();

	Возврат Найденные;

КонецФункции

// Точка входа

КаталогПроекта = Новый Файл(ТекущийСценарий().Каталог).Путь;
КаталогТестов = ФС.ОбъединитьПути(КаталогПроекта, "tests", "cfe", "package-manager-tests");
КаталогОтчета = ФС.ОбъединитьПути(КаталогПроекта, "build", "out", "yaxunit");

ПутьОтчета = ФС.ОбъединитьПути(КаталогОтчета, "junit.xml");
ПутьЛога = ФС.ОбъединитьПути(КаталогОтчета, "log.txt");
ПутьКодаВозврата = ФС.ОбъединитьПути(КаталогОтчета, "result.txt");
Vrunner = ФС.ОбъединитьПути(КаталогПроекта, "oscript_modules", "bin", "vrunner.bat");

// Отчет прошлого прогона удаляется: иначе упавший запуск оставит зеленый
// отчет и разбор посчитает его свежим.
ФС.ОбеспечитьПустойКаталог(КаталогОтчета);

Параметры = Новый Массив;
Параметры.Добавить(ФС.ОбъединитьПути(КаталогПроекта, "tasks", "build-test-extension.os"));
ВыполнитьКоманду("Сборка расширения с тестами", "oscript", Параметры);

Параметры = Новый Массив;
Параметры.Добавить("compileext");
Параметры.Добавить("build/out/tests/cfe/package-manager");
Параметры.Добавить("package-manager");
Параметры.Добавить("--updatedb");
Параметры.Добавить("--settings");
Параметры.Добавить("env.json");
ВыполнитьКоманду("Загрузка в тестовую базу", Vrunner, Параметры);

Параметры = Новый Массив;
Параметры.Добавить("run");
Параметры.Добавить("--command");
Параметры.Добавить("RunUnitTests=./tools/yaxunit.json");
Параметры.Добавить("--settings");
Параметры.Добавить("env.json");
Параметры.Добавить("--ordinaryapp");
Параметры.Добавить("false");
ВыполнитьКоманду("Прогон YAxUnit на тонком клиенте", Vrunner, Параметры);

Сообщить("");
Сообщить("==> Разбор отчета");

Если Не ФС.Существует(ПутьОтчета) Тогда
	Сообщить("ПРОВАЛ: отчет не создан: " + ПутьОтчета);
	ЗавершитьРаботу(1);
КонецЕсли;

Модули = ОжидаемыеМодули();

Итоги = Новый Соответствие;
Итоги.Вставить("Всего", 0);
Итоги.Вставить("Провалов", 0);
Итоги.Вставить("Ошибок", 0);

РазобратьОтчет(Модули, Итоги);

Плохо = Ложь;

// Модуль без единого набора в отчете не выполнялся. Чаще всего он не
// скомпилировался в одном из контекстов - смотрите лог.
Для Каждого Элемент Из Модули Цикл
	Если Не Элемент.Значение Тогда
		Сообщить("ПРОВАЛ: модуль " + Элемент.Ключ + " не попал в отчет - тесты не выполнялись");
		Плохо = Истина;
	КонецЕсли;
КонецЦикла;

ОшибкиЛога = ОшибкиЗагрузки();
Если ОшибкиЛога.Количество() > 0 Тогда
	Сообщить("ПРОВАЛ: ошибки в логе прогона:");
	Для Каждого Строка Из ОшибкиЛога Цикл
		Сообщить("  " + Строка);
	КонецЦикла;
	Плохо = Истина;
КонецЕсли;

Если Итоги["Провалов"] + Итоги["Ошибок"] > 0 Тогда
	Плохо = Истина;
КонецЕсли;

КодЮнита = "";
Если ФС.Существует(ПутьКодаВозврата) Тогда
	Чтение = Новый ЧтениеТекста(ПутьКодаВозврата, КодировкаТекста.UTF8);
	КодЮнита = СокрЛП(Чтение.Прочитать());
	Чтение.Закрыть();
	Если КодЮнита <> "0" Тогда
		Сообщить("ПРОВАЛ: YAxUnit вернул код " + КодЮнита);
		Плохо = Истина;
	КонецЕсли;
КонецЕсли;

Сообщить("");
Сообщить("Модулей: " + Модули.Количество()
	+ ", тестов: " + Итоги["Всего"]
	+ ", провалов: " + Итоги["Провалов"]
	+ ", ошибок: " + Итоги["Ошибок"]);

Если Плохо Тогда
	Сообщить("ТЕСТЫ НЕ ПРОШЛИ");
	ЗавершитьРаботу(1);
КонецЕсли;

Сообщить("ТЕСТЫ ПРОШЛИ");
