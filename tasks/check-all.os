// Полная проверка перед сдачей: формат, модульные тесты, синтакс-контроль, BDD.
//
// Запуск:
//   oscript tasks/check-all.os
//   oscript tasks/check-all.os --no-bdd   без сценариев Vanessa
//
// Порядок не случаен. Модульные тесты грузят отдельное расширение
// package-manager-tests. После них package-manager снова берется из src,
// и синтакс-контроль с BDD проверяют ровно то, что уйдет в поставку.

#Использовать fs
#Использовать 1commands

Перем КаталогПроекта;
Перем Vrunner;
Перем Провалено;

Процедура Шаг(Заголовок, Исполняемый, Параметры)

	Сообщить("");
	Сообщить("======== " + Заголовок);

	Команда = Новый Команда;
	Команда.УстановитьКоманду(Исполняемый);
	Для Каждого Параметр Из Параметры Цикл
		Команда.ДобавитьПараметр(Параметр);
	КонецЦикла;
	Команда.УстановитьРабочийКаталог(КаталогПроекта);
	Команда.ПоказыватьВыводНемедленно(Истина);

	Если Команда.Исполнить() <> 0 Тогда
		Провалено.Добавить(Заголовок);
	КонецЕсли;

КонецПроцедуры

Функция Аргументы(ЗначенияЧерезЗапятую)

	Возврат СтрРазделить(ЗначенияЧерезЗапятую, ",");

КонецФункции

Функция Сценарий(Имя)

	Возврат ФС.ОбъединитьПути(КаталогПроекта, "tasks", Имя);

КонецФункции

// Точка входа

КаталогПроекта = Новый Файл(ТекущийСценарий().Каталог).Путь;
Vrunner = ФС.ОбъединитьПути(КаталогПроекта, "oscript_modules", "bin", "vrunner.bat");
Провалено = Новый Массив;

БезBDD = Ложь;
Для Каждого Аргумент Из АргументыКоманднойСтроки Цикл
	Если НРег(Аргумент) = "--no-bdd" Тогда
		БезBDD = Истина;
	КонецЕсли;
КонецЦикла;

Параметры = Новый Массив;
Параметры.Добавить(Сценарий("normalize-sources.os"));
Параметры.Добавить("--check");
Шаг("Формат исходников", "oscript", Параметры);

Параметры = Новый Массив;
Параметры.Добавить(Сценарий("run-tests.os"));
Шаг("Модульные тесты YAxUnit", "oscript", Параметры);

// Дальше проверяется поставка: package-manager без тестовых модулей.
Шаг("Загрузка чистого решения",
	Vrunner,
	Аргументы("compileext,src/cfe/package-manager,package-manager,--updatedb,--settings,env.json"));

Шаг("Синтакс-контроль", Vrunner, Аргументы("syntax-check,--settings,env.json"));

Если Не БезBDD Тогда
	Шаг("Сценарии Vanessa", Vrunner, Аргументы("vanessa,--settings,env.json"));
КонецЕсли;

Сообщить("");
Сообщить("========================================");

Если Провалено.Количество() = 0 Тогда
	Сообщить("ВСЕ ПРОВЕРКИ ПРОШЛИ");
	ЗавершитьРаботу(0);
КонецЕсли;

Сообщить("ПРОВАЛЕНО:");
Для Каждого Заголовок Из Провалено Цикл
	Сообщить("  " + Заголовок);
КонецЦикла;
ЗавершитьРаботу(1);
