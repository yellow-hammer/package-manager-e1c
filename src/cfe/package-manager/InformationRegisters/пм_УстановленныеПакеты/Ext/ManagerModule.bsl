#Область ПрограммныйИнтерфейс

// Записывает информацию об установленном пакете
//
// Параметры:
//  СтруктураЗаписи - Структура - структура записи, см. СтруктураЗаписи().
//
// Возвращаемое значение:
//   Булево - Истина, если информация успешно обновлена.
//
Функция ОбновитьСведения(СтруктураЗаписи) Экспорт
		
	УстановитьПривилегированныйРежим(Истина);
		
	Набор = СоздатьНаборЗаписей();	
	Набор.Отбор.Пакет.Установить(СтруктураЗаписи.Пакет);
	Набор.Прочитать();
	
	Если Набор.Количество() > 0 Тогда
		Запись = Набор[0];
	Иначе
		Запись = Набор.Добавить();
	КонецЕсли;
		
	Если Не ЗначениеЗаполнено(СтруктураЗаписи.ДатаУстановки) Тогда
		СтруктураЗаписи.ДатаУстановки = ТекущаяДатаСеанса();	
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Запись, СтруктураЗаписи);
				
	Попытка	
		Набор.Записать();		
	Исключение					
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось обновить информацию об установленном пакете %1 по причине: %2'"),
			СтруктураЗаписи.Пакет,
			ОписаниеОшибки());
		ВызватьИсключение ТекстОшибки;		
	КонецПопытки;
		
	Возврат Истина;
	
КонецФункции

Функция ВерсииПакетов(СписокПакетов = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);
		
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	УстановленныеПакеты.Пакет,
	|	УстановленныеПакеты.Версия,
	|	УстановленныеПакеты.ДатаУстановки
	|ИЗ
	|	РегистрСведений.пм_УстановленныеПакеты КАК УстановленныеПакеты";
	
	Если ЗначениеЗаполнено(СписокПакетов) Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|ГДЕ
		|	УстановленныеПакеты.Пакет В (&СписокПакетов)";
		Запрос.УстановитьПараметр("СписокПакетов", СписокПакетов);
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
		
КонецФункции

Функция УдалитьДублиПакета(ИмяПакета, ИмяБазовогоПакета) Экспорт

	Если ПустаяСтрока(ИмяБазовогоПакета) Тогда
		Возврат Истина;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УстановленныеПакеты.Пакет,
	|	УстановленныеПакеты.Версия,
	|	УстановленныеПакеты.ДатаУстановки
	|ИЗ
	|	РегистрСведений.пм_УстановленныеПакеты КАК УстановленныеПакеты
	|ГДЕ
	|	УстановленныеПакеты.Пакет ПОДОБНО &ИмяБазовогоПакета
	|	И НЕ УстановленныеПакеты.Пакет = &ИмяПакета";
	
	Запрос.УстановитьПараметр("ИмяБазовогоПакета", "%" + ИмяБазовогоПакета + "%");
	Запрос.УстановитьПараметр("ИмяПакета", ИмяПакета);

	РезультатЗапроса = Запрос.Выполнить();	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		МенеджерЗаписи = СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Выборка);
		
		Попытка		
			МенеджерЗаписи.Удалить();
		Исключение
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось удалить дубль пакета %1 по причине: %2'"),
				Выборка.Пакет,
				ОписаниеОшибки());
			ВызватьИсключение ТекстОшибки;		
		КонецПопытки;
				
	КонецЦикла;	
			
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СтруктураЗаписи() Экспорт
	
	СоставПолей = "
		|Пакет,
		|
		|Версия,
		|ДатаУстановки
		|";
	Возврат Новый Структура(СоставПолей);
	
КонецФункции

#КонецОбласти

#КонецЕсли