#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Для Каждого ЭлементСписка Из пм_ШаблоныПубликацииПакетов.СистемыCI() Цикл
		Элементы.СистемаCI.СписокВыбора.Добавить(
			ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;

	СистемаCI = пм_ШаблоныПубликацииПакетов.СистемаGitLab();
	ОбновитьПодсказкуНаСервере();
	ОбновитьВидимостьСкриптаНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СистемаCIПриИзменении(Элемент)

	ОбновитьПодсказкуНаСервере();
	ОбновитьВидимостьСкриптаНаСервере();

	Если ЗначениеЗаполнено(ТекстШаблона) Тогда
		СформироватьНаСервере();
	Иначе
		ТекстСкрипта = "";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)

	Если Не ЗначениеЗаполнено(СистемаCI) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите систему CI/CD.'"));
		Возврат;
	КонецЕсли;

	СформироватьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СохранитьВФайл(Команда)

	Если Не ЗначениеЗаполнено(ТекстШаблона) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала сформируйте шаблон.'"));
		Возврат;
	КонецЕсли;

	ДиалогСохранения = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогСохранения.Заголовок = НСтр("ru = 'Сохранить шаблон публикации'");
	ДиалогСохранения.ПолноеИмяФайла = ИмяФайлаШаблона();
	ДиалогСохранения.Фильтр = НСтр("ru = 'Все файлы (*.*)|*.*'");

	ДиалогСохранения.Показать(Новый ОписаниеОповещения("СохранитьВФайлЗавершение", ЭтотОбъект));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура СохранитьВФайлЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ЗаписьТекста = Новый ЗаписьТекста(ВыбранныеФайлы[0], КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(ТекстШаблона);
	ЗаписьТекста.Закрыть();

	ПутьСкрипта = "";
	Если ЗначениеЗаполнено(ТекстСкрипта) Тогда
		ФайлШаблона = Новый Файл(ВыбранныеФайлы[0]);
		ПутьСкрипта = ФайлШаблона.Путь + "publish-packages.os";
		ЗаписьСкрипта = Новый ЗаписьТекста(ПутьСкрипта, КодировкаТекста.UTF8);
		ЗаписьСкрипта.Записать(ТекстСкрипта);
		ЗаписьСкрипта.Закрыть();
	КонецЕсли;

	Если ЗначениеЗаполнено(ПутьСкрипта) Тогда
		ПоказатьОповещениеПользователя(
			НСтр("ru = 'Шаблон сохранен'"), ,
			ВыбранныеФайлы[0] + Символы.ПС + ПутьСкрипта);
	Иначе
		ПоказатьОповещениеПользователя(
			НСтр("ru = 'Шаблон сохранен'"), , ВыбранныеФайлы[0]);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()

	Попытка
		ТекстШаблона = пм_ШаблоныПубликацииПакетов.СформироватьШаблон(СистемаCI);
		ТекстСкрипта = пм_ШаблоныПубликацииПакетов.СформироватьСкриптПубликации(СистемаCI);
	Исключение
		ТекстШаблона = "";
		ТекстСкрипта = "";
		пм_ОбщегоНазначения.СообщитьПользователю(
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ОбновитьВидимостьСкриптаНаСервере();

КонецПроцедуры

&НаСервере
Процедура ОбновитьПодсказкуНаСервере()

	Подсказка = пм_ШаблоныПубликацииПакетов.ПодсказкаПоНастройке(СистемаCI);

КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьСкриптаНаСервере()

	Элементы.ТекстСкрипта.Видимость = ЗначениеЗаполнено(
		пм_ШаблоныПубликацииПакетов.ИмяФайлаСкриптаПубликации(СистемаCI));

КонецПроцедуры

&НаСервереБезКонтекста
Функция ИмяФайлаШаблонаПоСистеме(СистемаCI)

	Возврат пм_ШаблоныПубликацииПакетов.ИмяФайлаШаблона(СистемаCI);

КонецФункции

&НаКлиенте
Функция ИмяФайлаШаблона()

	Возврат ИмяФайлаШаблонаПоСистеме(СистемаCI);

КонецФункции

#КонецОбласти
