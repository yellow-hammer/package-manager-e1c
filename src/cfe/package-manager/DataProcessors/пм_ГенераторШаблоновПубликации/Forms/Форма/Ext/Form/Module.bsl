#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Для Каждого ЭлементСписка Из пм_ШаблоныПубликацииПакетов.СистемыCI() Цикл
		Элементы.СистемаCI.СписокВыбора.Добавить(
			ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;

	СистемаCI = пм_ШаблоныПубликацииПакетов.СистемаGitLab();

	// Значения по умолчанию берутся от самого менеджера пакетов.
	// Имя пакета и файла - Name из Configuration.xml.
	// Путь сборки: build/out/cfe/<Name>.cfe
	ИмяПакета = пм_МенеджерПакетовКлиентСервер.ИмяРасширенияМенеджера();
	ИмяФайлаCFE = ИмяПакета + ".cfe";
	ПутьКФайлуCFE = "build/out/cfe/" + ИмяФайлаCFE;

	ОбновитьПодсказкуНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СистемаCIПриИзменении(Элемент)

	ОбновитьПодсказкуНаСервере();

	Если ЗначениеЗаполнено(ТекстШаблона) Тогда
		СформироватьНаСервере();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)

	// Реквизиты формы штатной проверкой заполнения не охвачены,
	// поэтому проверяем явно.
	Незаполненные = Новый Массив;
	Если Не ЗначениеЗаполнено(ИмяПакета) Тогда
		Незаполненные.Добавить(НСтр("ru = 'Имя пакета'"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ИмяФайлаCFE) Тогда
		Незаполненные.Добавить(НСтр("ru = 'Имя файла CFE'"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПутьКФайлуCFE) Тогда
		Незаполненные.Добавить(НСтр("ru = 'Путь к файлу CFE'"));
	КонецЕсли;

	Если Незаполненные.Количество() > 0 Тогда
		ПоказатьПредупреждение(, СтрШаблон(
			НСтр("ru = 'Заполните: %1.'"), СтрСоединить(Незаполненные, ", ")));
		Возврат;
	КонецЕсли;

	СформироватьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СохранитьВФайл(Команда)

	Если Не ЗначениеЗаполнено(ТекстШаблона) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала сформируйте шаблон.'"));
		Возврат;
	КонецЕсли;

	ДиалогСохранения = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогСохранения.Заголовок = НСтр("ru = 'Сохранить шаблон публикации'");
	ДиалогСохранения.ПолноеИмяФайла = ИмяФайлаШаблонаНаСервере();
	ДиалогСохранения.Фильтр = НСтр("ru = 'Все файлы (*.*)|*.*'");

	ДиалогСохранения.Показать(Новый ОписаниеОповещения("СохранитьВФайлЗавершение", ЭтотОбъект));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура СохранитьВФайлЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ЗаписьТекста = Новый ЗаписьТекста(ВыбранныеФайлы[0], КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(ТекстШаблона);
	ЗаписьТекста.Закрыть();

	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Шаблон сохранен'"), , ВыбранныеФайлы[0], БиблиотекаКартинок.Информация32);

КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()

	// Имя Параметры занято свойством формы и недоступно для записи.
	Подстановки = пм_ШаблоныПубликацииПакетов.НовыеПараметрыШаблона();
	Подстановки.PACKAGE_NAME = СокрЛП(ИмяПакета);
	Подстановки.CFE_NAME = СокрЛП(ИмяФайлаCFE);
	Подстановки.CFE_PATH = СокрЛП(ПутьКФайлуCFE);

	Попытка
		ТекстШаблона = пм_ШаблоныПубликацииПакетов.СформироватьШаблон(СистемаCI, Подстановки);
	Исключение
		ТекстШаблона = "";
		пм_ОбщегоНазначения.СообщитьПользователю(
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ОбновитьПодсказкуНаСервере()

	Подсказка = пм_ШаблоныПубликацииПакетов.ПодсказкаПоНастройке(СистемаCI);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ИмяФайлаШаблонаНаСервереПоСистеме(СистемаCI)

	Возврат пм_ШаблоныПубликацииПакетов.ИмяФайлаШаблона(СистемаCI);

КонецФункции

&НаКлиенте
Функция ИмяФайлаШаблонаНаСервере()

	Возврат ИмяФайлаШаблонаНаСервереПоСистеме(СистемаCI);

КонецФункции

#КонецОбласти
