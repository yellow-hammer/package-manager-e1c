#Область ПрограммныйИнтерфейс

// Загружает и устанавливает указанные версии пакетов.
//
// Параметры:
//  ПараметрыЗагрузки - Массив - Элементы см. НовыеПараметрыЗагрузкиПакета
//  АдресРезультата - Строка - Адрес во временном хранилище для результатов.
//
Функция ЗагрузитьАктуальныеВерсииПакетов(ПараметрыЗагрузки, АдресРезультата = Неопределено) Экспорт

	Результат = ЗагрузитьПакетыПоПараметрам(ПараметрыЗагрузки);

	Если АдресРезультата <> Неопределено Тогда
		ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает каталог пакетов: пакеты и их версии по источникам.
// Источник не указан - читаются все источники без пометки удаления.
// Ошибка одного источника не роняет всю загрузку.
//
// Параметры:
//  ПараметрыКоманды - Структура - Источник, ЛимитВерсий, ФильтрВерсий.
//
// Возвращаемое значение:
//  Структура - Категории, Пакеты, Версии, ОшибкиИсточников.
//
Функция ДанныеМенеджераПакетов(ПараметрыКоманды) Экспорт

	ЛимитВерсий = ПараметрыКоманды.ЛимитВерсий;
	ФильтрВерсий = ПараметрыКоманды.ФильтрВерсий;

	Пакеты = НоваяТаблицаПакетов();
	Версии = НоваяТаблицаВерсий();
	Категории = НоваяТаблицаКатегорий();
	ЗаполнитьКатегории(Категории, Неопределено);

	ОшибкиИсточников = Новый Массив;

	Для Каждого ИсточникСсылка Из ИсточникиКаталога(ПараметрыКоманды) Цикл
		ДобавитьДанныеИсточника(
			ИсточникСсылка, Пакеты, Версии, Категории, ФильтрВерсий, ЛимитВерсий, ОшибкиИсточников);
	КонецЦикла;

	пм_ВерсииПакетов.ОтсортироватьВерсии(Версии);

	Результат = Новый Структура;
	Результат.Вставить("Категории", Категории);
	Результат.Вставить("Пакеты", Пакеты);
	Результат.Вставить("Версии", Версии);
	Результат.Вставить("ОшибкиИсточников", ОшибкиИсточников);

	Возврат Результат;

КонецФункции

// Источники, из которых форма читает каталог.
// Пустой Источник в параметрах - все элементы справочника без пометки удаления.
//
Функция ИсточникиКаталога(ПараметрыКоманды) Экспорт

	Если ТипЗнч(ПараметрыКоманды) = Тип("Структура")
		И ПараметрыКоманды.Свойство("Источник")
		И ЗначениеЗаполнено(ПараметрыКоманды.Источник) Тогда

		Результат = Новый Массив;
		Результат.Добавить(ПараметрыКоманды.Источник);
		Возврат Результат;

	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Источники.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.пм_ИсточникиПакетов КАК Источники
		|ГДЕ
		|	НЕ Источники.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Источники.Наименование";

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

// Новые параметры загрузки пакета.
//
// Возвращаемое значение:
//  Структура - Параметры загрузки:
// * Источник - СправочникСсылка.пм_ИсточникиПакетов - Источник пакета
// * ИмяПакета - Строка - Имя package
// * Версия - Строка - Номер версии, необязательный параметр
// * ИмяФайла - Строка - Имя скачиваемого файла, необязательный параметр
// * ТипРелиза - Строка - Тип релиза: stable, rc, dev
//
Функция НовыеПараметрыЗагрузкиПакета() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("Источник", Справочники.пм_ИсточникиПакетов.ПустаяСсылка());
	Параметры.Вставить("ИмяПакета", "");
	Параметры.Вставить("Версия", "");
	Параметры.Вставить("ИмяФайла", "");
	Параметры.Вставить("ТипРелиза", пм_ВерсииПакетов.ТипРелизаСтабильный());
	Параметры.Вставить("ПодтвержденоСамообновление", Ложь);

	Возврат Параметры;

КонецФункции

// Собирает таблицы каталога из готовых описаний, без обращения к провайдеру.
// Нужно тестам: пакет без версий остается строкой списка.
//
Функция КаталогИзОписаний(ОписанияПакетов, ВерсииПоПакетам = Неопределено) Экспорт

	Пакеты = НоваяТаблицаПакетов();
	Версии = НоваяТаблицаВерсий();

	Если ВерсииПоПакетам = Неопределено Тогда
		ВерсииПоПакетам = Новый Соответствие;
	КонецЕсли;

	Если ОписанияПакетов = Неопределено Тогда
		Возврат Новый Структура("Пакеты, Версии", Пакеты, Версии);
	КонецЕсли;

	ПустойИсточник = Справочники.пм_ИсточникиПакетов.ПустаяСсылка();

	Для Каждого ОписаниеПакета Из ОписанияПакетов Цикл

		ИмяПакета = ОписаниеПакета.Получить("name");
		Если Не ЗначениеЗаполнено(ИмяПакета) Тогда
			Продолжить;
		КонецЕсли;

		СтрокаПакета = Пакеты.Добавить();
		СтрокаПакета.Имя = ИмяПакета;
		СтрокаПакета.Источник = ПустойИсточник;
		СтрокаПакета.Описание = ОписаниеПакета.Получить("description");

		МассивВерсий = ВерсииПоПакетам.Получить(ИмяПакета);
		Если МассивВерсий = Неопределено Тогда
			МассивВерсий = Новый Массив;
		КонецЕсли;

		ДобавитьСтрокиВерсий(Версии, СтрокаПакета, ПустойИсточник, МассивВерсий);
		ПодобратьВыбраннуюВерсию(СтрокаПакета, Версии);

	КонецЦикла;

	Возврат Новый Структура("Пакеты, Версии", Пакеты, Версии);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьДанныеИсточника(ИсточникСсылка, Пакеты, Версии, Категории,
	ФильтрВерсий, ЛимитВерсий, ОшибкиИсточников)

	Попытка
		Источник = Справочники.пм_ИсточникиПакетов.ОписаниеИсточника(ИсточникСсылка);
		Провайдер = пм_ПровайдерыПакетов.МодульПровайдера(Источник.Провайдер);
		Каталог = Провайдер.ПрочитатьКаталог(Источник);
		ЗаполнитьКатегории(Категории, Каталог.Получить("categories"));
		ЗаполнитьПакетыИВерсии(
			Пакеты, Версии, Каталог.Получить("packages"),
			Источник, Провайдер, ФильтрВерсий, ЛимитВерсий);
		Справочники.пм_ИсточникиПакетов.ЗапомнитьОшибку(ИсточникСсылка, "");
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Справочники.пм_ИсточникиПакетов.ЗапомнитьОшибку(ИсточникСсылка, ТекстОшибки);
		ОшибкиИсточников.Добавить(СтрШаблон("%1: %2", ИсточникСсылка, ТекстОшибки));
	КонецПопытки;

КонецПроцедуры

Процедура ЗаполнитьПакетыИВерсии(Пакеты, Версии, ОписанияПакетов,
	Источник, Провайдер, ФильтрВерсий, ЛимитВерсий)

	Если ОписанияПакетов = Неопределено Тогда
		Возврат;
	КонецЕсли;

	УстановленныеПакеты = РегистрыСведений.пм_УстановленныеПакеты.ВерсииПакетов(, Источник.Ссылка);

	Для Каждого ОписаниеПакета Из ОписанияПакетов Цикл

		ИмяПакета = ОписаниеПакета.Получить("name");
		Если Не ЗначениеЗаполнено(ИмяПакета) Тогда
			Продолжить;
		КонецЕсли;

		СтрокаПакета = Пакеты.Добавить();
		СтрокаПакета.Имя = ИмяПакета;
		СтрокаПакета.Источник = Источник.Ссылка;
		СтрокаПакета.Описание = ОписаниеПакета.Получить("description");
		СтрокаПакета.Категория = "";

		МассивСтрок = УстановленныеПакеты.НайтиСтроки(Новый Структура("Пакет", ИмяПакета));
		Если МассивСтрок.Количество() > 0 Тогда
			СтрокаПакета.УстановленнаяВерсия = МассивСтрок[0].Версия;
			СтрокаПакета.Автообновление = МассивСтрок[0].Автообновление;
		КонецЕсли;

		ЗаполнитьВерсииПакета(
			Версии, СтрокаПакета, Источник, Провайдер, ФильтрВерсий, ЛимитВерсий);
		ПодобратьВыбраннуюВерсию(СтрокаПакета, Версии);

	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьВерсииПакета(Версии, СтрокаПакета, Источник, Провайдер, ФильтрВерсий, ЛимитВерсий)

	МассивВерсий = Провайдер.ПолучитьВерсииПакета(
		Источник, СтрокаПакета.Имя, ФильтрВерсий, ЛимитВерсий);

	ДобавитьСтрокиВерсий(Версии, СтрокаПакета, Источник.Ссылка, МассивВерсий);

КонецПроцедуры

Процедура ДобавитьСтрокиВерсий(Версии, СтрокаПакета, ИсточникСсылка, МассивВерсий)

	Для Каждого Версия Из МассивВерсий Цикл

		IDВерсии = Версия.Получить("id");
		НомерВерсии = Версия.Получить("version");
		ИмяФайла = ИмяФайлаВерсииДляСписка(Версия);

		Если ЗначениеЗаполнено(ИмяФайла) Тогда
			СтрокаПакета.ТребуетсяПерезагрузка =
				пм_МенеджерПакетов.ТипФайлаПакета(ИмяФайла) = пм_МенеджерПакетов.ТипФайлаРасширение();
		КонецЕсли;

		Строка = Версии.Добавить();
		Строка.Ид = IDВерсии;
		Строка.Номер = НомерВерсии;
		Строка.ИмяПакета = СтрокаПакета.Имя;
		Строка.Источник = ИсточникСсылка;
		Строка.ИмяФайла = ИмяФайла;
		Строка.Несемантическая = пм_ВерсииПакетов.ЭтоНесемантическаяВерсия(НомерВерсии);

		ДатаСоздания = Версия.Получить("created_at");
		Если ЗначениеЗаполнено(ДатаСоздания) Тогда
			Строка.ДатаСоздания = ПрочитатьДатуJSON(ДатаСоздания, ФорматДатыJSON.ISO);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Имя файла для строки списка. Отдельный запрос файлов версии здесь
// не делаем: один сбой или лимит API вычищал бы весь каталог.
// Расширение не угадываем: у GitLab в списке версий file_name нет,
// а пакет может быть .cfe, .epf или .erf. Имя файла тогда
// резолвится при установке по списку файлов версии.
Функция ИмяФайлаВерсииДляСписка(Версия)

	ИмяФайла = Версия.Получить("file_name");
	Если ЗначениеЗаполнено(ИмяФайла) Тогда
		Возврат ИмяФайла;
	КонецЕсли;

	Возврат "";

КонецФункции

Процедура ПодобратьВыбраннуюВерсию(СтрокаПакета, Версии)

	Отбор = Новый Структура("ИмяПакета, Источник", СтрокаПакета.Имя, СтрокаПакета.Источник);
	ВыбранныйНомер = "";
	ВыбранныйФайл = "";

	Для Каждого СтрокаВерсии Из Версии.НайтиСтроки(Отбор) Цикл
		Если Не ЗначениеЗаполнено(ВыбранныйНомер)
			Или пм_ВерсииПакетов.СравнитьВерсии(СтрокаВерсии.Номер, ВыбранныйНомер) > 0 Тогда
			ВыбранныйНомер = СтрокаВерсии.Номер;
			ВыбранныйФайл = СтрокаВерсии.ИмяФайла;
		КонецЕсли;
	КонецЦикла;

	СтрокаПакета.ВыбраннаяВерсия = ВыбранныйНомер;
	СтрокаПакета.ИмяФайла = ВыбранныйФайл;

КонецПроцедуры

// Возвращает единственный файл версии. Несколько файлов - версия пропускается.
Функция ФайлВерсии(Провайдер, Источник, IDВерсии, ИмяФайлаКаталога)

	Файлы = Провайдер.ПолучитьФайлыВерсии(Источник, IDВерсии);
	Если Файлы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ОписаниеФайла = пм_МенеджерПакетов.ВыбратьФайлВерсии(Файлы, ИмяФайлаКаталога);

	Если ОписаниеФайла <> Неопределено Тогда
		Возврат ОписаниеФайла;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ИмяФайлаКаталога) И Файлы.Количество() > 1 Тогда
		ИменаФайлов = Новый Массив;
		Для Каждого Файл Из Файлы Цикл
			ИменаФайлов.Добавить(Файл.Получить("file_name"));
		КонецЦикла;
		пм_ОбщегоНазначения.СообщитьПользователю(СтрШаблон(
			НСтр("ru = 'Версия содержит несколько файлов, выбрать однозначно нельзя: %1.'"),
			СтрСоединить(ИменаФайлов, ", ")));
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ЗагрузитьПакетыПоПараметрам(ПараметрыЗагрузки, ПриЗагрузкеВозниклиОшибки = Ложь)

	Подготовки = Новый Массив;

	Для Каждого Параметры Из ПараметрыЗагрузки Цикл

		Попытка
			Источник = Справочники.пм_ИсточникиПакетов.ОписаниеИсточника(Параметры.Источник);
			Провайдер = пм_ПровайдерыПакетов.МодульПровайдера(Источник.Провайдер);
			Подготовка = ПодготовитьПакетКУстановке(Параметры, Источник, Провайдер);
		Исключение
			ПриЗагрузкеВозниклиОшибки = Истина;
			Подготовка = НоваяПодготовкаПакета();
			Подготовка.Результат.ИмяПакета = Параметры.ИмяПакета;
			Подготовка.Результат.Источник = Параметры.Источник;
			Подготовка.Результат.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;

		Подготовки.Добавить(Подготовка);

	КонецЦикла;

	// Сведения всех расширений пачки пишем до первой Записать():
	// после неё регистр падает с «структура таблицы несовместима».
	ЗаписатьСведенияПачкиДоУстановки(Подготовки, ПриЗагрузкеВозниклиОшибки);

	СостояниеЗагрузки = Новый Массив;

	Для Каждого Подготовка Из Подготовки Цикл

		Если Подготовка.ДвоичныеДанные <> Неопределено
			И Не Подготовка.Результат.ТребуетсяПодтверждениеСамообновления
			И Не ЗначениеЗаполнено(Подготовка.Результат.ТекстОшибки) Тогда

			УстановитьСкачанныйФайл(
				Подготовка.ДвоичныеДанные,
				Подготовка.Источник,
				Подготовка.Результат.ИмяПакета,
				Подготовка.Результат.Версия,
				Подготовка.Результат.ИмяФайла,
				Подготовка.Результат,
				ПриЗагрузкеВозниклиОшибки,
				Подготовка.ПредыдущиеСведения,
				Подготовка.СведенияЗаписаны);

		КонецЕсли;

		СостояниеЗагрузки.Добавить(Подготовка.Результат);

	КонецЦикла;

	Возврат СостояниеЗагрузки;

КонецФункции

Функция ПодготовитьПакетКУстановке(ПараметрыЗагрузки, Источник, Провайдер)

	Подготовка = НоваяПодготовкаПакета();
	Подготовка.Источник = Источник;

	ИмяПакета = ПараметрыЗагрузки.ИмяПакета;
	ТипРелиза = ПараметрыЗагрузки.ТипРелиза;
	Версия = ПараметрыЗагрузки.Версия;
	ИмяФайла = ПараметрыЗагрузки.ИмяФайла;

	Результат = Подготовка.Результат;
	Результат.ИмяПакета = ИмяПакета;
	Результат.Источник = Источник.Ссылка;

	Если Не ЗначениеЗаполнено(Версия) Или Не ЗначениеЗаполнено(ИмяФайла) Тогда

		ОписаниеВерсии = НайтиВерсиюДляЗагрузки(Провайдер, Источник, ИмяПакета, ТипРелиза, Версия);
		Если ОписаниеВерсии = Неопределено Тогда
			Результат.ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Версий пакета %1 с типом релиза %2 не найдено.'"),
				ИмяПакета, ТипРелиза);
			Возврат Подготовка;
		КонецЕсли;

		Версия = ОписаниеВерсии.Получить("version");
		Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
			ИмяФайла = ОписаниеВерсии.Получить("file_name");
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
			ОписаниеФайла = ФайлВерсии(Провайдер, Источник, ОписаниеВерсии.Получить("id"), ИмяПакета);
			Если ОписаниеФайла = Неопределено Тогда
				Результат.ТекстОшибки = СтрШаблон(
					НСтр("ru = 'У версии %1 пакета %2 нет однозначного файла для установки.'"),
					Версия, ИмяПакета);
				Возврат Подготовка;
			КонецЕсли;
			ИмяФайла = ОписаниеФайла.Получить("file_name");
		КонецЕсли;

	КонецЕсли;

	Результат.Версия = Версия;
	Результат.ИмяФайла = ИмяФайла;

	Попытка
		ДвоичныеДанные = Провайдер.СкачатьФайл(Источник, ИмяПакета, Версия, ИмяФайла);
	Исключение
		Результат.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Подготовка;
	КонецПопытки;

	Результат.ЭтоСамообновление = пм_МенеджерПакетов.ЭтоСамообновление(ДвоичныеДанные, ИмяФайла);

	// Менеджер обновляет сам себя: до записи нужно явное согласие пользователя.
	// Файл кладется во временное хранилище, чтобы после подтверждения
	// не скачивать его повторно.
	Если Результат.ЭтоСамообновление И Не ПараметрыЗагрузки.ПодтвержденоСамообновление Тогда
		Результат.ТребуетсяПодтверждениеСамообновления = Истина;
		Результат.АдресФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
		Возврат Подготовка;
	КонецЕсли;

	Подготовка.ДвоичныеДанные = ДвоичныеДанные;
	Возврат Подготовка;

КонецФункции

// Устанавливает ранее скачанный и подтвержденный пользователем файл.
// Используется вторым шагом самообновления менеджера.
//
// Параметры:
//  АдресФайла - Строка - Адрес двоичных данных во временном хранилище.
//  ИсточникПакетов - СправочникСсылка.пм_ИсточникиПакетов - Источник.
//  ИмяПакета - Строка - Имя package.
//  Версия - Строка - Номер версии.
//  ИмяФайла - Строка - Имя файла.
//
// Возвращаемое значение:
//  Структура - См. НовыйРезультатЗагрузкиПакета
//
Функция УстановитьПодтвержденныйФайл(АдресФайла, ИсточникПакетов, ИмяПакета, Версия, ИмяФайла) Экспорт

	Результат = НовыйРезультатЗагрузкиПакета();
	Результат.ИмяПакета = ИмяПакета;
	Результат.Источник = ИсточникПакетов;
	Результат.Версия = Версия;
	Результат.ИмяФайла = ИмяФайла;
	Результат.ЭтоСамообновление = Истина;

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Скачанный файл больше недоступен. Повторите установку.'");
		Возврат Результат;
	КонецЕсли;

	Источник = Справочники.пм_ИсточникиПакетов.ОписаниеИсточника(ИсточникПакетов);

	УстановитьСкачанныйФайл(ДвоичныеДанные, Источник, ИмяПакета, Версия, ИмяФайла, Результат);

	Возврат Результат;

КонецФункции

Процедура УстановитьСкачанныйФайл(ДвоичныеДанные, Источник, ИмяПакета, Версия, ИмяФайла,
	Результат, ПриЗагрузкеВозниклиОшибки = Ложь,
	ПредыдущиеСведения = Неопределено, СведенияЗаписаны = Ложь)

	ЭтоРасширение = пм_МенеджерПакетов.ТипФайлаПакета(ИмяФайла) = пм_МенеджерПакетов.ТипФайлаРасширение();

	Попытка

		Если ЭтоРасширение Тогда

			// Версию пишем До установки: после записи расширения обращение
			// к собственному регистру падает с ошибкой
			// "Структура таблицы несовместима с текущими расширениями".
			Если Не СведенияЗаписаны Тогда
				ПредыдущиеСтроки = РегистрыСведений.пм_УстановленныеПакеты.ВерсииПакетов(
					ИмяПакета, Источник.Ссылка);
				ЗаписатьСведения(Источник, ИмяПакета, Версия, ИмяФайла, "");
				Если ПредыдущиеСтроки.Количество() > 0 Тогда
					ПредыдущиеСведения = ПредыдущиеСтроки[0];
				КонецЕсли;
			КонецЕсли;

			РезультатУстановки = пм_МенеджерПакетов.УстановитьФайлПакета(ДвоичныеДанные, ИмяФайла);

			Если Не РезультатУстановки.Успешно Тогда
				ОткатитьСведенияРасширения(
					Источник, ИмяПакета, ИмяФайла, ПредыдущиеСведения, РезультатУстановки.ТекстОшибки);
			КонецЕсли;

		Иначе

			РезультатУстановки = пм_МенеджерПакетов.УстановитьФайлПакета(ДвоичныеДанные, ИмяФайла);

			Если РезультатУстановки.Успешно Тогда
				ЗаписатьСведения(Источник, ИмяПакета, Версия, ИмяФайла, "");
			КонецЕсли;

		КонецЕсли;

		Результат.ТекстОшибки = РезультатУстановки.ТекстОшибки;
		Результат.ТребуетсяПерезапуск = РезультатУстановки.ТребуетсяПерезапуск;
		Результат.АдресФайла = РезультатУстановки.АдресВоВременномХранилище;
		Результат.ИмяФормыВнешнегоФайла = РезультатУстановки.ИмяФормы;

	Исключение
		ПриЗагрузкеВозниклиОшибки = Истина;
		Результат.ТекстОшибки = Результат.ТекстОшибки
			+ ?(ЗначениеЗаполнено(Результат.ТекстОшибки), Символы.ПС, "")
			+ ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

Процедура ЗаписатьСведенияПачкиДоУстановки(Подготовки, ПриЗагрузкеВозниклиОшибки)

	Для Каждого Подготовка Из Подготовки Цикл

		Если Подготовка.ДвоичныеДанные = Неопределено
			Или Подготовка.Результат.ТребуетсяПодтверждениеСамообновления
			Или ЗначениеЗаполнено(Подготовка.Результат.ТекстОшибки) Тогда
			Продолжить;
		КонецЕсли;

		Если пм_МенеджерПакетов.ТипФайлаПакета(Подготовка.Результат.ИмяФайла)
			<> пм_МенеджерПакетов.ТипФайлаРасширение() Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			ПредыдущиеСтроки = РегистрыСведений.пм_УстановленныеПакеты.ВерсииПакетов(
				Подготовка.Результат.ИмяПакета, Подготовка.Источник.Ссылка);
			ЗаписатьСведения(
				Подготовка.Источник,
				Подготовка.Результат.ИмяПакета,
				Подготовка.Результат.Версия,
				Подготовка.Результат.ИмяФайла,
				"");
			Если ПредыдущиеСтроки.Количество() > 0 Тогда
				Подготовка.ПредыдущиеСведения = ПредыдущиеСтроки[0];
			КонецЕсли;
			Подготовка.СведенияЗаписаны = Истина;
		Исключение
			ПриЗагрузкеВозниклиОшибки = Истина;
			Подготовка.Результат.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

Процедура ОткатитьСведенияРасширения(Источник, ИмяПакета, ИмяФайла, ПредыдущиеСведения, ТекстОшибки)

	Попытка
		Если ПредыдущиеСведения <> Неопределено Тогда
			ВосстановитьСведения(Источник, ПредыдущиеСведения, ТекстОшибки);
		Иначе
			ЗаписатьСведения(Источник, ИмяПакета, "", ИмяФайла, ТекстОшибки);
		КонецЕсли;
	Исключение
		// После записи другого расширения регистр уже может быть недоступен.
	КонецПопытки;

КонецПроцедуры

Процедура ЗаписатьСведения(Источник, ИмяПакета, Версия, ИмяФайла, ТекстОшибки)

	Сведения = РегистрыСведений.пм_УстановленныеПакеты.СтруктураЗаписи();
	Сведения.Источник = Источник.Ссылка;
	Сведения.Пакет = ИмяПакета;
	Сведения.Версия = Версия;
	Сведения.ИмяФайла = ИмяФайла;
	Сведения.ТекстОшибки = ТекстОшибки;

	РегистрыСведений.пм_УстановленныеПакеты.ОбновитьСведения(Сведения);

КонецПроцедуры

Процедура ВосстановитьСведения(Источник, ПрежниеСведения, ТекстОшибки)

	Сведения = РегистрыСведений.пм_УстановленныеПакеты.СтруктураЗаписи();
	ЗаполнитьЗначенияСвойств(Сведения, ПрежниеСведения);
	Сведения.Источник = Источник.Ссылка;
	Сведения.ТекстОшибки = ТекстОшибки;

	РегистрыСведений.пм_УстановленныеПакеты.ОбновитьСведения(Сведения);

КонецПроцедуры

Функция НайтиВерсиюДляЗагрузки(Провайдер, Источник, ИмяПакета, ТипРелиза, НомерВерсии)

	МассивВерсий = Провайдер.ПолучитьВерсииПакета(Источник, ИмяПакета, ТипРелиза, 0);
	Если МассивВерсий.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(НомерВерсии) Тогда
		Возврат НаиболееНоваяВерсия(МассивВерсий);
	КонецЕсли;

	Для Каждого Версия Из МассивВерсий Цикл
		Если СтрСравнить(Версия.Получить("version"), НомерВерсии) = 0 Тогда
			Возврат Версия;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Выбирает самую новую версию из ответа провайдера по правилам semver.
// Порядок, в котором версии пришли от API, здесь не используется:
// сортировка по created_at не совпадает с порядком версий.
Функция НаиболееНоваяВерсия(МассивВерсий)

	Наибольшая = МассивВерсий[0];

	Для Каждого Версия Из МассивВерсий Цикл
		Если пм_ВерсииПакетов.СравнитьВерсии(
			Версия.Получить("version"), Наибольшая.Получить("version")) > 0 Тогда
			Наибольшая = Версия;
		КонецЕсли;
	КонецЦикла;

	Возврат Наибольшая;

КонецФункции

Процедура ЗаполнитьКатегории(Категории, СписокКатегорий)

	Если Категории.Найти(НСтр("ru = 'Все'"), "Наименование") = Неопределено Тогда
		Строка = Категории.Добавить();
		Строка.Наименование = НСтр("ru = 'Все'");
	КонецЕсли;

	Если СписокКатегорий = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Категория Из СписокКатегорий Цикл
		Если Категории.Найти(Категория, "Наименование") = Неопределено Тогда
			Строка = Категории.Добавить();
			Строка.Наименование = Категория;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция НоваяТаблицаПакетов()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Источник", Новый ОписаниеТипов("СправочникСсылка.пм_ИсточникиПакетов"));
	Таблица.Колонки.Добавить("ВыбраннаяВерсия", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ИмяФайла", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Загружать", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Автообновление", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Категория", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ТребуетсяПерезагрузка", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("ЕстьОбновление", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Описание", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("УстановленнаяВерсия", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ПорядокПрименения", Новый ОписаниеТипов("Число"));

	Возврат Таблица;

КонецФункции

Функция НоваяТаблицаВерсий()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ИмяФайла", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ДатаСоздания", пм_ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя));
	Таблица.Колонки.Добавить("Ид", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ИмяПакета", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Источник", Новый ОписаниеТипов("СправочникСсылка.пм_ИсточникиПакетов"));
	Таблица.Колонки.Добавить("Несемантическая", Новый ОписаниеТипов("Булево"));

	Возврат Таблица;

КонецФункции

Функция НоваяТаблицаКатегорий()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));

	Возврат Таблица;

КонецФункции

Функция НоваяПодготовкаПакета()

	Подготовка = Новый Структура;
	Подготовка.Вставить("Источник", Неопределено);
	Подготовка.Вставить("ДвоичныеДанные", Неопределено);
	Подготовка.Вставить("Результат", НовыйРезультатЗагрузкиПакета());
	Подготовка.Вставить("ПредыдущиеСведения", Неопределено);
	Подготовка.Вставить("СведенияЗаписаны", Ложь);

	Возврат Подготовка;

КонецФункции

Функция НовыйРезультатЗагрузкиПакета()

	Результат = Новый Структура;
	Результат.Вставить("ИмяПакета", "");
	Результат.Вставить("Источник", Справочники.пм_ИсточникиПакетов.ПустаяСсылка());
	Результат.Вставить("Версия", "");
	Результат.Вставить("ИмяФайла", "");
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("ТребуетсяПерезапуск", Ложь);
	Результат.Вставить("ЭтоСамообновление", Ложь);
	Результат.Вставить("ТребуетсяПодтверждениеСамообновления", Ложь);
	Результат.Вставить("АдресФайла", "");
	Результат.Вставить("ИмяФормыВнешнегоФайла", "");

	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецЕсли
