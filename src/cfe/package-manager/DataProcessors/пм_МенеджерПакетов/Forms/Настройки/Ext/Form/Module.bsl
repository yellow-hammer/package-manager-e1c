#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)

	Результат = Новый Структура;
	Результат.Вставить("ЛимитВерсий", ЛимитВерсий);
	Результат.Вставить("ИдентификаторСистемы", ИдентификаторСистемы);
	Результат.Вставить("URLСервера", URLСервера);
	Результат.Вставить("ПутьПроекта", ПутьПроекта);
	Результат.Вставить("IDПроекта", IDПроекта);
	Результат.Вставить("ИмяПакета", ИмяПакета);
	Результат.Вставить("ВерсияПакета", ВерсияПакета);
	Результат.Вставить("ИмяФайлаПакета", ИмяФайлаПакета);
	Результат.Вставить("ИмяРасширенияВИБ", ИмяРасширенияВИБ);
	Результат.Вставить("ТокенДоступа", ТокенДоступа);
	
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	Закрыть(Неопределено);
	
КонецПроцедуры

#КонецОбласти

