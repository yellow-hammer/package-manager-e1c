#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ЛимитВерсий", ЛимитВерсий);
	Параметры.Свойство("ИдентификаторСистемы", ИдентификаторСистемы);
	Параметры.Свойство("URLСервера", URLСервера);
	Параметры.Свойство("ПутьПроекта", ПутьПроекта);
	Параметры.Свойство("IDПроекта", IDПроекта);
	Параметры.Свойство("ИмяПакета", ИмяПакета);
	Параметры.Свойство("ВерсияПакета", ВерсияПакета);
	Параметры.Свойство("ИмяФайлаПакета", ИмяФайлаПакета);
	Параметры.Свойство("ИмяРасширенияВИБ", ИмяРасширенияВИБ);
	Параметры.Свойство("ТокенДоступа", ТокенДоступа);
	
КонецПроцедуры

#КонецОбласти

