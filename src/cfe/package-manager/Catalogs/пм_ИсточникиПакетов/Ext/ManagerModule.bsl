#Область ПрограммныйИнтерфейс

// Возвращает описание источника в виде структуры для передачи провайдеру.
// Токен читается в привилегированном режиме и в журналы не попадает.
//
// Параметры:
//  ИсточникПакетов - СправочникСсылка.пм_ИсточникиПакетов - Источник.
//
// Возвращаемое значение:
//  Структура - Описание источника:
// * Ссылка - СправочникСсылка.пм_ИсточникиПакетов
// * Наименование - Строка
// * Провайдер - Строка
// * URLСервера - Строка
// * ПутьПроекта - Строка
// * IDПроекта - Строка
// * ИмяПакета - Строка
// * Токен - Строка
//
Функция ОписаниеИсточника(ИсточникПакетов) Экспорт

	Если Не ЗначениеЗаполнено(ИсточникПакетов) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан источник пакетов.'");
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Реквизиты = пм_ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ИсточникПакетов,
		"Наименование, Провайдер, URLСервера, ПутьПроекта, IDПроекта,
		|ИмяПакета, ТокенДоступа");

	Описание = НовоеОписаниеИсточника();
	Описание.Ссылка = ИсточникПакетов;
	ЗаполнитьЗначенияСвойств(Описание, Реквизиты);
	Описание.Токен = Реквизиты.ТокенДоступа;

	Возврат Описание;

КонецФункции

// Возвращает пустую структуру описания источника, см. ОписаниеИсточника.
Функция НовоеОписаниеИсточника() Экспорт

	Описание = Новый Структура;
	Описание.Вставить("Ссылка", Справочники.пм_ИсточникиПакетов.ПустаяСсылка());
	Описание.Вставить("Наименование", "");
	Описание.Вставить("Провайдер", "");
	Описание.Вставить("URLСервера", "");
	Описание.Вставить("ПутьПроекта", "");
	Описание.Вставить("IDПроекта", "");
	Описание.Вставить("ИмяПакета", "");
	Описание.Вставить("Токен", "");

	Возврат Описание;

КонецФункции

// Сохраняет полученный от провайдера идентификатор проекта, чтобы не
// резолвить его при каждом обращении.
Процедура ЗапомнитьIDПроекта(ИсточникПакетов, IDПроекта) Экспорт

	Если Не ЗначениеЗаполнено(ИсточникПакетов) Или Не ЗначениеЗаполнено(IDПроекта) Тогда
		Возврат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Объект = ИсточникПакетов.ПолучитьОбъект();
	Если Объект.IDПроекта = Строка(IDПроекта) Тогда
		Возврат;
	КонецЕсли;

	Объект.IDПроекта = Строка(IDПроекта);
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();

КонецПроцедуры

// Записывает текст последней ошибки обращения к источнику.
Процедура ЗапомнитьОшибку(ИсточникПакетов, ТекстОшибки) Экспорт

	Если Не ЗначениеЗаполнено(ИсточникПакетов) Тогда
		Возврат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Объект = ИсточникПакетов.ПолучитьОбъект();
	Если Объект.ТекстОшибки = ТекстОшибки Тогда
		Возврат;
	КонецЕсли;

	Объект.ТекстОшибки = ТекстОшибки;
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();

КонецПроцедуры

#КонецОбласти

#КонецЕсли
