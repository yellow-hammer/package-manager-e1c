#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Провайдер) Тогда
		Провайдер = пм_ПровайдерыПакетов.ПровайдерПоУмолчанию();
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	URLСервера = пм_МенеджерПакетовКлиентСервер.НормализованныйURL(URLСервера);
	ПутьПроекта = пм_МенеджерПакетовКлиентСервер.НормализованныйПутьПроекта(ПутьПроекта);

	// Кэш идентификатора проекта верен только для той пары сервер + путь,
	// для которой он был получен. При их изменении кэш сбрасывается.
	Если Не ЭтоНовый() Тогда
		РеквизитыДоИзменения = ОбщегоНазначенияПолучитьРеквизиты(Ссылка);
		Если РеквизитыДоИзменения <> Неопределено
			И (РеквизитыДоИзменения.URLСервера <> URLСервера
				Или РеквизитыДоИзменения.ПутьПроекта <> ПутьПроекта
				Или РеквизитыДоИзменения.Провайдер <> Провайдер) Тогда
			IDПроекта = "";
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если ЗначениеЗаполнено(Провайдер)
		И Не пм_ПровайдерыПакетов.ПровайдерРеализован(Провайдер) Тогда
		Отказ = Истина;
		пм_ОбщегоНазначения.СообщитьПользователю(
			СтрШаблон(НСтр("ru = 'Провайдер %1 пока не реализован.'"), Провайдер),
			ЭтотОбъект,
			"Провайдер");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбщегоНазначенияПолучитьРеквизиты(ИсточникСсылка)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Источники.URLСервера КАК URLСервера,
		|	Источники.ПутьПроекта КАК ПутьПроекта,
		|	Источники.Провайдер КАК Провайдер
		|ИЗ
		|	Справочник.пм_ИсточникиПакетов КАК Источники
		|ГДЕ
		|	Источники.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ИсточникСсылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Реквизиты = Новый Структура("URLСервера, ПутьПроекта, Провайдер");
	ЗаполнитьЗначенияСвойств(Реквизиты, Выборка);

	Возврат Реквизиты;

КонецФункции

#КонецОбласти

#КонецЕсли
