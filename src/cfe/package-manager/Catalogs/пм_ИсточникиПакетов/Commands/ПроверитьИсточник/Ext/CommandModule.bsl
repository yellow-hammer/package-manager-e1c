#Область ОбработчикиСобытий

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	Если Не ЗначениеЗаполнено(ПараметрКоманды) Тогда
		Возврат;
	КонецЕсли;

	Результат = ПроверитьНаСервере(ПараметрКоманды);

	Если Результат.Успешно Тогда
		ПоказатьОповещениеПользователя(
			НСтр("ru = 'Источник доступен'"),
			,
			СтрШаблон(НСтр("ru = 'Идентификатор проекта: %1'"), Результат.IDПроекта));
	Иначе
		ПоказатьПредупреждение(, Результат.ТекстОшибки);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПроверитьНаСервере(ИсточникПакетов)

	Источник = Справочники.пм_ИсточникиПакетов.ОписаниеИсточника(ИсточникПакетов);

	Если Не пм_ПровайдерыПакетов.ПровайдерРеализован(Источник.Провайдер) Тогда
		Возврат Новый Структура("Успешно, ТекстОшибки, IDПроекта", Ложь,
			СтрШаблон(НСтр("ru = 'Провайдер %1 пока не реализован.'"), Источник.Провайдер), "");
	КонецЕсли;

	Провайдер = пм_ПровайдерыПакетов.МодульПровайдера(Источник.Провайдер);
	Результат = Провайдер.ПроверитьИсточник(Источник);

	Справочники.пм_ИсточникиПакетов.ЗапомнитьОшибку(ИсточникПакетов, Результат.ТекстОшибки);

	Возврат Результат;

КонецФункции

#КонецОбласти
