#Если Сервер Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Устанавливает или обновляет расширение из двоичных данных .cfe.
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - Содержимое файла .cfe.
//  ИмяРасширенияВИБ - Строка - Ожидаемое имя расширения в информационной базе.
//
// Возвращаемое значение:
//  Структура - См. НовыйРезультатУстановки
//
Функция УстановитьИзДвоичныхДанных(ДвоичныеДанные, ИмяРасширенияВИБ = "") Экспорт

	Результат = НовыйРезультатУстановки();

	Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Неправильный формат файла расширения.'");
		Возврат Результат;
	КонецЕсли;

	Попытка
		ОписаниеРасширения = Новый ОписаниеКонфигурации(ДвоичныеДанные);
	Исключение
		Результат.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Файл не читается как расширение конфигурации: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Результат;
	КонецПопытки;

	Если ЗначениеЗаполнено(ИмяРасширенияВИБ)
		И ОписаниеРасширения.Имя <> ИмяРасширенияВИБ Тогда
		Результат.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Имя расширения в файле (%1) не совпадает с ожидаемым именем (%2).'"),
			ОписаниеРасширения.Имя,
			ИмяРасширенияВИБ);
		Возврат Результат;
	КонецЕсли;

	Расширение = пм_ОбщегоНазначения.НайтиРасширение(ОписаниеРасширения.Имя);
	ЭтоПерваяУстановка = Расширение = Неопределено;

	Если ЭтоПерваяУстановка Тогда
		Расширение = РасширенияКонфигурации.Создать();
		ОтключитьИспользованиеОсновныхРолейДляВсехПользователей(Расширение);
	Иначе
		Проблемы = ПроблемыПрименимости(Расширение, ДвоичныеДанные);
		Результат.Замечания = Проблемы.Замечания;
		Если ЗначениеЗаполнено(Проблемы.Критичные) Тогда
			Результат.ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Новая версия не применяется к этой конфигурации:%1%2'"),
				Символы.ПС, Проблемы.Критичные);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	ОтключитьБезопасныйРежим(Расширение);
	ОтключитьПредупрежденияБезопасности(Расширение);

	Попытка
		Расширение.Записать(ДвоичныеДанные);
	Исключение
		Результат.ТекстОшибки = ТекстОшибкиЗаписи(ИнформацияОбОшибке(), Результат.Замечания);
		Возврат Результат;
	КонецПопытки;

	ЗаписатьЗамечанияВЖурнал(ОписаниеРасширения.Имя, Результат.Замечания);
	ОбновитьПараметрыРаботыРасширенийЕслиВозможно();

	Результат.Успешно = Истина;
	Результат.ТребуетсяПерезапуск = Истина;

	Возврат Результат;

КонецФункции

// Результат установки расширения.
//
// Возвращаемое значение:
//  Структура - Поля результата:
// * Успешно - Булево
// * ТекстОшибки - Строка
// * ТребуетсяПерезапуск - Булево
// * Замечания - Строка - Замечания проверки применимости, установку не отменяют
//
Функция НовыйРезультатУстановки() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("ТребуетсяПерезапуск", Ложь);
	Результат.Вставить("Замечания", "");

	Возврат Результат;

КонецФункции

// Делит проблемы применимости на критичные и остальные.
//
// Критичная проблема - расширение к этой конфигурации не применится,
// ставить его бессмысленно. Остальное - замечания: платформа проверяет
// расширения базы по порядку загрузки, поэтому сюда попадают и чужие,
// и безобидные, и они не должны отменять обновление.
//
// Параметры:
//  Проблемы - Массив - Элементы со свойствами Важность и Описание.
//
// Возвращаемое значение:
//  Структура - Тексты проблем:
// * Критичные - Строка
// * Замечания - Строка
//
Функция РазобратьПроблемыПрименимости(Проблемы) Экспорт

	Критичные = Новый Массив;
	Замечания = Новый Массив;

	Если Проблемы <> Неопределено Тогда
		Для Каждого Проблема Из Проблемы Цикл

			Описание = СокрЛП(Строка(Проблема.Описание));
			Если Не ЗначениеЗаполнено(Описание) Тогда
				Продолжить;
			КонецЕсли;

			Приемник = ?(ЭтоКритичнаяПроблема(Проблема.Важность), Критичные, Замечания);
			Если Приемник.Найти(Описание) = Неопределено Тогда
				Приемник.Добавить(Описание);
			КонецЕсли;

		КонецЦикла;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Критичные", СтрСоединить(Критичные, Символы.ПС));
	Результат.Вставить("Замечания", СтрСоединить(Замечания, Символы.ПС));

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОтключитьБезопасныйРежим(Расширение)

	Расширение.БезопасныйРежим = Ложь;

КонецПроцедуры

Процедура ОтключитьПредупрежденияБезопасности(Расширение)

	ОписаниеЗащиты = Новый ОписаниеЗащитыОтОпасныхДействий;
	ОписаниеЗащиты.ПредупреждатьОбОпасныхДействиях = Ложь;

	Расширение.ЗащитаОтОпасныхДействий = ОписаниеЗащиты;

КонецПроцедуры

Процедура ОтключитьИспользованиеОсновныхРолейДляВсехПользователей(Расширение)

	//@skip-check property-not-writable
	Расширение.ИспользоватьОсновныеРолиДляВсехПользователей = Ложь;

КонецПроцедуры

Функция ПроблемыПрименимости(Расширение, ДвоичныеДанные)

	Попытка
		Проблемы = Расширение.ПроверитьВозможностьПрименения(ДвоичныеДанные, Ложь);
	Исключение
		// После записи другого расширения в этом же сеансе проверка недоступна.
		Возврат РазобратьПроблемыПрименимости(Неопределено);
	КонецПопытки;

	Возврат РазобратьПроблемыПрименимости(Проблемы);

КонецФункции

// Важность приходит перечислением платформы, сравнивается ее представление:
// в незнакомой локали совпадения не будет, и проблема уйдет в замечания,
// то есть установку не остановит.
// Сравнение только точное: поиск подстроки находил "критич"
// внутри "Некритичная", и любая мелочь останавливала установку.
Функция ЭтоКритичнаяПроблема(Важность)

	Представление = НРег(СокрЛП(Строка(Важность)));

	Возврат Представление = "критичная" Или Представление = "critical";

КонецФункции

Функция ТекстОшибкиЗаписи(Информация, Замечания)

	Текст = КраткоеПредставлениеОшибки(Информация);

	Если ЗначениеЗаполнено(Замечания) Тогда
		Текст = Текст + Символы.ПС
			+ НСтр("ru = 'Замечания проверки применимости:'") + Символы.ПС
			+ Замечания;
	КонецЕсли;

	Возврат Текст;

КонецФункции

Процедура ЗаписатьЗамечанияВЖурнал(ИмяРасширения, Замечания)

	Если Не ЗначениеЗаполнено(Замечания) Тогда
		Возврат;
	КонецЕсли;

	ЗаписьЖурналаРегистрации(
		ИмяСобытияЖурнала(),
		УровеньЖурналаРегистрации.Предупреждение,
		,
		,
		СтрШаблон(
			НСтр("ru = 'Расширение %1 записано. Проверка применимости сообщила:%2%3'"),
			ИмяРасширения, Символы.ПС, Замечания));

КонецПроцедуры

// Регистр БСП после записи расширения в этом же сеансе может стать
// недоступен: «структура таблицы несовместима с текущими расширениями».
// Расширение уже записано, и установку это не отменяет.
Процедура ОбновитьПараметрыРаботыРасширенийЕслиВозможно()

	Если Метаданные.РегистрыСведений.Найти("ПараметрыРаботыВерсийРасширений") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		РегистрыСведений.ПараметрыРаботыВерсийРасширений.ОбновитьПараметрыРаботыРасширений();
	Исключение
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Функция ИмяСобытияЖурнала()

	Возврат НСтр("ru = 'Менеджер пакетов.Установка расширения'");

КонецФункции

#КонецОбласти

#КонецЕсли
