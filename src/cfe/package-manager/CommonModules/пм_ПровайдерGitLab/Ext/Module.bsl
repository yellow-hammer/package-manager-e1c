#Область ПрограммныйИнтерфейс

// Проверяет доступность проекта и кэширует идентификатор проекта.
// Реализация контракта провайдера, см. пм_ПровайдерыПакетов.
//
// Параметры:
//  Источник - Структура - См. Справочники.пм_ИсточникиПакетов.ОписаниеИсточника
//
// Возвращаемое значение:
//  Структура - Результат проверки:
// * Успешно - Булево
// * ТекстОшибки - Строка
// * IDПроекта - Строка
//
Функция ПроверитьИсточник(Источник) Экспорт

	Результат = Новый Структура("Успешно, ТекстОшибки, IDПроекта", Ложь, "", "");

	Попытка
		ОбеспечитьIDПроекта(Источник);
		Результат.IDПроекта = Источник.IDПроекта;
		Результат.Успешно = Истина;
	Исключение
		Результат.ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Собирает каталог пакетов из Generic Package Registry проекта.
// pm-packages.json не читается: это список для CI, не каталог источника.
//
// Параметры:
//  Источник - Структура - См. Справочники.пм_ИсточникиПакетов.ОписаниеИсточника
//
// Возвращаемое значение:
//  Соответствие - Ключ packages: массив описаний с ключом name.
//
Функция ПрочитатьКаталог(Источник) Экспорт

	ОбеспечитьIDПроекта(Источник);

	Записи = ПолучитьЗаписиРеестра(Источник, Источник.ИмяПакета);
	Имена = УникальныеИменаПакетов(Записи);

	Если ЗначениеЗаполнено(Источник.ИмяПакета) Тогда
		Отобранные = Новый Массив;
		Для Каждого ИмяПакета Из Имена Цикл
			Если СтрСравнить(ИмяПакета, Источник.ИмяПакета) = 0 Тогда
				Отобранные.Добавить(ИмяПакета);
			КонецЕсли;
		КонецЦикла;
		Имена = Отобранные;
	КонецЕсли;

	ОписаниеПроекта = ОписаниеПроекта(Источник);

	Пакеты = Новый Массив;
	Для Каждого ИмяПакета Из Имена Цикл
		ОписаниеПакета = Новый Соответствие;
		ОписаниеПакета.Вставить("name", ИмяПакета);
		Если ЗначениеЗаполнено(ОписаниеПроекта) Тогда
			ОписаниеПакета.Вставить("description", ОписаниеПроекта);
		КонецЕсли;
		Пакеты.Добавить(ОписаниеПакета);
	КонецЦикла;

	Каталог = Новый Соответствие;
	Каталог.Вставить("packages", Пакеты);

	Возврат Каталог;

КонецФункции

// Уникальные имена package из записей GitLab Package Registry.
// Одна запись API - одна версия, одно имя может повторяться.
//
// Параметры:
//  ЗаписиРеестра - Массив - Соответствия с ключом name.
//
// Возвращаемое значение:
//  Массив - Имена пакетов без повторов, в порядке первого появления.
//
Функция УникальныеИменаПакетов(ЗаписиРеестра) Экспорт

	Имена = Новый Массив;
	УжеЕсть = Новый Соответствие;

	Если ЗаписиРеестра = Неопределено Тогда
		Возврат Имена;
	КонецЕсли;

	Для Каждого Запись Из ЗаписиРеестра Цикл
		ИмяПакета = Запись.Получить("name");
		Если Не ЗначениеЗаполнено(ИмяПакета) Или УжеЕсть.Получить(ИмяПакета) = Истина Тогда
			Продолжить;
		КонецЕсли;
		УжеЕсть.Вставить(ИмяПакета, Истина);
		Имена.Добавить(ИмяПакета);
	КонецЦикла;

	Возврат Имена;

КонецФункции

// Возвращает версии пакета, отфильтрованные по типу релиза.
//
// Параметры:
//  Источник - Структура - См. Справочники.пм_ИсточникиПакетов.ОписаниеИсточника
//  ИмяПакета - Строка - Имя package.
//  ТипРелиза - Строка - stable, rc, dev либо пустая строка.
//  ЛимитВерсий - Число - Сколько версий вернуть, 0 без ограничения.
//
// Возвращаемое значение:
//  Массив - Соответствия с данными версий из API.
//
Функция ПолучитьВерсииПакета(Источник, ИмяПакета, ТипРелиза = "", ЛимитВерсий = 0) Экспорт

	ОбеспечитьIDПроекта(Источник);

	Версии = Новый Массив;
	НомерСтраницы = Неопределено;

	// API отдает пакеты постранично: идем по страницам, пока не наберем
	// нужное количество подходящих версий либо не кончатся страницы.
	Пока Истина Цикл

		ПараметрыЗапроса = Новый Структура;
		ПараметрыЗапроса.Вставить("package_type", "generic");
		ПараметрыЗапроса.Вставить("package_name", ИмяПакета);
		ПараметрыЗапроса.Вставить("order_by", "created_at");
		ПараметрыЗапроса.Вставить("sort", "desc");
		ПараметрыЗапроса.Вставить("per_page", 100);
		Если ЗначениеЗаполнено(НомерСтраницы) Тогда
			ПараметрыЗапроса.Вставить("page", НомерСтраницы);
		КонецЕсли;

		Ответ = ВыполнитьЗапрос(Источник, АдресПакетов(Источник), ПараметрыЗапроса);
		ПроверитьОтвет(Источник, Ответ, СтрШаблон(
			НСтр("ru = 'Не удалось получить список версий пакета %1.'"), ИмяПакета));

		СтраницаВерсий = пм_КоннекторHTTP.КакJson(Ответ);

		Для Каждого Версия Из СтраницаВерсий Цикл

			Если Не пм_ВерсииПакетов.ВерсияПодходитПодФильтр(Версия.Получить("version"), ТипРелиза) Тогда
				Продолжить;
			КонецЕсли;

			Версии.Добавить(Версия);

			Если ЛимитВерсий > 0 И Версии.Количество() >= ЛимитВерсий Тогда
				Возврат Версии;
			КонецЕсли;

		КонецЦикла;

		НомерСтраницы = Ответ.Заголовки.Получить("X-Next-Page");
		Если Не ЗначениеЗаполнено(НомерСтраницы) Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Возврат Версии;

КонецФункции

// Возвращает файлы конкретной версии пакета.
//
// Параметры:
//  Источник - Структура - См. Справочники.пм_ИсточникиПакетов.ОписаниеИсточника
//  IDВерсии - Строка, Число - Идентификатор package из API.
//
// Возвращаемое значение:
//  Массив - Соответствия с описаниями файлов.
//
Функция ПолучитьФайлыВерсии(Источник, IDВерсии) Экспорт

	ОбеспечитьIDПроекта(Источник);

	Адрес = СтрШаблон("%1/%2/package_files", АдресПакетов(Источник), Формат(IDВерсии, "ЧГ=; ЧН=0"));
	Ответ = ВыполнитьЗапрос(Источник, Адрес);

	ПроверитьОтвет(Источник, Ответ, НСтр("ru = 'Не удалось получить список файлов версии пакета.'"));

	Возврат пм_КоннекторHTTP.КакJson(Ответ);

КонецФункции

// Скачивает файл пакета.
//
// Параметры:
//  Источник - Структура - См. Справочники.пм_ИсточникиПакетов.ОписаниеИсточника
//  ИмяПакета - Строка - Имя package.
//  Версия - Строка - Номер версии.
//  ИмяФайла - Строка - Имя файла в package.
//
// Возвращаемое значение:
//  ДвоичныеДанные - Содержимое файла.
//
Функция СкачатьФайл(Источник, ИмяПакета, Версия, ИмяФайла) Экспорт

	ОбеспечитьIDПроекта(Источник);

	Адрес = СтрШаблон("%1/generic/%2/%3/%4",
		АдресПакетов(Источник),
		КодированныйСегмент(ИмяПакета),
		КодированныйСегмент(Версия),
		КодированныйСегмент(ИмяФайла));

	Ответ = ВыполнитьЗапрос(Источник, Адрес);

	Если Ответ.КодСостояния = 404 Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Файл %1 версии %2 пакета %3 не найден в источнике.'"),
			ИмяФайла, Версия, ИмяПакета);
	КонецЕсли;

	ПроверитьОтвет(Источник, Ответ, СтрШаблон(
		НСтр("ru = 'Не удалось скачать файл %1.'"), ИмяФайла));

	Если ТипЗнч(Ответ.Тело) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Сервер вернул файл %1 в неожиданном формате.'"), ИмяФайла);
	КонецЕсли;

	Возврат Ответ.Тело;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьЗаписиРеестра(Источник, ИмяПакета = "")

	Записи = Новый Массив;
	НомерСтраницы = Неопределено;

	Пока Истина Цикл

		ПараметрыЗапроса = Новый Структура;
		ПараметрыЗапроса.Вставить("package_type", "generic");
		ПараметрыЗапроса.Вставить("order_by", "name");
		ПараметрыЗапроса.Вставить("sort", "asc");
		ПараметрыЗапроса.Вставить("per_page", 100);
		Если ЗначениеЗаполнено(ИмяПакета) Тогда
			ПараметрыЗапроса.Вставить("package_name", ИмяПакета);
		КонецЕсли;
		Если ЗначениеЗаполнено(НомерСтраницы) Тогда
			ПараметрыЗапроса.Вставить("page", НомерСтраницы);
		КонецЕсли;

		Ответ = ВыполнитьЗапрос(Источник, АдресПакетов(Источник), ПараметрыЗапроса);
		ПроверитьОтвет(Источник, Ответ, НСтр("ru = 'Не удалось получить список пакетов проекта.'"));

		Страница = пм_КоннекторHTTP.КакJson(Ответ);
		Для Каждого Запись Из Страница Цикл
			Записи.Добавить(Запись);
		КонецЦикла;

		НомерСтраницы = Ответ.Заголовки.Получить("X-Next-Page");
		Если Не ЗначениеЗаполнено(НомерСтраницы) Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Возврат Записи;

КонецФункции

Функция НоваяСессия(Источник)

	Сессия = пм_КоннекторHTTP.СоздатьСессию();

	Если ЗначениеЗаполнено(Источник.Токен) Тогда
		Сессия.Заголовки.Вставить("PRIVATE-TOKEN", Источник.Токен);
	КонецЕсли;

	Возврат Сессия;

КонецФункции

// Выполняет GET с таймаутом и одним повтором при сетевой ошибке.
// Повторяется только обрыв связи: HTTP-ответ с любым кодом считается
// состоявшимся и возвращается как есть.
Функция ВыполнитьЗапрос(Источник, Адрес, ПараметрыЗапроса = Неопределено)

	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Таймаут", пм_ПровайдерыПакетов.ТаймаутЗапроса());

	Попытка
		Возврат пм_КоннекторHTTP.Get(Адрес, ПараметрыЗапроса, ДополнительныеПараметры, НоваяСессия(Источник));
	Исключение
		ОшибкаПервойПопытки = ИнформацияОбОшибке();
	КонецПопытки;

	Попытка
		Возврат пм_КоннекторHTTP.Get(Адрес, ПараметрыЗапроса, ДополнительныеПараметры, НоваяСессия(Источник));
	Исключение
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Нет связи с сервером %1. Попытка повтора также не удалась.
			|%2'"),
			Источник.URLСервера,
			ПодробноеПредставлениеОшибки(ОшибкаПервойПопытки));
	КонецПопытки;

КонецФункции

Процедура ПроверитьОтвет(Источник, Ответ, ТекстОшибки)

	Если Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300 Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СокрЛП(СтрШаблон("%1 %2 %3",
		ТекстОшибки,
		СтрШаблон(НСтр("ru = 'Код ответа: %1.'"), Ответ.КодСостояния),
		ПояснениеОшибкиОтвета(Источник, Ответ)));

КонецПроцедуры

// Пояснение к коду ответа GitLab: лимит запросов, токен, путь.
// Закрытый проект - только одна из причин 403, поэтому не утверждаем.
//
Функция ПояснениеОшибкиОтвета(Источник, Ответ) Экспорт

	Если Ответ.КодСостояния = 429 Тогда
		Возврат НСтр("ru = 'Сервер отклонил частые запросы. Повторите позже.'");
	КонецЕсли;

	Если Ответ.КодСостояния = 401 Тогда
		Если ТокенИсточникаЗаполнен(Источник) Тогда
			Возврат НСтр("ru = 'Токен доступа отклонен. Проверьте токен в источнике.'");
		КонецЕсли;
		Возврат НСтр("ru = 'Требуется авторизация. Укажите токен доступа в источнике.'");
	КонецЕсли;

	Если Ответ.КодСостояния = 403 Тогда
		Если ТокенИсточникаЗаполнен(Источник) Тогда
			Возврат НСтр("ru = 'Токен не дает права read_api на этот проект.'");
		КонецЕсли;
		Возврат НСтр("ru = 'Доступ запрещен. Проект может быть закрытым, либо сервер отклонил частые запросы. Укажите токен в источнике или повторите позже.'");
	КонецЕсли;

	Если Ответ.КодСостояния = 404 Тогда
		Возврат НСтр("ru = 'Объект не найден. Проверьте путь проекта и имя пакета.'");
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ТокенИсточникаЗаполнен(Источник)

	Возврат Источник <> Неопределено
		И Источник.Свойство("Токен")
		И ЗначениеЗаполнено(Источник.Токен);

КонецФункции

Функция АдресAPI(Источник)

	Возврат Источник.URLСервера + "/api/v4";

КонецФункции

Функция АдресПроекта(Источник)

	Возврат СтрШаблон("%1/projects/%2", АдресAPI(Источник), Источник.IDПроекта);

КонецФункции

Функция АдресПакетов(Источник)

	Возврат АдресПроекта(Источник) + "/packages";

КонецФункции

Функция КодированныйСегмент(Знач Значение)

	Возврат КодироватьСтроку(Значение, СпособКодированияСтроки.КодировкаURL);

КонецФункции

// Разрешает идентификатор проекта по пути и запоминает его в источнике,
// чтобы не резолвить при каждом обращении.
Процедура ОбеспечитьIDПроекта(Источник)

	Если ЗначениеЗаполнено(Источник.IDПроекта) Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Источник.ПутьПроекта) Тогда
		ВызватьИсключение НСтр("ru = 'В источнике не заполнен путь проекта.'");
	КонецЕсли;

	Адрес = СтрШаблон("%1/projects/%2",
		АдресAPI(Источник),
		пм_ПровайдерыПакетов.КодированныйПутьПроекта(Источник.ПутьПроекта));

	Ответ = ВыполнитьЗапрос(Источник, Адрес);

	Если Ответ.КодСостояния = 404 Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Проект %1 не найден на сервере %2.'"),
			Источник.ПутьПроекта, Источник.URLСервера);
	КонецЕсли;

	ПроверитьОтвет(Источник, Ответ, НСтр("ru = 'Не удалось получить проект.'"));

	Проект = пм_КоннекторHTTP.КакJson(Ответ);
	Источник.IDПроекта = Формат(Проект.Получить("id"), "ЧГ=; ЧН=0");
	ЗапомнитьОписаниеПроекта(Источник, Проект.Получить("description"));

	Справочники.пм_ИсточникиПакетов.ЗапомнитьIDПроекта(Источник.Ссылка, Источник.IDПроекта);

КонецПроцедуры

Функция ОписаниеПроекта(Источник)

	Если Источник.Свойство("ОписаниеПроекта") Тогда
		Возврат Источник.ОписаниеПроекта;
	КонецЕсли;

	Ответ = ВыполнитьЗапрос(Источник, АдресПроекта(Источник));
	ПроверитьОтвет(Источник, Ответ, НСтр("ru = 'Не удалось получить проект.'"));

	Проект = пм_КоннекторHTTP.КакJson(Ответ);
	ЗапомнитьОписаниеПроекта(Источник, Проект.Получить("description"));

	Возврат Источник.ОписаниеПроекта;

КонецФункции

Процедура ЗапомнитьОписаниеПроекта(Источник, Значение)

	Источник.Вставить("ОписаниеПроекта", СокрЛП(Строка(Значение)));

КонецПроцедуры

#КонецОбласти

