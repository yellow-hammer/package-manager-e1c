#Область ПрограммныйИнтерфейс

// Создает структуру источника GitLab.
//
// Параметры:
//  URLСервера - Строка - URL GitLab, например https://gitlab.com.
//  ПутьПроекта - Строка - Путь проекта, например group/project.
//  ИмяПакета - Строка - Имя generic package.
//  Токен - Строка - Необязательный token для приватных проектов.
//
// Возвращаемое значение:
//  Структура - Описание источника.
//
Функция НовыйИсточник(URLСервера, ПутьПроекта, ИмяПакета, Токен = "") Экспорт
	
	Источник = Новый Структура;
	Источник.Вставить("Провайдер", "GitLab");
	Источник.Вставить("URLСервера", СократитьПравыйСлеш(URLСервера));
	Источник.Вставить("ПутьПроекта", ПутьПроекта);
	Источник.Вставить("IDПроекта", "");
	Источник.Вставить("ИмяПакета", ИмяПакета);
	Источник.Вставить("Токен", Токен);
	
	Возврат Источник;
	
КонецФункции

Функция ПроверитьИсточник(ИсточникПакетов) Экспорт
	
	IDПроекта = ПолучитьIDПроекта(ИсточникПакетов);
	Возврат ЗначениеЗаполнено(IDПроекта);
	
КонецФункции

Функция ПолучитьВерсииПакета(ИсточникПакетов, ЛимитВерсий = 20) Экспорт
	
	IDПроекта = ПолучитьIDПроекта(ИсточникПакетов);
	Сессия = НоваяСессия(ИсточникПакетов);
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("package_type", "generic");
	ПараметрыЗапроса.Вставить("package_name", ИсточникПакетов.ИмяПакета);
	ПараметрыЗапроса.Вставить("order_by", "created_at");
	ПараметрыЗапроса.Вставить("sort", "desc");
	ПараметрыЗапроса.Вставить("per_page", ЛимитВерсий);
	
	Ответ = пм_КоннекторHTTP.Get(
		АдресAPI(ИсточникПакетов, СтрШаблон("projects/%1/packages", IDПроекта)),
		ПараметрыЗапроса,
		,
		Сессия);
	
	ПроверитьОтвет(Ответ, НСтр("ru = 'Не удалось получить список версий package.'"));
	
	Возврат пм_КоннекторHTTP.КакJson(Ответ);
	
КонецФункции

Функция ПолучитьФайлыПакета(ИсточникПакетов, IDПакета) Экспорт
	
	Сессия = НоваяСессия(ИсточникПакетов);
	Ответ = пм_КоннекторHTTP.Get(
		АдресAPI(ИсточникПакетов, СтрШаблон("projects/%1/packages/%2/package_files",
			ПолучитьIDПроекта(ИсточникПакетов), IDПакета)),
		,
		,
		Сессия);
	
	ПроверитьОтвет(Ответ, НСтр("ru = 'Не удалось получить файлы package.'"));
	
	Возврат пм_КоннекторHTTP.КакJson(Ответ);
	
КонецФункции

Функция СкачатьФайлПакета(ИсточникПакетов, Версия, ИмяФайла) Экспорт
	
	Сессия = НоваяСессия(ИсточникПакетов);
	Ответ = пм_КоннекторHTTP.Get(
		АдресAPI(ИсточникПакетов, СтрШаблон("projects/%1/packages/generic/%2/%3/%4",
			ПолучитьIDПроекта(ИсточникПакетов),
			ИсточникПакетов.ИмяПакета,
			Версия,
			ИмяФайла)),
		,
		,
		Сессия);
	
	ПроверитьОтвет(Ответ, НСтр("ru = 'Не удалось скачать файл package.'"));
	
	Возврат Ответ.Тело;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьIDПроекта(ИсточникПакетов)
	
	Если ЗначениеЗаполнено(ИсточникПакетов.IDПроекта) Тогда
		Возврат ИсточникПакетов.IDПроекта;
	КонецЕсли;
	
	Сессия = НоваяСессия(ИсточникПакетов);
	Ответ = пм_КоннекторHTTP.Get(
		АдресAPI(ИсточникПакетов, "projects/" + КодироватьПутьПроекта(ИсточникПакетов.ПутьПроекта)),
		,
		,
		Сессия);
	
	ПроверитьОтвет(Ответ, НСтр("ru = 'Не удалось получить проект GitLab.'"));
	
	Проект = пм_КоннекторHTTP.КакJson(Ответ);
	Возврат Проект.Получить("id");
	
КонецФункции

Функция НоваяСессия(ИсточникПакетов)
	
	Сессия = пм_КоннекторHTTP.СоздатьСессию();
	Если ИсточникПакетов.Свойство("Токен") И ЗначениеЗаполнено(ИсточникПакетов.Токен) Тогда
		Сессия.Заголовки.Вставить("PRIVATE-TOKEN", ИсточникПакетов.Токен);
	КонецЕсли;
	
	Возврат Сессия;
	
КонецФункции

Функция АдресAPI(ИсточникПакетов, Путь)
	
	Возврат СократитьПравыйСлеш(ИсточникПакетов.URLСервера) + "/api/v4/" + Путь;
	
КонецФункции

Функция СократитьПравыйСлеш(Знач URL)
	
	Пока Прав(URL, 1) = "/" Цикл
		URL = Лев(URL, СтрДлина(URL) - 1);
	КонецЦикла;
	
	Возврат URL;
	
КонецФункции

Функция КодироватьПутьПроекта(ПутьПроекта)
	
	Возврат СтрЗаменить(ПутьПроекта, "/", "%2F");
	
КонецФункции

Процедура ПроверитьОтвет(Ответ, ТекстОшибки)
	
	Если Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300 Тогда
		Возврат;
	КонецЕсли;
	
	ВызватьИсключение СтрШаблон("%1 Код HTTP: %2", ТекстОшибки, Ответ.КодСостояния);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
