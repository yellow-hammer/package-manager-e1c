#Если Сервер Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Возвращает список поддерживаемых систем CI/CD.
//
// Возвращаемое значение:
//  СписокЗначений - Значение - идентификатор, представление - название системы.
//
Функция СистемыCI() Экспорт

	Список = Новый СписокЗначений;
	Список.Добавить(СистемаGitLab(), "GitLab CI");
	Список.Добавить(СистемаJenkins(), "Jenkins");
	Список.Добавить(СистемаGitHub(), "GitHub Actions");

	Возврат Список;

КонецФункции

// Текст шаблона из общего макета. Подстановок имени пакета нет.
//
// Параметры:
//  СистемаCI - Строка - Идентификатор системы, см. СистемыCI.
//
// Возвращаемое значение:
//  Строка - Готовый текст шаблона.
//
Функция СформироватьШаблон(СистемаCI) Экспорт

	ИмяМакета = ИмяМакетаШаблона(СистемаCI);

	Если Не ЗначениеЗаполнено(ИмяМакета) Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Неизвестная система CI/CD: %1.'"), СистемаCI);
	КонецЕсли;

	Возврат ПолучитьОбщийМакет(ИмяМакета).ПолучитьТекст();

КонецФункции

// Текст сопроводительного скрипта публикации. Для GitLab это OneScript,
// yaml его только запускает. Для остальных систем пустая строка.
Функция СформироватьСкриптПубликации(СистемаCI) Экспорт

	ИмяМакета = ИмяМакетаСкрипта(СистемаCI);
	Если Не ЗначениеЗаполнено(ИмяМакета) Тогда
		Возврат "";
	КонецЕсли;

	Возврат ПолучитьОбщийМакет(ИмяМакета).ПолучитьТекст();

КонецФункции

// Рекомендуемое имя файла, в который сохраняется шаблон.
Функция ИмяФайлаШаблона(СистемаCI) Экспорт

	Если СистемаCI = СистемаGitLab() Тогда
		Возврат "ci/package.gitlab-ci.yml";
	ИначеЕсли СистемаCI = СистемаJenkins() Тогда
		Возврат "Jenkinsfile";
	ИначеЕсли СистемаCI = СистемаGitHub() Тогда
		Возврат "package-release.yml";
	КонецЕсли;

	Возврат "template.txt";

КонецФункции

// Рекомендуемое имя сопроводительного скрипта. Пусто, если скрипт не нужен.
Функция ИмяФайлаСкриптаПубликации(СистемаCI) Экспорт

	Если СистемаCI = СистемаGitLab() Тогда
		Возврат "ci/publish-packages.os";
	КонецЕсли;

	Возврат "";

КонецФункции

// Имя файла со списком пакетов для публикации. Менеджер его не читает:
// это список для CI, не каталог источника.
Функция ИмяФайлаМанифестаПубликации() Экспорт

	Возврат "pm-packages.json";

КонецФункции

// Подсказка о том, что нужно настроить в самой системе CI/CD.
// Секреты и токены в шаблонах не генерируются, только имена переменных.
Функция ПодсказкаПоНастройке(СистемаCI) Экспорт

	ИмяМанифеста = ИмяФайлаМанифестаПубликации();

	Если СистемаCI = СистемаGitLab() Тогда
		Возврат СтрШаблон(НСтр("ru = 'Менеджер %1 не читает: каталог берется из реестра.
			|Пакеты публикуются под CI_JOB_TOKEN.
			|GitLab Release - отдельный job: нужен RELEASE_TOKEN
			|или GROUP_ACCESS_TOKEN (scope api). Если тег не protected,
			|переменная тоже не должна быть protected.
			|В корне репозитория нужен %1: список path и kind
			|(cfe / epf / erf). Путь может быть внутри сабмодуля.
			|Что не перечислено - не публикуется.
			|Логика публикации - ci/publish-packages.os, yaml его только запускает.
			|Сохраните оба файла. Глобальный vrunner не используйте.
			|Если CI уже есть, подключите фрагмент через include.'"), ИмяМанифеста);

	ИначеЕсли СистемаCI = СистемаJenkins() Тогда
		Возврат СтрШаблон(НСтр("ru = 'Менеджер %1 не читает: каталог берется из реестра.
			|В Jenkins нужно завести credentials:
			|gitlab-api-url - адрес API, например https://gitlab.example.com/api/v4
			|gitlab-project-id - идентификатор проекта
			|gitlab-package-token - токен с правом записи package (scope api).
			|В корне репозитория нужен %1 со списком path и kind.
			|Перед сборкой: git submodule update --init --recursive.
			|Та же Version и другая git tree SHA - ошибка, поднимите Version.'"), ИмяМанифеста);

	ИначеЕсли СистемаCI = СистемаGitHub() Тогда
		Возврат СтрШаблон(НСтр("ru = 'Менеджер %1 не читает: каталог берется из релизов.
			|Отдельный токен не нужен: используется GITHUB_TOKEN.
			|Файл кладется в .github/workflows/. Сабмодули клонируются вместе
			|с репозиторием. В корне нужен %1. Version в метаданных
			|должен совпасть с тегом. Та же версия и другая сумма исходников -
			|ошибка, поднимите Version.'"), ИмяМанифеста);

	КонецЕсли;

	Возврат "";

КонецФункции

Функция СистемаGitLab() Экспорт
	Возврат "GitLab";
КонецФункции

Функция СистемаJenkins() Экспорт
	Возврат "Jenkins";
КонецФункции

Функция СистемаGitHub() Экспорт
	Возврат "GitHub";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяМакетаШаблона(СистемаCI)

	Если СистемаCI = СистемаGitLab() Тогда
		Возврат "пм_ШаблонПубликацииGitLab";
	ИначеЕсли СистемаCI = СистемаJenkins() Тогда
		Возврат "пм_ШаблонПубликацииJenkins";
	ИначеЕсли СистемаCI = СистемаGitHub() Тогда
		Возврат "пм_ШаблонПубликацииGitHub";
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ИмяМакетаСкрипта(СистемаCI)

	Если СистемаCI = СистемаGitLab() Тогда
		Возврат "пм_СкриптПубликацииGitLab";
	КонецЕсли;

	Возврат "";

КонецФункции

#КонецОбласти

#КонецЕсли
