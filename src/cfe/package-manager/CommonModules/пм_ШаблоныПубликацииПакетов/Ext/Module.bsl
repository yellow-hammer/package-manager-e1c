// Возвращает список поддерживаемых систем CI/CD.
//
// Возвращаемое значение:
//  СписокЗначений - Значение - идентификатор, представление - название системы.
//
Функция СистемыCI() Экспорт

	Список = Новый СписокЗначений;
	Список.Добавить(СистемаGitLab(), "GitLab CI");
	Список.Добавить(СистемаJenkins(), "Jenkins");
	Список.Добавить(СистемаGitHub(), "GitHub Actions");
	Список.Добавить(СистемаGitea(), "Gitea Actions");

	Возврат Список;

КонецФункции

// Формирует текст шаблона публикации пакета.
// Тексты шаблонов хранятся в общих макетах расширения, а их источник -
// каталог templates/ci репозитория, см. tasks/sync-ci-templates.py.
//
// Параметры:
//  СистемаCI - Строка - Идентификатор системы, см. СистемыCI.
//  Параметры - Структура - См. НовыеПараметрыШаблона
//
// Возвращаемое значение:
//  Строка - Готовый текст шаблона.
//
Функция СформироватьШаблон(СистемаCI, Параметры) Экспорт

	ИмяМакета = ИмяМакетаШаблона(СистемаCI);

	Если Не ЗначениеЗаполнено(ИмяМакета) Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Неизвестная система CI/CD: %1.'"), СистемаCI);
	КонецЕсли;

	Текст = ПолучитьОбщийМакет(ИмяМакета).ПолучитьТекст();

	Текст = СтрЗаменить(Текст, "@PACKAGE_NAME@", Параметры.PACKAGE_NAME);
	Текст = СтрЗаменить(Текст, "@CFE_NAME@", Параметры.CFE_NAME);
	Текст = СтрЗаменить(Текст, "@CFE_PATH@", Параметры.CFE_PATH);

	Возврат Текст;

КонецФункции

// Параметры подстановки в шаблон.
//
// Возвращаемое значение:
//  Структура - Параметры шаблона:
// * PACKAGE_NAME - Строка - Имя package в реестре пакетов
// * CFE_NAME - Строка - Имя файла .cfe
// * CFE_PATH - Строка - Путь к собранному .cfe относительно корня проекта
//
Функция НовыеПараметрыШаблона() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("PACKAGE_NAME", "");
	Параметры.Вставить("CFE_NAME", "");
	Параметры.Вставить("CFE_PATH", "");

	Возврат Параметры;

КонецФункции

// Рекомендуемое имя файла, в который сохраняется шаблон.
Функция ИмяФайлаШаблона(СистемаCI) Экспорт

	Если СистемаCI = СистемаGitLab() Тогда
		Возврат ".gitlab-ci.yml";
	ИначеЕсли СистемаCI = СистемаJenkins() Тогда
		Возврат "Jenkinsfile";
	ИначеЕсли СистемаCI = СистемаGitHub() Или СистемаCI = СистемаGitea() Тогда
		Возврат "package-release.yml";
	КонецЕсли;

	Возврат "template.txt";

КонецФункции

// Подсказка о том, что нужно настроить в самой системе CI/CD.
// Секреты и токены в шаблонах не генерируются, только имена переменных.
Функция ПодсказкаПоНастройке(СистемаCI) Экспорт

	Если СистемаCI = СистемаGitLab() Тогда
		Возврат НСтр("ru = 'Токен не нужен: публикация идет под CI_JOB_TOKEN.
			|Файл кладется в корень репозитория как .gitlab-ci.yml.'");

	ИначеЕсли СистемаCI = СистемаJenkins() Тогда
		Возврат НСтр("ru = 'В Jenkins нужно завести credentials:
			|gitlab-api-url - адрес API, например https://gitlab.example.com/api/v4
			|gitlab-project-id - идентификатор проекта
			|gitlab-package-token - токен с правом записи package (scope api).'");

	ИначеЕсли СистемаCI = СистемаGitHub() Тогда
		Возврат НСтр("ru = 'Отдельный токен не нужен: используется GITHUB_TOKEN.
			|Файл кладется в .github/workflows/.'");

	ИначеЕсли СистемаCI = СистемаGitea() Тогда
		Возврат НСтр("ru = 'Нужен secret GITEA_TOKEN с правом записи релизов.
			|В шаблоне заполните GITEA_API_URL и GITEA_REPOSITORY.
			|Файл кладется в .gitea/workflows/.'");

	КонецЕсли;

	Возврат "";

КонецФункции

Функция СистемаGitLab() Экспорт
	Возврат "GitLab";
КонецФункции

Функция СистемаJenkins() Экспорт
	Возврат "Jenkins";
КонецФункции

Функция СистемаGitHub() Экспорт
	Возврат "GitHub";
КонецФункции

Функция СистемаGitea() Экспорт
	Возврат "Gitea";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяМакетаШаблона(СистемаCI)

	Если СистемаCI = СистемаGitLab() Тогда
		Возврат "пм_ШаблонПубликацииGitLab";
	ИначеЕсли СистемаCI = СистемаJenkins() Тогда
		Возврат "пм_ШаблонПубликацииJenkins";
	ИначеЕсли СистемаCI = СистемаGitHub() Тогда
		Возврат "пм_ШаблонПубликацииGitHub";
	ИначеЕсли СистемаCI = СистемаGitea() Тогда
		Возврат "пм_ШаблонПубликацииGitea";
	КонецЕсли;

	Возврат "";

КонецФункции

#КонецОбласти

#КонецЕсли
