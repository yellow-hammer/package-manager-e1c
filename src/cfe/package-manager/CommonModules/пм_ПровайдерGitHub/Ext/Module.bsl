// Выполняет GET с таймаутом и одним повтором при сетевой ошибке.
// Повторяется только обрыв связи: HTTP-ответ с любым кодом считается
// состоявшимся и возвращается как есть.
Функция ВыполнитьЗапрос(Источник, Адрес, ПараметрыЗапроса = Неопределено, ЭтоСкачивание = Ложь)

	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Таймаут", пм_ПровайдерыПакетов.ТаймаутЗапроса());
	Если ЭтоСкачивание Тогда
		ДополнительныеПараметры.Вставить("РазрешитьПеренаправление", Ложь);
	КонецЕсли;

	Попытка
		Возврат пм_КоннекторHTTP.Get(Адрес, ПараметрыЗапроса, ДополнительныеПараметры, НоваяСессия(Источник, ЭтоСкачивание));
	Исключение
		ОшибкаПервойПопытки = ИнформацияОбОшибке();
	КонецПопытки;

	Попытка
		Возврат пм_КоннекторHTTP.Get(Адрес, ПараметрыЗапроса, ДополнительныеПараметры, НоваяСессия(Источник, ЭтоСкачивание));
	Исключение
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Нет связи с сервером %1. Попытка повтора также не удалась.
			|%2'"),
			Источник.URLСервера,
			ПодробноеПредставлениеОшибки(ОшибкаПервойПопытки));
	КонецПопытки;

КонецФункции

Функция ВыполнитьЗапросБезТокена(Адрес)

	Попытка
		Возврат СкачатьПоПодписанномуАдресу(Адрес);
	Исключение
		ОшибкаПервойПопытки = ИнформацияОбОшибке();
	КонецПопытки;

	Попытка
		Возврат СкачатьПоПодписанномуАдресу(Адрес);
	Исключение
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Нет связи с сервером при скачивании файла. Попытка повтора также не удалась.
			|%1'"),
			ПодробноеПредставлениеОшибки(ОшибкаПервойПопытки));
	КонецПопытки;

КонецФункции

Функция СкачатьПоПодписанномуАдресу(Адрес)

	ТекущийАдрес = Адрес;

	Для НомерПеренаправления = 1 По 5 Цикл

		Ответ = ПолучитьПоАдресуКакЕсть(ТекущийАдрес);
		Если Не ЭтоКодПеренаправления(Ответ.КодСостояния) Тогда
			Возврат Ответ;
		КонецЕсли;

		СледующийАдрес = ЗаголовокОтвета(Ответ, "Location");
		Если Не ЗначениеЗаполнено(СледующийАдрес) Тогда
			Возврат Ответ;
		КонецЕсли;

		ТекущийАдрес = СледующийАдрес;

	КонецЦикла;

	ВызватьИсключение НСтр("ru = 'Слишком много перенаправлений при скачивании файла.'");

КонецФункции

Функция ПолучитьПоАдресуКакЕсть(Адрес)

	Состав = РазобратьАдресСкачивания(Адрес);

	ЗащищенноеСоединение = Неопределено;
	Если Состав.Защищенное Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(
			Неопределено, Новый СертификатыУдостоверяющихЦентровОС);
	КонецЕсли;

	Соединение = Новый HTTPСоединение(
		Состав.Хост,
		Состав.Порт,
		,
		,
		,
		пм_ПровайдерыПакетов.ТаймаутЗапроса(),
		ЗащищенноеСоединение);

	Запрос = Новый HTTPЗапрос(Состав.Ресурс);
	Запрос.Заголовки.Вставить("User-Agent", "package-manager");

	ОтветHTTP = Соединение.Получить(Запрос);

	Ответ = Новый Структура;
	Ответ.Вставить("КодСостояния", ОтветHTTP.КодСостояния);
	Ответ.Вставить("Заголовки", ОтветHTTP.Заголовки);
	Ответ.Вставить("Тело", ОтветHTTP.ПолучитьТелоКакДвоичныеДанные());

	Возврат Ответ;

КонецФункции

Процедура ПроверитьОтвет(Источник, Ответ, ТекстОшибки)

	Если Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300 Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СокрЛП(СтрШаблон("%1 %2 %3",
		ТекстОшибки,
		СтрШаблон(НСтр("ru = 'Код ответа: %1.'"), Ответ.КодСостояния),
		ПояснениеОшибкиОтвета(Источник, Ответ)));

КонецПроцедуры

// Пояснение к коду ответа GitHub: лимит запросов, токен, путь.
// 403 без токена чаще лимит, а не закрытый репозиторий.
//
Функция ПояснениеОшибкиОтвета(Источник, Ответ) Экспорт

	Если ЭтоПревышениеЛимитаЗапросов(Ответ) Тогда
		Возврат ПояснениеПревышенияЛимита(Источник, Ответ);
	КонецЕсли;

	Если Ответ.КодСостояния = 401 Тогда
		Если ТокенИсточникаЗаполнен(Источник) Тогда
			Возврат НСтр("ru = 'Токен доступа отклонен. Проверьте токен в источнике.'");
		КонецЕсли;
		Возврат НСтр("ru = 'Требуется авторизация. Укажите токен доступа в источнике.'");
	КонецЕсли;

	Если Ответ.КодСостояния = 403 Тогда
		Если ТокенИсточникаЗаполнен(Источник) Тогда
			Возврат НСтр("ru = 'Токен не дает права на чтение этого репозитория.'");
		КонецЕсли;
		Возврат НСтр("ru = 'Доступ запрещен. Репозиторий может быть закрытым, либо GitHub отклонил частые запросы без токена. Укажите токен в источнике или повторите позже.'");
	КонецЕсли;

	Если Ответ.КодСостояния = 404 Тогда
		Возврат НСтр("ru = 'Объект не найден. Проверьте путь проекта: он должен быть вида owner/repo.'");
	КонецЕсли;

	Возврат "";

КонецФункции

Функция АдресРепозитория(Источник)

	Сегменты = СегментыПутиРепозитория(Источник.ПутьПроекта);
	Если Сегменты.Количество() <> 2 Тогда
		ВызватьИсключение НСтр("ru = 'Путь проекта GitHub должен быть вида owner/repo.'");
	КонецЕсли;

	Возврат СтрШаблон("%1/repos/%2/%3",
		АдресПрограммногоИнтерфейса(Источник.URLСервера),
		КодированныйСегмент(Сегменты[0]),
		КодированныйСегмент(Сегменты[1]));

КонецФункции

Функция КодированныйСегмент(Знач Значение)

	Возврат КодироватьСтроку(Строка(Значение), СпособКодированияСтроки.КодировкаURL);

КонецФункции

Функция ХостИзURL(Знач URL)

	Остаток = URL;
	ПозицияСхемы = СтрНайти(Остаток, "://");
	Если ПозицияСхемы > 0 Тогда
		Остаток = Сред(Остаток, ПозицияСхемы + 3);
	КонецЕсли;

	ПозицияПути = СтрНайти(Остаток, "/");
	Если ПозицияПути > 0 Тогда
		Остаток = Лев(Остаток, ПозицияПути - 1);
	КонецЕсли;

	ПозицияПорта = СтрНайти(Остаток, ":");
	Если ПозицияПорта > 0 Тогда
		Остаток = Лев(Остаток, ПозицияПорта - 1);
	КонецЕсли;

	Возврат НРег(Остаток);

КонецФункции

Функция ЭтоХостGitHubCom(Хост)

	Возврат Хост = "github.com" Или Хост = "www.github.com" Или Хост = "api.github.com";

КонецФункции

Функция ЭтоКодПеренаправления(КодСостояния)

	Возврат КодСостояния = 301 Или КодСостояния = 302
		Или КодСостояния = 303 Или КодСостояния = 307 Или КодСостояния = 308;

КонецФункции

Функция ЭтоПревышениеЛимитаЗапросов(Ответ)

	Если Ответ.КодСостояния = 429 Тогда
		Возврат Истина;
	КонецЕсли;

	Если Ответ.КодСостояния <> 403 Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Строка(ЗаголовокОтвета(Ответ, "X-RateLimit-Remaining")) = "0" Тогда
		Возврат Истина;
	КонецЕсли;

	Тело = НРег(ТекстТелаОтвета(Ответ));
	Возврат СтрНайти(Тело, "rate limit") > 0
		Или СтрНайти(Тело, "rate_limit") > 0;

КонецФункции

Функция ПояснениеПревышенияЛимита(Источник, Ответ)

	КогдаПовторить = КогдаМожноПовторить(Ответ);
	Если ЗначениеЗаполнено(КогдаПовторить) Тогда
		Ожидание = СтрШаблон(
			НСтр("ru = 'Повторите после %1.'"),
			Формат(КогдаПовторить, "ДФ='dd.MM.yyyy HH:mm'"));
	Иначе
		Ожидание = НСтр("ru = 'Повторите позже.'");
	КонецЕсли;

	Если ТокенИсточникаЗаполнен(Источник) Тогда
		Возврат СтрШаблон(
			НСтр("ru = 'Превышен лимит запросов GitHub. %1'"),
			Ожидание);
	КонецЕсли;

	Возврат СтрШаблон(
		НСтр("ru = 'Превышен лимит запросов GitHub без токена. %1 Либо укажите токен доступа в источнике: с токеном лимит выше.'"),
		Ожидание);

КонецФункции

Функция КогдаМожноПовторить(Ответ)

	Повтор = СокрЛП(Строка(ЗаголовокОтвета(Ответ, "Retry-After")));
	Если ЗначениеЗаполнено(Повтор) Тогда
		Попытка
			Секунды = Число(Повтор);
			Если Секунды > 0 Тогда
				Возврат ТекущаяДатаСеанса() + Секунды;
			КонецЕсли;
		Исключение
			// Retry-After бывает датой HTTP, для подсказки достаточно X-RateLimit-Reset.
		КонецПопытки;
	КонецЕсли;

	Сброс = СокрЛП(Строка(ЗаголовокОтвета(Ответ, "X-RateLimit-Reset")));
	Если Не ЗначениеЗаполнено(Сброс) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Секунды = Число(Сброс);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если Секунды <= 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	// X-RateLimit-Reset - это Unix-время в UTC, а показываем местное.
	Возврат МестноеВремя(Дата(1970, 1, 1) + Секунды);

КонецФункции

Функция ТекстТелаОтвета(Ответ)

	Если Не Ответ.Свойство("Тело") Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Ответ.Тело) = Тип("Строка") Тогда
		Возврат Ответ.Тело;
	КонецЕсли;

	Если ТипЗнч(Ответ.Тело) <> Тип("ДвоичныеДанные") Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		// Тело может быть сжато: коннектор распакует его сам.
		Возврат пм_КоннекторHTTP.КакТекст(Ответ);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

Функция ТокенИсточникаЗаполнен(Источник)

	Возврат Источник <> Неопределено
		И Источник.Свойство("Токен")
		И ЗначениеЗаполнено(Источник.Токен);

КонецФункции

Функция ЗаголовокОтвета(Ответ, ИмяЗаголовка)

	Если Ответ.Заголовки = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Значение = Ответ.Заголовки.Получить(ИмяЗаголовка);
	Если ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	Для Каждого Элемент Из Ответ.Заголовки Цикл
		Если СтрСравнить(Строка(Элемент.Ключ), ИмяЗаголовка) = 0 Тогда
			Возврат Элемент.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Разрешает идентификатор репозитория по пути и запоминает его в источнике,
// чтобы не резолвить при каждом обращении.
Процедура ОбеспечитьIDПроекта(Источник)

	Если ЗначениеЗаполнено(Источник.IDПроекта) Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Источник.ПутьПроекта) Тогда
		ВызватьИсключение НСтр("ru = 'В источнике не заполнен путь проекта.'");
	КонецЕсли;

	Сегменты = СегментыПутиРепозитория(Источник.ПутьПроекта);
	Если Сегменты.Количество() <> 2 Тогда
		ВызватьИсключение НСтр("ru = 'Путь проекта GitHub должен быть вида owner/repo.'");
	КонецЕсли;

	Ответ = ВыполнитьЗапрос(Источник, АдресРепозитория(Источник));

	Если Ответ.КодСостояния = 404 Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Репозиторий %1 не найден на сервере %2.'"),
			Источник.ПутьПроекта, Источник.URLСервера);
	КонецЕсли;

	ПроверитьОтвет(Источник, Ответ, НСтр("ru = 'Не удалось получить репозиторий.'"));

	Репозиторий = пм_КоннекторHTTP.КакJson(Ответ);
	Источник.IDПроекта = Формат(Репозиторий.Получить("id"), "ЧГ=; ЧН=0");
	ЗапомнитьОписаниеПроекта(Источник, Репозиторий.Получить("description"));

	Справочники.пм_ИсточникиПакетов.ЗапомнитьIDПроекта(Источник.Ссылка, Источник.IDПроекта);

КонецПроцедуры

Функция ОписаниеРепозитория(Источник)

	Если Источник.Свойство("ОписаниеПроекта") Тогда
		Возврат Источник.ОписаниеПроекта;
	КонецЕсли;

	Ответ = ВыполнитьЗапрос(Источник, АдресРепозитория(Источник));
	ПроверитьОтвет(Источник, Ответ, НСтр("ru = 'Не удалось получить репозиторий.'"));

	Репозиторий = пм_КоннекторHTTP.КакJson(Ответ);
	ЗапомнитьОписаниеПроекта(Источник, Репозиторий.Получить("description"));

	Возврат Источник.ОписаниеПроекта;

КонецФункции

Процедура ЗапомнитьОписаниеПроекта(Источник, Значение)

	Источник.Вставить("ОписаниеПроекта", СокрЛП(Строка(Значение)));

КонецПроцедуры

#КонецОбласти

#КонецЕсли
