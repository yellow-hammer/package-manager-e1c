
#Область ПрограммныйИнтерфейс

// Серверная часть старта клиента: один вызов на весь запуск.
//
// Параметры:
//  ПараметрыКлиента - Соответствие - Хранилище переменных клиента.
//
Процедура ПриНачалеРаботыСистемы(Знач ПараметрыКлиента) Экспорт

	ЗапомнитьПараметрыКлиента(ПараметрыКлиента);
	СверитьУстановленныеПакеты();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗапомнитьПараметрыКлиента(Знач Параметры)

	УстановитьПривилегированныйРежим(Истина);
	ПараметрыСеанса.пм_ПараметрыКлиентаНаСервере = Новый ФиксированноеСоответствие(Параметры);

КонецПроцедуры

// Сверка идет при старте, поэтому ее ошибка не должна ломать вход:
// она уходит в журнал регистрации, а не пользователю.
//
// Список расширений виден только администратору. Обычному пользователю
// сверять нечем, и это не ошибка.
Процедура СверитьУстановленныеПакеты()

	Если Не ПравоДоступа("Администрирование", Метаданные) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		пм_МенеджерПакетов.СверитьУстановленныеПакеты();
	Исключение
		ЗаписьЖурналаРегистрации(
			пм_МенеджерПакетов.ИмяСобытияСверки(),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
