#Область ПрограммныйИнтерфейс

// Возвращает имена поддерживаемых провайдеров.
//
// Возвращаемое значение:
//  Массив - Имена провайдеров.
//
Функция ПоддерживаемыеПровайдеры() Экспорт
	
	Провайдеры = Новый Массив;
	Провайдеры.Добавить("GitLab");
	Провайдеры.Добавить("GitHub");
	Провайдеры.Добавить("Gitea");
	
	Возврат Провайдеры;
	
КонецФункции

// Возвращает общий модуль провайдера по имени.
//
// Параметры:
//  ИмяПровайдера - Строка - GitLab, GitHub или Gitea.
//
// Возвращаемое значение:
//  ОбщийМодуль - Модуль провайдера.
//
Функция МодульПровайдера(ИмяПровайдера) Экспорт
	
	Если ИмяПровайдера = "GitLab" Тогда
		Возврат пм_ОбщегоНазначения.ОбщийМодуль("пм_ПровайдерGitLab");
	КонецЕсли;
	
	ВызватьИсключение СтрШаблон(
		НСтр("ru = 'Провайдер %1 пока не реализован.'"),
		ИмяПровайдера);
	
КонецФункции

#КонецОбласти

#КонецЕсли
