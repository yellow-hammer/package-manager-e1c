#Если Сервер Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Возвращает провайдера, подставляемого в новый источник по умолчанию.
Функция ПровайдерПоУмолчанию() Экспорт

	Возврат Перечисления.пм_Провайдеры.GitLab;

КонецФункции

// Время ожидания HTTP-запроса к провайдеру, в секундах.
Функция ТаймаутЗапроса() Экспорт

	Возврат 60;

КонецФункции

// Кодирует путь проекта для подстановки в адрес API одним сегментом.
//
// Живет в серверном модуле намеренно: КодироватьСтроку и
// СпособКодированияСтроки на тонком клиенте недоступны, и в
// клиент-серверном модуле такой код ломает компиляцию на клиенте.
//
// Параметры:
//  Путь - Строка - Путь вида group/project.
//
// Возвращаемое значение:
//  Строка - Путь, пригодный для подстановки в URL.
//
Функция КодированныйПутьПроекта(Знач Путь) Экспорт

	Нормализованный = пм_МенеджерПакетовКлиентСервер.НормализованныйПутьПроекта(Путь);

	Возврат КодироватьСтроку(Нормализованный, СпособКодированияСтроки.КодировкаURL);

КонецФункции

// Возвращает общий модуль провайдера.
//
// Параметры:
//  Провайдер - ПеречислениеСсылка.пм_Провайдеры - Провайдер источника.
//
// Возвращаемое значение:
//  ОбщийМодуль - Модуль, реализующий контракт провайдера.
//
Функция МодульПровайдера(Провайдер) Экспорт

	ИмяМодуля = ИмяМодуляПровайдера(Провайдер);

	Если Не ЗначениеЗаполнено(ИмяМодуля) Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Провайдер %1 пока не реализован.'"), Провайдер);
	КонецЕсли;

	Возврат пм_ОбщегоНазначения.ОбщийМодуль(ИмяМодуля);

КонецФункции

// Возвращает Истина, если для провайдера есть реализация.
Функция ПровайдерРеализован(Провайдер) Экспорт

	Возврат ЗначениеЗаполнено(ИмяМодуляПровайдера(Провайдер));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Соответствие провайдера и реализующего его модуля.
// GitHub и Gitea заведены в перечислении, но модулей под них еще нет:
// контракт зафиксирован, реализация появится на следующих этапах.
Функция ИмяМодуляПровайдера(Провайдер)

	Если Провайдер = Перечисления.пм_Провайдеры.GitLab Тогда
		Возврат "пм_ПровайдерGitLab";
	КонецЕсли;

	Возврат "";

КонецФункции

#КонецОбласти

#КонецЕсли
