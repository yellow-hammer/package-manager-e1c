#Область ПрограммныйИнтерфейс

// Разбирает строку версии по правилам semver.
// Заменяет внешнюю компоненту регулярных выражений: для semver
// достаточно средств платформы.
//
// Параметры:
//  СтрокаВерсии - Строка - Например 1.2.3, 1.2.3-rc1, 1.2.3-dev.5.
//
// Возвращаемое значение:
//  Структура - Разобранная версия:
// * Семантическая - Булево - Ложь, если строка не соответствует semver
// * Мажорная - Число
// * Минорная - Число
// * Патч - Число
// * Пререлиз - Строка - Часть после дефиса, пустая для релиза
// * ТипРелиза - Строка - stable, rc, dev либо other
// * Представление - Строка - Исходная строка
//
Функция РазобратьВерсию(Знач СтрокаВерсии) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Семантическая", Ложь);
	Результат.Вставить("Мажорная", 0);
	Результат.Вставить("Минорная", 0);
	Результат.Вставить("Патч", 0);
	Результат.Вставить("Пререлиз", "");
	Результат.Вставить("ТипРелиза", ТипРелизаПрочее());
	Результат.Вставить("Представление", СтрокаВерсии);

	Версия = СокрЛП(СтрокаВерсии);
	Если Не ЗначениеЗаполнено(Версия) Тогда
		Возврат Результат;
	КонецЕсли;

	// Часть сборки после плюса на сравнение не влияет и отбрасывается.
	ПозицияСборки = СтрНайти(Версия, "+");
	Если ПозицияСборки > 0 Тогда
		Версия = Лев(Версия, ПозицияСборки - 1);
	КонецЕсли;

	ПозицияДефиса = СтрНайти(Версия, "-");
	Если ПозицияДефиса > 0 Тогда
		Пререлиз = Сред(Версия, ПозицияДефиса + 1);
		Версия = Лев(Версия, ПозицияДефиса - 1);
	Иначе
		Пререлиз = "";
	КонецЕсли;

	ЧастиЯдра = СтрРазделить(Версия, ".", Истина);
	Если ЧастиЯдра.Количество() <> 3 Тогда
		Возврат Результат;
	КонецЕсли;

	Числа = Новый Массив;
	Для Каждого Часть Из ЧастиЯдра Цикл
		Если Не ЭтоЦелоеБезЗнака(Часть) Тогда
			Возврат Результат;
		КонецЕсли;
		Числа.Добавить(Число(Часть));
	КонецЦикла;

	Результат.Семантическая = Истина;
	Результат.Мажорная = Числа[0];
	Результат.Минорная = Числа[1];
	Результат.Патч = Числа[2];
	Результат.Пререлиз = Пререлиз;
	Результат.ТипРелиза = ТипРелизаПоПререлизу(Пререлиз);

	Возврат Результат;

КонецФункции

// Сравнивает две версии по правилам semver.
//
// Параметры:
//  ВерсияЛево - Строка - Первая версия.
//  ВерсияПраво - Строка - Вторая версия.
//
// Возвращаемое значение:
//  Число - Минус 1 если левая младше, 0 если равны, 1 если левая старше.
//
Функция СравнитьВерсии(Знач ВерсияЛево, Знач ВерсияПраво) Экспорт

	Лево = РазобратьВерсию(ВерсияЛево);
	Право = РазобратьВерсию(ВерсияПраво);

	// Несемантические версии сравнивать по числам нельзя:
	// порядок для них задается датой создания пакета, а не строкой.
	Если Не Лево.Семантическая И Не Право.Семантическая Тогда
		Возврат 0;
	ИначеЕсли Не Лево.Семантическая Тогда
		Возврат -1;
	ИначеЕсли Не Право.Семантическая Тогда
		Возврат 1;
	КонецЕсли;

	Для Каждого ИмяЧасти Из СтрРазделить("Мажорная,Минорная,Патч", ",") Цикл
		Если Лево[ИмяЧасти] < Право[ИмяЧасти] Тогда
			Возврат -1;
		ИначеЕсли Лево[ИмяЧасти] > Право[ИмяЧасти] Тогда
			Возврат 1;
		КонецЕсли;
	КонецЦикла;

	Возврат СравнитьПререлизы(Лево.Пререлиз, Право.Пререлиз);

КонецФункции

// Проверяет, подходит ли версия под выбранный тип релиза.
//
// Параметры:
//  СтрокаВерсии - Строка - Версия.
//  ТипРелиза - Строка - stable, rc, dev либо пустая строка для любого типа.
//
// Возвращаемое значение:
//  Булево - Истина, если версия подходит под фильтр.
//
Функция ВерсияПодходитПодФильтр(Знач СтрокаВерсии, Знач ТипРелиза) Экспорт

	Если Не ЗначениеЗаполнено(ТипРелиза) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат РазобратьВерсию(СтрокаВерсии).ТипРелиза = ТипРелиза;

КонецФункции

// Сортирует таблицу версий от новых к старым.
// Семантические версии идут первыми и сравниваются по semver,
// несемантические уходят в конец и сортируются по дате создания.
//
// Параметры:
//  ТаблицаВерсий - ТаблицаЗначений - Должна содержать колонки
//                  Номер (Строка) и ДатаСоздания (Дата).
//
Процедура ОтсортироватьВерсии(ТаблицаВерсий) Экспорт

	Если ТаблицаВерсий.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;

	СлужебнаяКолонка = "пм_КлючСортировки";
	Если ТаблицаВерсий.Колонки.Найти(СлужебнаяКолонка) = Неопределено Тогда
		ТаблицаВерсий.Колонки.Добавить(СлужебнаяКолонка, Новый ОписаниеТипов("Строка"));
	КонецЕсли;

	Для Каждого Строка Из ТаблицаВерсий Цикл
		Строка[СлужебнаяКолонка] = КлючСортировки(Строка.Номер);
	КонецЦикла;

	ТаблицаВерсий.Сортировать(СлужебнаяКолонка + " Убыв, ДатаСоздания Убыв");
	ТаблицаВерсий.Колонки.Удалить(СлужебнаяКолонка);

КонецПроцедуры

// Возвращает Истина, если строка версии не соответствует semver.
Функция ЭтоНесемантическаяВерсия(Знач СтрокаВерсии) Экспорт

	Возврат Не РазобратьВерсию(СтрокаВерсии).Семантическая;

КонецФункции

Функция ТипРелизаСтабильный() Экспорт
	Возврат "stable";
КонецФункции

Функция ТипРелизаПредварительный() Экспорт
	Возврат "rc";
КонецФункции

Функция ТипРелизаРазработки() Экспорт
	Возврат "dev";
КонецФункции

Функция ТипРелизаПрочее() Экспорт
	Возврат "other";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Строковый ключ, лексикографический порядок которого совпадает
// с semver-порядком версий. Позволяет отсортировать таблицу штатным
// методом Сортировать без построчного сравнения.
Функция КлючСортировки(Знач СтрокаВерсии)

	Версия = РазобратьВерсию(СтрокаВерсии);
	Если Не Версия.Семантическая Тогда
		// Несемантические уходят в конец: пустой ключ младше любого числового.
		Возврат "";
	КонецЕсли;

	// Релиз старше любого своего пререлиза, поэтому у релиза признак 1,
	// у пререлиза 0 плюс дополненные нулями идентификаторы.
	Если ЗначениеЗаполнено(Версия.Пререлиз) Тогда
		ПризнакРелиза = "0";
		ХвостПререлиза = ДополненныйПререлиз(Версия.Пререлиз);
	Иначе
		ПризнакРелиза = "1";
		ХвостПререлиза = "";
	КонецЕсли;

	Возврат СтрШаблон("%1.%2.%3.%4%5",
		ДополнитьЧисло(Версия.Мажорная),
		ДополнитьЧисло(Версия.Минорная),
		ДополнитьЧисло(Версия.Патч),
		ПризнакРелиза,
		ХвостПререлиза);

КонецФункции

Функция ДополнитьЧисло(Знач Значение)

	Возврат Прав("0000000000" + Формат(Значение, "ЧГ=; ЧН=0"), 10);

КонецФункции

// Числовые идентификаторы пререлиза дополняются нулями, чтобы 10 не
// оказалось младше 9 при строковом сравнении.
Функция ДополненныйПререлиз(Знач Пререлиз)

	Результат = "";

	Для Каждого Идентификатор Из СтрРазделить(Пререлиз, ".", Истина) Цикл
		Части = РазложитьИдентификатор(Идентификатор);
		Результат = Результат + "." + Части.Префикс + ДополнитьЧисло(Части.Номер);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Раскладывает идентификатор пререлиза на буквенный префикс и числовой хвост:
// "rc10" -> "rc" и 10, "12" -> "" и 12, "alpha" -> "alpha" и 0.
//
// Отступление от строгого semver, сделанное осознанно. По спецификации
// идентификатор с буквами сравнивается лексически целиком, то есть
// "rc10" < "rc9". Схема версий проекта использует запись "-rc1", "-rc2"
// без точки, поэтому лексическое сравнение дало бы rc10 младше rc9.
// Числовой хвост выделяется и сравнивается численно.
// На записи с точкой ("-dev.5") правило не влияет: там номер и так
// отдельный числовой идентификатор.
Функция РазложитьИдентификатор(Знач Идентификатор)

	ДлинаХвоста = 0;
	Пока ДлинаХвоста < СтрДлина(Идентификатор) Цикл
		Символ = Сред(Идентификатор, СтрДлина(Идентификатор) - ДлинаХвоста, 1);
		Если СтрНайти("0123456789", Символ) = 0 Тогда
			Прервать;
		КонецЕсли;
		ДлинаХвоста = ДлинаХвоста + 1;
	КонецЦикла;

	Результат = Новый Структура("Префикс, Номер", Идентификатор, 0);

	Если ДлинаХвоста > 0 Тогда
		Результат.Префикс = Лев(Идентификатор, СтрДлина(Идентификатор) - ДлинаХвоста);
		Результат.Номер = Число(Прав(Идентификатор, ДлинаХвоста));
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция СравнитьПререлизы(Знач Лево, Знач Право)

	// Версия без пререлиза старше версии с пререлизом.
	Если Не ЗначениеЗаполнено(Лево) И Не ЗначениеЗаполнено(Право) Тогда
		Возврат 0;
	ИначеЕсли Не ЗначениеЗаполнено(Лево) Тогда
		Возврат 1;
	ИначеЕсли Не ЗначениеЗаполнено(Право) Тогда
		Возврат -1;
	КонецЕсли;

	ЧастиЛево = СтрРазделить(Лево, ".", Истина);
	ЧастиПраво = СтрРазделить(Право, ".", Истина);
	КоличествоЧастей = Макс(ЧастиЛево.Количество(), ЧастиПраво.Количество());

	Для Индекс = 0 По КоличествоЧастей - 1 Цикл

		// Более короткий набор идентификаторов младше при равном начале.
		Если Индекс >= ЧастиЛево.Количество() Тогда
			Возврат -1;
		ИначеЕсли Индекс >= ЧастиПраво.Количество() Тогда
			Возврат 1;
		КонецЕсли;

		ЧастьЛево = РазложитьИдентификатор(ЧастиЛево[Индекс]);
		ЧастьПраво = РазложитьИдентификатор(ЧастиПраво[Индекс]);

		// Сначала буквенный префикс, затем числовой хвост.
		// Чисто числовой идентификатор имеет пустой префикс и потому
		// оказывается младше любого буквенного, как и требует semver.
		Если ЧастьЛево.Префикс <> ЧастьПраво.Префикс Тогда
			Возврат ?(ЧастьЛево.Префикс < ЧастьПраво.Префикс, -1, 1);
		КонецЕсли;

		Если ЧастьЛево.Номер <> ЧастьПраво.Номер Тогда
			Возврат ?(ЧастьЛево.Номер < ЧастьПраво.Номер, -1, 1);
		КонецЕсли;

	КонецЦикла;

	Возврат 0;

КонецФункции

Функция ТипРелизаПоПререлизу(Знач Пререлиз)

	Если Не ЗначениеЗаполнено(Пререлиз) Тогда
		Возврат ТипРелизаСтабильный();
	КонецЕсли;

	ПервыйИдентификатор = НРег(СтрРазделить(Пререлиз, ".", Истина)[0]);

	Если СтрНачинаетсяС(ПервыйИдентификатор, "rc") Тогда
		Возврат ТипРелизаПредварительный();
	ИначеЕсли СтрНачинаетсяС(ПервыйИдентификатор, "dev") Тогда
		Возврат ТипРелизаРазработки();
	КонецЕсли;

	Возврат ТипРелизаПрочее();

КонецФункции

Функция ЭтоЦелоеБезЗнака(Знач Значение)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Цифры = "0123456789";
	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти(Цифры, Сред(Значение, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

#КонецОбласти
