#Если Сервер Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Устанавливает файл пакета подходящим установщиком.
// Установщик выбирается по типу файла: строковая диспетчеризация через
// Выполнить заменена явным выбором, поэтому имя обработчика из манифеста
// каталога больше не используется.
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - Содержимое файла пакета.
//  ИмяФайла - Строка - Имя файла с расширением.
//
// Возвращаемое значение:
//  Структура - Результат установки:
// * Успешно - Булево
// * ТекстОшибки - Строка
// * ТребуетсяПерезапуск - Булево
// * АдресВоВременномХранилище - Строка - Заполняется для внешних файлов
// * ИмяФормы - Строка - Заполняется для внешних файлов
// * Замечания - Строка - Замечания платформы, установку не отменяют
//
Функция УстановитьФайлПакета(ДвоичныеДанные, ИмяФайла) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("ТребуетсяПерезапуск", Ложь);
	Результат.Вставить("АдресВоВременномХранилище", "");
	Результат.Вставить("ИмяФормы", "");
	Результат.Вставить("Замечания", "");

	ТипФайла = ТипФайлаПакета(ИмяФайла);

	Если ТипФайла = ТипФайлаРасширение() Тогда

		РезультатУстановки = пм_УстановщикРасширений.УстановитьИзДвоичныхДанных(ДвоичныеДанные);
		ЗаполнитьЗначенияСвойств(Результат, РезультатУстановки);

	ИначеЕсли ТипФайла = ТипФайлаОбработка() Или ТипФайла = ТипФайлаОтчет() Тогда

		// Без безопасного режима, как и расширения: пакет пришел из своего
		// реестра, а в безопасном режиме обработке недоступны файлы и COM.
		РезультатПодготовки = пм_УстановщикВнешнихФайлов.ПодготовитьВнешнийФайл(
			ДвоичныеДанные, ИмяФайла, Ложь);
		ЗаполнитьЗначенияСвойств(Результат, РезультатПодготовки);

	Иначе

		Результат.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Файл %1 не поддерживается: установить можно .cfe, .epf и .erf.'"),
			ИмяФайла);

	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает тип файла пакета по его имени.
//
// Параметры:
//  ИмяФайла - Строка - Имя файла с расширением.
//
// Возвращаемое значение:
//  Строка - cfe, epf, erf либо пустая строка.
//
Функция ТипФайлаПакета(Знач ИмяФайла) Экспорт

	ИмяФайла = НРег(СокрЛП(ИмяФайла));

	Для Каждого Тип Из ПоддерживаемыеТипыФайлов() Цикл
		Если СтрЗаканчиваетсяНа(ИмяФайла, "." + Тип) Тогда
			Возврат Тип;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Возвращает Истина, если файл пакета - это само расширение менеджера пакетов.
// Проверяется имя расширения внутри файла, а не имя файла: имя файла
// пользователь может задать любым, а имя расширения определяет платформа.
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - Содержимое файла .cfe.
//  ИмяФайла - Строка - Имя файла с расширением.
//
// Возвращаемое значение:
//  Булево - Истина, если менеджер пакетов обновляет сам себя.
//
Функция ЭтоСамообновление(ДвоичныеДанные, ИмяФайла) Экспорт

	Если ТипФайлаПакета(ИмяФайла) <> ТипФайлаРасширение() Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ОписаниеРасширения = Новый ОписаниеКонфигурации(ДвоичныеДанные);
	Исключение
		// Разбирать файл здесь не наша задача: если он битый,
		// об этом сообщит установщик расширений.
		Возврат Ложь;
	КонецПопытки;

	Возврат ОписаниеРасширения.Имя = пм_МенеджерПакетовКлиентСервер.ИмяРасширенияМенеджера();

КонецФункции

// Выбирает файл версии пакета из списка, который вернул провайдер.
// Сопроводительные файлы вроде .srcsha не считаются. Без имени
// однозначен только единственный устанавливаемый файл.
//
// Параметры:
//  Файлы - Массив - Соответствия с ключом file_name.
//  ИмяФайла - Строка - Ожидаемое имя файла, может быть пустым.
//
// Возвращаемое значение:
//  Соответствие, Неопределено - Описание файла либо Неопределено.
//
Функция ВыбратьФайлВерсии(Файлы, Знач ИмяФайла = "") Экспорт

	Если Файлы = Неопределено Или Файлы.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Устанавливаемые = Новый Массив;
	Для Каждого Файл Из Файлы Цикл
		Если ЗначениеЗаполнено(ТипФайлаПакета(Строка(Файл.Получить("file_name")))) Тогда
			Устанавливаемые.Добавить(Файл);
		КонецЕсли;
	КонецЦикла;

	Если ЗначениеЗаполнено(ИмяФайла) Тогда

		Для Каждого Файл Из Устанавливаемые Цикл
			Если СтрСравнить(Строка(Файл.Получить("file_name")), ИмяФайла) = 0 Тогда
				Возврат Файл;
			КонецЕсли;
		КонецЦикла;

		Для Каждого Файл Из Устанавливаемые Цикл
			Если СтрСравнить(ИмяПакетаИзИмениФайла(Файл.Получить("file_name")), ИмяФайла) = 0 Тогда
				Возврат Файл;
			КонецЕсли;
		КонецЦикла;

		Возврат Неопределено;

	КонецЕсли;

	Если Устанавливаемые.Количество() <> 1 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Устанавливаемые[0];

КонецФункции

// Имя package из имени файла: solution.cfe -> solution.
// Неподдерживаемое расширение дает пустую строку.
//
// Параметры:
//  ИмяФайла - Строка - Имя файла с расширением.
//
// Возвращаемое значение:
//  Строка - Имя пакета либо пустая строка.
//
Функция ИмяПакетаИзИмениФайла(Знач ИмяФайла) Экспорт

	ИмяФайла = СокрЛП(Строка(ИмяФайла));
	ТипФайла = ТипФайлаПакета(ИмяФайла);
	Если Не ЗначениеЗаполнено(ТипФайла) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Лев(ИмяФайла, СтрДлина(ИмяФайла) - СтрДлина(ТипФайла) - 1);

КонецФункции

Функция ТипФайлаРасширение() Экспорт
	Возврат "cfe";
КонецФункции

Функция ТипФайлаОбработка() Экспорт
	Возврат "epf";
КонецФункции

Функция ТипФайлаОтчет() Экспорт
	Возврат "erf";
КонецФункции

// Типы файлов, которые менеджер умеет устанавливать.
Функция ПоддерживаемыеТипыФайлов() Экспорт

	Типы = Новый Массив;
	Типы.Добавить(ТипФайлаРасширение());
	Типы.Добавить(ТипФайлаОбработка());
	Типы.Добавить(ТипФайлаОтчет());

	Возврат Типы;

КонецФункции

// Сверяет регистр установленных пакетов с расширениями информационной базы:
// расширение сняли вручную - запись о пакете снимается. Вызывается при старте.
//
// Пакеты .epf и .erf не сверяются: менеджер их в базу не устанавливает,
// а открывает из временного хранилища, поэтому проверять нечего.
//
// Возвращаемое значение:
//  Число - Сколько записей снято.
//
Функция СверитьУстановленныеПакеты() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Сведения = РегистрыСведений.пм_УстановленныеПакеты.ВерсииПакетов();
	Если Сведения.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	ИменаРасширений = ИменаРасширенийИнформационнойБазы();

	Удалено = 0;
	Для Каждого Строка Из Сведения Цикл

		Если Не ЗначениеЗаполнено(Строка.Пакет) Тогда
			Продолжить;
		КонецЕсли;

		Если ПакетЕстьВСпискеРасширений(Строка.Пакет, Строка.ИмяФайла, ИменаРасширений) Тогда
			Продолжить;
		КонецЕсли;

		Если РегистрыСведений.пм_УстановленныеПакеты.УдалитьСведения(Строка.Источник, Строка.Пакет) Тогда
			Удалено = Удалено + 1;
		КонецЕсли;

	КонецЦикла;

	Если Удалено > 0 Тогда
		ЗаписьЖурналаРегистрации(
			ИмяСобытияСверки(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			СтрШаблон(
				НСтр("ru = 'Расширений удалено из базы, сведения о пакетах сняты: %1.'"),
				Удалено));
	КонецЕсли;

	Возврат Удалено;

КонецФункции

// Пакет по-прежнему установлен в информационной базе.
// Для .epf и .erf всегда Истина: в базу они не устанавливаются.
//
// Параметры:
//  ИмяПакета - Строка - Имя package, оно же имя расширения в базе.
//  ИмяФайла - Строка - Имя файла пакета, по нему определяется тип.
//
// Возвращаемое значение:
//  Булево
//
Функция ПакетПрисутствуетВИнформационнойБазе(ИмяПакета, ИмяФайла) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Возврат ПакетЕстьВСпискеРасширений(
		ИмяПакета, ИмяФайла, ИменаРасширенийИнформационнойБазы());

КонецФункции

// Имя события журнала регистрации для сверки установленных пакетов.
Функция ИмяСобытияСверки() Экспорт

	Возврат НСтр("ru = 'Менеджер пакетов.Сверка установленных'");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Тип файла неизвестен - запись не трогаем: снимаем только то,
// про что точно знаем, что это расширение.
Функция ПакетЕстьВСпискеРасширений(ИмяПакета, ИмяФайла, ИменаРасширений)

	Если ТипФайлаПакета(ИмяФайла) <> ТипФайлаРасширение() Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ИменаРасширений.Получить(НРег(СокрЛП(Строка(ИмяПакета)))) = Истина;

КонецФункции

Функция ИменаРасширенийИнформационнойБазы()

	Имена = Новый Соответствие;
	Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
		Имена.Вставить(НРег(Расширение.Имя), Истина);
	КонецЦикла;

	Возврат Имена;

КонецФункции

#КонецОбласти

#КонецЕсли
