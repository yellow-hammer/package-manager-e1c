#Если Сервер Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Подготавливает внешний файл .epf/.erf для открытия или подключения.
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - Содержимое файла.
//  ИмяФайла - Строка - Имя файла с расширением.
//  БезопасныйРежим - Булево - Подключать файл в безопасном режиме.
//
// Возвращаемое значение:
//  Структура - Результат подготовки:
// * Успешно - Булево
// * ТекстОшибки - Строка
// * АдресВоВременномХранилище - Строка
// * ИмяФормы - Строка
//
Функция ПодготовитьВнешнийФайл(ДвоичныеДанные, ИмяФайла, БезопасныйРежим = Истина) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("АдресВоВременномХранилище", "");
	Результат.Вставить("ИмяФормы", "");

	Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Неправильный формат внешнего файла.'");
		Возврат Результат;
	КонецЕсли;

	ТипФайла = ТипВнешнегоФайла(ИмяФайла);
	Если ТипФайла = Неопределено Тогда
		Результат.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Файл %1 не является внешней обработкой или внешним отчетом.'"),
			ИмяФайла);
		Возврат Результат;
	КонецЕсли;

	Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
	Результат.АдресВоВременномХранилище = Адрес;

	Попытка
		Если ТипФайла = "epf" Тогда
			ИмяОбъекта = ВнешниеОбработки.Подключить(Адрес, , БезопасныйРежим);
			Результат.ИмяФормы = "ВнешняяОбработка." + ИмяОбъекта + ".Форма";
		ИначеЕсли ТипФайла = "erf" Тогда
			ИмяОбъекта = ВнешниеОтчеты.Подключить(Адрес, , БезопасныйРежим);
			Результат.ИмяФормы = "ВнешнийОтчет." + ИмяОбъекта + ".Форма";
		КонецЕсли;
	Исключение
		Результат.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Результат.Успешно = Истина;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТипВнешнегоФайла(ИмяФайла)

	Расширение = НРег(Сред(ИмяФайла, СтрДлина(ИмяФайла) - 2));
	Если Расширение = "epf" Или Расширение = "erf" Тогда
		Возврат Расширение;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#КонецЕсли
