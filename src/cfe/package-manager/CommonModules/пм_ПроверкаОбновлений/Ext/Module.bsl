#Если Сервер Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Обработчик регламентного задания пм_ПроверкаОбновленийПакетов.
//
// Сначала отмечает наличие более новых версий. Если в настройках включено
// обновление по расписанию, ставит последнюю версию у пакетов с галкой
// автообновления. Сам менеджер пакетов фон не ставит.
// Расписание по умолчанию выключено.
//
Процедура ВыполнитьПроверкуПоРасписанию() Экспорт

	ОбщегоНазначенияЗарегистрироватьВыполнение();

	Результат = ПроверитьОбновления();

	Установлено = 0;
	ОшибокУстановки = 0;

	Если ОбновлятьОтмеченныеПоРасписанию() Тогда
		ИтогиУстановки = УстановитьОтмеченныеПакеты();
		Установлено = ИтогиУстановки.Установлено;
		ОшибокУстановки = ИтогиУстановки.Ошибок;
	КонецЕсли;

	ЗаписьЖурналаРегистрации(
		ИмяСобытияЖурнала(),
		УровеньЖурналаРегистрации.Информация,
		,
		,
		СтрШаблон(
			НСтр("ru = 'Проверено пакетов: %1. Доступно обновлений: %2. Источников с ошибкой: %3.
			|Установлено по расписанию: %4. Ошибок установки: %5.'"),
			Результат.ПровереноПакетов,
			Результат.ДоступноОбновлений,
			Результат.ИсточниковСОшибкой,
			Установлено,
			ОшибокУстановки));

КонецПроцедуры

// Проверяет наличие более новых версий для всех установленных пакетов.
//
// Параметры:
//  ИсточникПакетов - СправочникСсылка.пм_ИсточникиПакетов - Проверить только
//                    этот источник. Если не указан, проверяются все.
//
// Возвращаемое значение:
//  Структура - Итоги проверки:
// * ПровереноПакетов - Число
// * ДоступноОбновлений - Число
// * ИсточниковСОшибкой - Число
//
Функция ПроверитьОбновления(ИсточникПакетов = Неопределено) Экспорт

	Итоги = Новый Структура;
	Итоги.Вставить("ПровереноПакетов", 0);
	Итоги.Вставить("ДоступноОбновлений", 0);
	Итоги.Вставить("ИсточниковСОшибкой", 0);

	УстановитьПривилегированныйРежим(Истина);

	Сведения = РегистрыСведений.пм_УстановленныеПакеты.ВерсииПакетов(, ИсточникПакетов);

	// Пакеты сгруппированы по источникам: провайдер и идентификатор проекта
	// определяются один раз на источник, а не на каждый пакет.
	ПоИсточникам = Новый Соответствие;
	Для Каждого Строка Из Сведения Цикл
		Если Не ЗначениеЗаполнено(Строка.Источник) Или Не ЗначениеЗаполнено(Строка.Пакет) Тогда
			Продолжить;
		КонецЕсли;
		Если ПоИсточникам.Получить(Строка.Источник) = Неопределено Тогда
			ПоИсточникам.Вставить(Строка.Источник, Новый Массив);
		КонецЕсли;
		ПоИсточникам.Получить(Строка.Источник).Добавить(Строка);
	КонецЦикла;

	Для Каждого ЭлементСоответствия Из ПоИсточникам Цикл

		Попытка
			ПроверитьИсточник(ЭлементСоответствия.Ключ, ЭлементСоответствия.Значение, Итоги);
			Справочники.пм_ИсточникиПакетов.ЗапомнитьОшибку(ЭлементСоответствия.Ключ, "");
		Исключение
			Итоги.ИсточниковСОшибкой = Итоги.ИсточниковСОшибкой + 1;
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Справочники.пм_ИсточникиПакетов.ЗапомнитьОшибку(ЭлементСоответствия.Ключ, ТекстОшибки);
			ЗаписьЖурналаРегистрации(
				ИмяСобытияЖурнала(),
				УровеньЖурналаРегистрации.Ошибка,
				, ЭлементСоответствия.Ключ, ТекстОшибки);
		КонецПопытки;

	КонецЦикла;

	Возврат Итоги;

КонецФункции

// Ставит последнюю доступную версию у пакетов с галкой автообновления.
// Сам менеджер и пакеты без новой версии пропускаются.
//
Функция УстановитьОтмеченныеПакеты() Экспорт

	Итоги = Новый Структура("Установлено, Ошибок, Пропущено", 0, 0, 0);

	УстановитьПривилегированныйРежим(Истина);

	ПараметрыПакета = Новый Массив;

	Для Каждого Строка Из РегистрыСведений.пм_УстановленныеПакеты.ВерсииПакетов() Цикл

		Если Не ПакетДопускаетФоновуюУстановку(Строка) Тогда
			Итоги.Пропущено = Итоги.Пропущено + 1;
			Продолжить;
		КонецЕсли;

		ПараметрыЗагрузки = Обработки.пм_МенеджерПакетов.НовыеПараметрыЗагрузкиПакета();
		ПараметрыЗагрузки.Источник = Строка.Источник;
		ПараметрыЗагрузки.ИмяПакета = Строка.Пакет;
		ПараметрыЗагрузки.Версия = Строка.ДоступнаяВерсия;
		ПараметрыЗагрузки.ИмяФайла = "";
		ПараметрыЗагрузки.ТипРелиза = "";
		ПараметрыПакета.Добавить(ПараметрыЗагрузки);

	КонецЦикла;

	Если ПараметрыПакета.Количество() = 0 Тогда
		Возврат Итоги;
	КонецЕсли;

	Результаты = Обработки.пм_МенеджерПакетов.ЗагрузитьАктуальныеВерсииПакетов(ПараметрыПакета);

	Для Каждого Результат Из Результаты Цикл

		Если Результат.ЭтоСамообновление Или Результат.ТребуетсяПодтверждениеСамообновления Тогда
			Итоги.Пропущено = Итоги.Пропущено + 1;
			ЗаписьЖурналаРегистрации(
				ИмяСобытияЖурнала(),
				УровеньЖурналаРегистрации.Предупреждение,
				, Результат.Источник,
				НСтр("ru = 'Фон пропустил самообновление менеджера пакетов.'"));
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
			Итоги.Ошибок = Итоги.Ошибок + 1;
			ЗаписьЖурналаРегистрации(
				ИмяСобытияЖурнала(),
				УровеньЖурналаРегистрации.Ошибка,
				, Результат.Источник, Результат.ТекстОшибки);
		Иначе
			Итоги.Установлено = Итоги.Установлено + 1;
		КонецЕсли;

	КонецЦикла;

	Возврат Итоги;

КонецФункции

// Пакет можно ставить фоном: галка автообновления есть, это не менеджер,
// установлена старая версия и в источнике есть новее.
//
Функция ПакетДопускаетФоновуюУстановку(Сведения) Экспорт

	Если Сведения = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не Сведения.Автообновление Тогда
		Возврат Ложь;
	КонецЕсли;

	Если СтрСравнить(Сведения.Пакет, пм_МенеджерПакетовКлиентСервер.ИмяРасширенияМенеджера()) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Сведения.Версия) Или Не ЗначениеЗаполнено(Сведения.ДоступнаяВерсия) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат пм_ВерсииПакетов.СравнитьВерсии(Сведения.ДоступнаяВерсия, Сведения.Версия) > 0;

КонецФункции

Функция ОбновлятьОтмеченныеПоРасписанию() Экспорт

	Настройки = пм_ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		"Обработка.пм_МенеджерПакетов", "Настройки");

	Если ТипЗнч(Настройки) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;

	Значение = Настройки.Получить("ОбновлятьОтмеченныеПоРасписанию");
	Возврат Значение = Истина;

КонецФункции

Процедура УстановитьОбновлятьОтмеченныеПоРасписанию(Значение) Экспорт

	Настройки = пм_ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		"Обработка.пм_МенеджерПакетов", "Настройки");

	Если ТипЗнч(Настройки) <> Тип("Соответствие") Тогда
		Настройки = Новый Соответствие;
	КонецЕсли;

	Настройки.Вставить("ОбновлятьОтмеченныеПоРасписанию", Значение = Истина);
	пм_ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(
		"Обработка.пм_МенеджерПакетов", "Настройки", Настройки);

КонецПроцедуры

Функция ИмяСобытияЖурнала() Экспорт

	Возврат НСтр("ru = 'Менеджер пакетов.Проверка обновлений'");

КонецФункции

Функция РегламентноеЗаданиеМенеджера() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Отбор = Новый Структура("Метаданные",
		Метаданные.РегламентныеЗадания.пм_ПроверкаОбновленийПакетов);
	Найденные = РегламентныеЗадания.ПолучитьРегламентныеЗадания(Отбор);
	Если Найденные.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Найденные[0];

КонецФункции

Процедура ЗаписатьРасписаниеЗадания(Использование, Расписание) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Задание = РегламентноеЗаданиеМенеджера();
	Если Задание = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Задание.Использование = Использование;
	Если Расписание <> Неопределено Тогда
		Задание.Расписание = Расписание;
	КонецЕсли;
	Задание.Записать();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьИсточник(ИсточникСсылка, СтрокиПакетов, Итоги)

	Источник = Справочники.пм_ИсточникиПакетов.ОписаниеИсточника(ИсточникСсылка);

	Если Не пм_ПровайдерыПакетов.ПровайдерРеализован(Источник.Провайдер) Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Провайдер %1 пока не реализован.'"), Источник.Провайдер);
	КонецЕсли;

	Провайдер = пм_ПровайдерыПакетов.МодульПровайдера(Источник.Провайдер);

	Для Каждого СтрокаПакета Из СтрокиПакетов Цикл

		Итоги.ПровереноПакетов = Итоги.ПровереноПакетов + 1;

		Версии = Провайдер.ПолучитьВерсииПакета(Источник, СтрокаПакета.Пакет, "", 0);
		ДоступнаяВерсия = НаиболееНоваяВерсия(Версии);

		ЕстьОбновление = ЗначениеЗаполнено(ДоступнаяВерсия)
			И ЗначениеЗаполнено(СтрокаПакета.Версия)
			И пм_ВерсииПакетов.СравнитьВерсии(ДоступнаяВерсия, СтрокаПакета.Версия) > 0;

		Если ЕстьОбновление Тогда
			Итоги.ДоступноОбновлений = Итоги.ДоступноОбновлений + 1;
		КонецЕсли;

		ЗаписатьРезультатПроверки(СтрокаПакета, ДоступнаяВерсия);

	КонецЦикла;

КонецПроцедуры

Процедура ЗаписатьРезультатПроверки(СтрокаПакета, ДоступнаяВерсия)

	Сведения = РегистрыСведений.пм_УстановленныеПакеты.СтруктураЗаписи();
	ЗаполнитьЗначенияСвойств(Сведения, СтрокаПакета);
	Сведения.ДоступнаяВерсия = ДоступнаяВерсия;
	Сведения.ДатаПроверки = ТекущаяДатаСеанса();

	РегистрыСведений.пм_УстановленныеПакеты.ОбновитьСведения(Сведения);

КонецПроцедуры

Функция НаиболееНоваяВерсия(Версии)

	Наибольшая = "";

	Для Каждого Версия Из Версии Цикл
		Номер = Версия.Получить("version");
		Если Не ЗначениеЗаполнено(Наибольшая)
			Или пм_ВерсииПакетов.СравнитьВерсии(Номер, Наибольшая) > 0 Тогда
			Наибольшая = Номер;
		КонецЕсли;
	КонецЦикла;

	Возврат Наибольшая;

КонецФункции

// Регламентное задание расширения выполняется в контексте всех активных
// расширений. Отдельной регистрации БСП здесь не требуется, но если
// подсистема регламентных заданий доступна, отметимся в ней.
Процедура ОбщегоНазначенияЗарегистрироватьВыполнение()

	Если Метаданные.ОбщиеМодули.Найти("РегламентныеЗаданияСервер") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Модуль = пм_ОбщегоНазначения.ОбщийМодуль("РегламентныеЗаданияСервер");
	Если Модуль = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Модуль.ПриНачалеВыполненияРегламентногоЗадания();
	Исключение
		// Сигнатура метода в разных версиях БСП отличается: если вызвать
		// не удалось, проверку это не блокирует.
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурнала(),
			УровеньЖурналаРегистрации.Предупреждение,
			, , ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
