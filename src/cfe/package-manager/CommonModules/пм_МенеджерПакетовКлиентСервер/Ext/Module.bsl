#Область ПрограммныйИнтерфейс

// Имя расширения менеджера пакетов в информационной базе.
// Должно совпадать со свойством Name в Configuration.xml расширения:
// по нему определяется попытка обновить менеджер самим менеджером.
Функция ИмяРасширенияМенеджера() Экспорт

	Возврат "package-manager";

КонецФункции

// Имя package, под которым расширение с таким именем публикуется в реестре.
//
// Generic Package Registry у GitLab принимает только ASCII, поэтому пайплайн
// транслитерирует Name расширения. Менеджер повторяет то же правило, чтобы
// связать пакет реестра с расширением базы, не скачивая файл: обратное
// преобразование неоднозначно, прямое - нет.
//
// Алгоритм обязан совпадать с ИмяПакетаGitLab в макете
// пм_СкриптПубликацииGitLab: там он исполняется в CI, здесь - в базе,
// поэтому карта продублирована и правится в двух местах сразу.
// Символы, которых нет в карте и в разрешенных, отбрасываются.
//
// Параметры:
//  ИмяРасширения - Строка - Name расширения конфигурации.
//
// Возвращаемое значение:
//  Строка - Имя пакета, пустая строка если от имени ничего не осталось.
//
Функция ИмяПакетаПоИмениРасширения(Знач ИмяРасширения) Экспорт

	ИмяРасширения = СокрЛП(Строка(ИмяРасширения));
	Если Не ЗначениеЗаполнено(ИмяРасширения) Тогда
		Возврат "";
	КонецЕсли;

	Разрешенные = РазрешенныеСимволыИмениПакета();

	ТолькоРазрешенные = Истина;
	Для Индекс = 1 По СтрДлина(ИмяРасширения) Цикл
		Если СтрНайти(Разрешенные, Сред(ИмяРасширения, Индекс, 1)) = 0 Тогда
			ТолькоРазрешенные = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ТолькоРазрешенные Тогда
		Возврат ИмяРасширения;
	КонецЕсли;

	Карта = КартаТранслитерации();
	Части = Новый Массив;

	Для Индекс = 1 По СтрДлина(ИмяРасширения) Цикл

		Символ = Сред(ИмяРасширения, Индекс, 1);
		Замена = Карта[КодСимвола(Символ)];

		Если Замена <> Неопределено Тогда
			Части.Добавить(Замена);
		ИначеЕсли СтрНайти(Разрешенные, Символ) > 0 Тогда
			Части.Добавить(Символ);
		КонецЕсли;

	КонецЦикла;

	Возврат СтрСоединить(Части, "");

КонецФункции

// Приводит адрес сервера к виду без завершающего слеша.
// Схема не подставляется: провайдер должен получать ровно то,
// что ввел пользователь, иначе http-источник молча станет https.
//
// Параметры:
//  URL - Строка - Исходный адрес.
//
// Возвращаемое значение:
//  Строка - Нормализованный адрес.
//
Функция НормализованныйURL(Знач URL) Экспорт

	URL = СокрЛП(URL);

	Пока СтрДлина(URL) > 0 И Прав(URL, 1) = "/" Цикл
		URL = Лев(URL, СтрДлина(URL) - 1);
	КонецЦикла;

	Возврат URL;

КонецФункции

// Приводит путь проекта к виду group/project без обрамляющих слешей.
//
// Параметры:
//  Путь - Строка - Исходный путь проекта.
//
// Возвращаемое значение:
//  Строка - Нормализованный путь.
//
Функция НормализованныйПутьПроекта(Знач Путь) Экспорт

	Путь = СокрЛП(Путь);

	Пока СтрДлина(Путь) > 0 И Лев(Путь, 1) = "/" Цикл
		Путь = Сред(Путь, 2);
	КонецЦикла;

	Пока СтрДлина(Путь) > 0 И Прав(Путь, 1) = "/" Цикл
		Путь = Лев(Путь, СтрДлина(Путь) - 1);
	КонецЦикла;

	Возврат Путь;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазрешенныеСимволыИмениПакета()

	Возврат "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._~@+-";

КонецФункции

// Коды кириллицы и их латинские замены. Строчная буква дает замену
// в нижнем регистре: "Ж" - "Zh", "ж" - "zh". Мягкий и твердый знаки
// замены не имеют и отбрасываются - как и в скрипте публикации.
Функция КартаТранслитерации()

	Буквы = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЫЭЮЯ";
	Замены = "A,B,V,G,D,E,Yo,Zh,Z,I,Y,K,L,M,N,O,P,R,S,T,U,F,H,Ts,Ch,Sh,Sch,Y,E,Yu,Ya";

	СписокЗамен = СтрРазделить(Замены, ",");
	Карта = Новый Соответствие;

	Для Индекс = 1 По СтрДлина(Буквы) Цикл
		Буква = Сред(Буквы, Индекс, 1);
		Замена = СписокЗамен[Индекс - 1];
		Карта.Вставить(КодСимвола(Буква), Замена);
		Карта.Вставить(КодСимвола(НРег(Буква)), НРег(Замена));
	КонецЦикла;

	Возврат Карта;

КонецФункции

#КонецОбласти
