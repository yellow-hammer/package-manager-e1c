// Ставит платформу 1С с releases.1c.ru через yard.
//
// Версия не задается жестко: yard сначала отдает список доступных этой
// учетной записи версий, из него выбирается подходящая.
//
// Переменные среды:
//   ONEC_SERIES      - серия для поиска, регулярка. По умолчанию 8\.[35]
//   ONEC_MIN_VERSION - нижняя граница версии
//   ONEC_PICK        - oldest или newest, по умолчанию newest
//   ONEC_VERSION     - если нужна ровно одна версия
//
// Сборка поставляемого .cfe идет на минимальной платформе (oldest):
// собранный файл должен применяться в как можно большем числе баз.
// Тесты гоняются и на минимальной, и на новой.

// Вывод не перехватывается: он идет прямо в лог задания. Именно по нему
// видно, почему yard не отдал список версий или дистрибутив.
Функция КодКоманды(Команда)

	Процесс = СоздатьПроцесс(Команда);
	Процесс.Запустить();
	Процесс.ОжидатьЗавершения();

	Возврат Процесс.КодВозврата;

КонецФункции

Функция НайтиФайлыПоМаске(Каталог, Маска)

	Результат = Новый Массив;
	Корень = Новый Файл(Каталог);
	Если Не Корень.Существует() Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Файл Из НайтиФайлы(Каталог, Маска, Истина) Цикл
		Если Файл.ЭтоФайл() Тогда
			Результат.Добавить(Файл.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПервыйФайл(Каталог, Маска)

	Найденные = НайтиФайлыПоМаске(Каталог, Маска);
	Если Найденные.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Найденные[0];

КонецФункции

Процедура Дописать(ИмяПеременной, Строка)

	Путь = ПолучитьПеременнуюСреды(ИмяПеременной);
	Если Не ЗначениеЗаполнено(Путь) Тогда
		ВызватьИсключение "нет " + ИмяПеременной;
	КонецЕсли;

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8, , Истина);
	Запись.ЗаписатьСтроку(СтрЗаменить(Строка, Символы.ВК, ""));
	Запись.Закрыть();

КонецПроцедуры

// Первые три части версии: 8.3.23.1688 -> 8.3.23.
Функция МаскаВерсии(Версия)

	Части = СтрРазделить(Строка(Версия), ".", Ложь);
	Отобранные = Новый Массив;

	Для Каждого Часть Из Части Цикл
		Отобранные.Добавить(СокрЛП(Часть));
		Если Отобранные.Количество() >= 3 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Отобранные, ".");

КонецФункции

// Версия в виде сортируемого ключа: 8.3.9 младше 8.3.10.
Функция КлючВерсии(Версия)

	Ключ = "";
	Части = СтрРазделить(Строка(Версия), ".", Ложь);

	Для Индекс = 1 По 4 Цикл
		Часть = ?(Индекс <= Части.Количество(), СокрЛП(Части[Индекс - 1]), "0");
		Ключ = Ключ + Прав("000000" + Часть, 6);
	КонецЦикла;

	Возврат Ключ;

КонецФункции

// Серия платформы как регулярка: 8.2 по умолчанию не ищем,
// расширение к ней все равно не применяется.
Функция СерияПоиска()

	Значение = СокрЛП(Строка(ПолучитьПеременнуюСреды("ONEC_SERIES")));
	Если ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат "8\.[35]";

КонецФункции

Функция БратьСамуюСтарую()

	Возврат НРег(СокрЛП(Строка(ПолучитьПеременнуюСреды("ONEC_PICK")))) = "oldest";

КонецФункции

Функция ДоступныеВерсии(Yard)

	ПутьJson = ОбъединитьПути(КаталогВременныхФайлов(), "yard-releases.json");

	КодВозврата = КодКоманды(СтрШаблон(
		"timeout 900 oscript ""%1"" releases list --app-filter ""Технологическая платформа %3$"" --output-file ""%2""",
		Yard, ПутьJson, СерияПоиска()));

	Если КодВозврата <> 0 Или Не Новый Файл(ПутьJson).Существует() Тогда
		ВызватьИсключение СтрШаблон(
			"yard releases list не отработал, код %1. Проверьте ONEC_LOGIN и ONEC_PASSWORD",
			КодВозврата);
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ПутьJson);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Версии = Новый Массив;
	Для Каждого Приложение Из Данные Цикл
		СписокВерсий = Приложение.Получить("Версии");
		Если СписокВерсий = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ОписаниеВерсии Из СписокВерсий Цикл
			Если ОписаниеВерсии.Получить("Бета") = Истина Тогда
				Продолжить;
			КонецЕсли;
			Номер = ОписаниеВерсии.Получить("Версия");
			Если ЗначениеЗаполнено(Номер) И Версии.Найти(СокрЛП(Номер)) = Неопределено Тогда
				Версии.Добавить(СокрЛП(Номер));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Версии;

КонецФункции

// Версии не ниже минимума, в порядке предпочтения.
// Не у каждой версии есть дистрибутив для Linux, поэтому нужен запас
// кандидатов: берется первая, которая реально скачалась.
Функция Кандидаты(Yard)

	Минимальная = СокрЛП(Строка(ПолучитьПеременнуюСреды("ONEC_MIN_VERSION")));
	Желаемая = СокрЛП(Строка(ПолучитьПеременнуюСреды("ONEC_VERSION")));

	Доступные = ДоступныеВерсии(Yard);
	Если Доступные.Количество() = 0 Тогда
		ВызватьИсключение "releases.1c.ru не отдал ни одной версии платформы";
	КонецЕсли;

	Сообщить("Доступно версий: " + Доступные.Количество());

	Подходящие = Новый ТаблицаЗначений;
	Подходящие.Колонки.Добавить("Версия");
	Подходящие.Колонки.Добавить("Ключ");

	ПорогКлюч = ?(ЗначениеЗаполнено(Минимальная), КлючВерсии(Минимальная), "");
	Для Каждого Версия Из Доступные Цикл
		Если ЗначениеЗаполнено(Желаемая) И Версия <> Желаемая Тогда
			Продолжить;
		КонецЕсли;
		Ключ = КлючВерсии(Версия);
		Если Не ЗначениеЗаполнено(Желаемая) И ЗначениеЗаполнено(ПорогКлюч) И Ключ < ПорогКлюч Тогда
			Продолжить;
		КонецЕсли;
		Строка = Подходящие.Добавить();
		Строка.Версия = Версия;
		Строка.Ключ = Ключ;
	КонецЦикла;

	Если Подходящие.Количество() = 0 Тогда
		ВызватьИсключение ?(ЗначениеЗаполнено(Желаемая),
			"Версия " + Желаемая + " этой учетной записи недоступна",
			СтрШаблон("Нет доступной версии платформы серии %1 не ниже %2",
				СерияПоиска(), ?(ЗначениеЗаполнено(Минимальная), Минимальная, "любой")));
	КонецЕсли;

	Если БратьСамуюСтарую() Тогда
		Подходящие.Сортировать("Ключ Возр");
	Иначе
		Подходящие.Сортировать("Ключ Убыв");
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого Строка Из Подходящие Цикл
		Результат.Добавить(Строка.Версия);
		Если Результат.Количество() >= 6 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Сообщить("Кандидаты: " + СтрСоединить(Результат, ", "));

	Возврат Результат;

КонецФункции

Функция ЕстьДистрибутив(Каталог)

	Возврат ЗначениеЗаполнено(ПервыйФайл(Каталог, "setup-full*.run"))
		Или НайтиФайлыПоМаске(Каталог, "*.deb").Количество() > 0;

КонецФункции

Функция СкачатьДистрибутив(Yard, Версия, Каталог)

	Экранированная = СтрЗаменить(Версия, ".", "\.");
	Части = СтрРазделить(Версия, ".");
	// Регулярка, а не строка: точку экранируем, конец строки пишем как есть.
	// Обратный слеш перед $ нужен был bash, здесь он попал бы в регулярку
	// буквальным символом, и приложение не нашлось бы никогда.
	Серия = Части[0] + "\." + Части[1];

	// Полная платформа первой: тесты YAxUnit идут на тонком клиенте, а в
	// серверном .deb клиента нет, и vanessa-runner не находит платформу.
	// Серверный пакет остается запасным вариантом.
	Фильтры = Новый Массив;
	Фильтры.Добавить("Технологическая платформа.+\(64-bit\) для Linux$");
	Фильтры.Добавить("[CС]ервер.+\(64-bit\) для DEB-based Linux-систем$");

	Для Каждого Фильтр Из Фильтры Цикл
		КодКоманды(СтрШаблон(
			"timeout 900 oscript ""%1"" releases get --app-filter ""Технологическая платформа %2$"" --version-filter ""%3"" --distr-filter ""%4"" --path ""%5"" --download-limit 1 --extract",
			Yard, Серия, Экранированная, Фильтр, Каталог));
		Если ЕстьДистрибутив(Каталог) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Первая версия из кандидатов, у которой нашелся дистрибутив для Linux.
Функция СкачатьПервуюДоступную(Yard, СписокКандидатов, Каталог)

	Для Каждого Версия Из СписокКандидатов Цикл
		Сообщить("Пробую версию " + Версия);
		Если СкачатьДистрибутив(Yard, Версия, Каталог) Тогда
			Возврат Версия;
		КонецЕсли;
		Сообщить("Дистрибутива для Linux нет, беру следующую версию");
	КонецЦикла;

	Возврат "";

КонецФункции

Процедура Установить(Каталог)

	КодКоманды("sudo rm -rf /opt/1cv8 /opt/1C");

	Установщик = ПервыйФайл(Каталог, "setup-full*.run");
	Если ЗначениеЗаполнено(Установщик) Тогда
		КодКоманды("chmod +x """ + Установщик + """");
		Наборы = СтрРазделить("server,client_full,v8_install_deps|server,client_full", "|");
		Для Каждого Компоненты Из Наборы Цикл
			Если КодКоманды(СтрШаблон(
				"timeout 900 xvfb-run -a sudo ""%1"" --mode unattended --enable-components %2",
				Установщик, Компоненты)) = 0 Тогда
				Возврат;
			КонецЕсли;
			Сообщить("Набор компонентов [" + Компоненты + "] отклонен, пробую следующий");
		КонецЦикла;
		ВызватьИсключение "установщик .run не отработал";
	КонецЕсли;

	Пакеты = НайтиФайлыПоМаске(Каталог, "*.deb");
	Если Пакеты.Количество() = 0 Тогда
		ВызватьИсключение "ни .run, ни .deb";
	КонецЕсли;

	Если КодКоманды("sudo dpkg -i " + СтрСоединить(Пакеты, " ")) <> 0 Тогда
		Если КодКоманды("sudo apt-get install -f -y") <> 0 Тогда
			ВызватьИсключение "не установились .deb";
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция НайтиIbcmd()

	Кандидаты = Новый Массив;
	Для Каждого Каталог Из СтрРазделить("/opt/1cv8,/opt/1C", ",") Цикл
		Для Каждого Путь Из НайтиФайлыПоМаске(Каталог, "ibcmd") Цикл
			Кандидаты.Добавить(Путь);
		КонецЦикла;
	КонецЦикла;

	Лучший = "";
	Для Каждого Путь Из Кандидаты Цикл
		Если Путь > Лучший Тогда
			Лучший = Путь;
		КонецЕсли;
	КонецЦикла;

	Возврат Лучший;

КонецФункции

Функция БезХвостаКаталога(Путь)

	Результат = СокрП(СтрЗаменить(Строка(Путь), "\", "/"));
	Пока СтрЗаканчиваетсяНа(Результат, "/") Цикл
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// ibcmdrunner 0.3.3 всегда зовет ПутьКIBCMD("8.3") и ищет ibcmd в
// /opt/1C/v8.*/x86_64. Свежий установщик кладет бинарники в
// /opt/1cv8/x86_64/<версия>. Каталог целиком не линкуем: иначе v8find
// отдает /opt/1C/v8.3/x86_64/1cv8, а vanessa-runner вытаскивает версию
// regex `8.x.x.x` из пути и падает с «Неопределена версия платформы».
Процедура СсылкиIbcmd(Серия, КаталогBin)

	Корень = "/opt/1C/v" + Серия + "/x86_64";
	КодКоманды("sudo mkdir -p """ + Корень + """");

	Для Каждого Имя Из СтрРазделить("ibcmd,ibsrv", ",") Цикл
		Если Не ЗначениеЗаполнено(ПервыйФайл(КаталогBin, Имя)) Тогда
			Продолжить;
		КонецЕсли;
		КодКоманды("sudo ln -sfn """ + КаталогBin + "/" + Имя
			+ """ """ + Корень + "/" + Имя + """");
	КонецЦикла;

КонецПроцедуры

Процедура ПрокинутьДляV8Find(КаталогBin, Версия)

	КодКоманды("sudo rm -rf /opt/1C/v8.3 /opt/1C/v8.5");
	СсылкиIbcmd("8.3", КаталогBin);

	Части = СтрРазделить(Строка(Версия), ".", Ложь);
	Если Части.Количество() >= 2 Тогда
		Серия = СокрЛП(Части[0]) + "." + СокрЛП(Части[1]);
		Если Серия <> "8.3" Тогда
			СсылкиIbcmd(Серия, КаталогBin);
		КонецЕсли;
	КонецЕсли;

	Тонкий = ПервыйФайл(КаталогBin, "1cv8c");
	Если Не ЗначениеЗаполнено(Тонкий) Тогда
		ВызватьИсключение "в платформе нет тонкого клиента 1cv8c, тесты не пойдут";
	КонецЕсли;

	// vrunner run ищет 1cv8 (не 1cv8c). В серверном каталоге толстого
	// клиента может не быть - тогда ПутьКПредприятию пустой.
	Если Не ЗначениеЗаполнено(ПервыйФайл(КаталогBin, "1cv8")) Тогда
		КодКоманды("sudo ln -sfn """ + Тонкий + """ """ + КаталогBin + "/1cv8""");
	КонецЕсли;

	Сообщить("v8find: ibcmd -> /opt/1C/v8.3/x86_64, 1cv8 -> " + КаталогBin);

КонецПроцедуры

Yard = ПолучитьПеременнуюСреды("YARD_OS");
Если Не ЗначениеЗаполнено(Yard) Тогда
	ВызватьИсключение "нужна переменная YARD_OS";
КонецЕсли;

СписокКандидатов = Кандидаты(Yard);

КаталогДистрибутива = ОбъединитьПути(КаталогВременныхФайлов(), "onec-distr");
СоздатьКаталог(КаталогДистрибутива);
КодКоманды("chmod 777 """ + КаталогДистрибутива + """");

Версия = СкачатьПервуюДоступную(Yard, СписокКандидатов, КаталогДистрибутива);
Если Не ЗначениеЗаполнено(Версия) Тогда
	ВызватьИсключение "Ни одна версия не скачалась: " + СтрСоединить(СписокКандидатов, ", ");
КонецЕсли;

Сообщить("Версия платформы: " + Версия);

Установить(КаталогДистрибутива);

Ibcmd = НайтиIbcmd();
Если Не ЗначениеЗаполнено(Ibcmd) Тогда
	ВызватьИсключение "ibcmd не найден после установки";
КонецЕсли;

КаталогBin = БезХвостаКаталога(Новый Файл(Ibcmd).Путь);
ПрокинутьДляV8Find(КаталогBin, Версия);

Дописать("GITHUB_ENV", "IBCMD=" + Ibcmd);
Дописать("GITHUB_ENV", "ONEC_BIN=" + КаталогBin);
Дописать("GITHUB_ENV", "ONEC_VERSION_USED=" + Версия);

// vanessa-runner ждет маску из трех частей: с четырьмя он не находит
// каталог платформы и запускает пустую команду. Сборка в каталоге одна,
// так что маска однозначна.
Дописать("GITHUB_ENV", "ONEC_VERSION_MASK=" + МаскаВерсии(Версия));

Сообщить("Платформа: " + Ibcmd);
