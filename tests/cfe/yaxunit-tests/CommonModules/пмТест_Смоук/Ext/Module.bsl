// Дымовые тесты расширения package-manager.
//
// Проверяют целостность решения средствами платформы: объекты на месте,
// состав подсистемы полон, роли раздают права, регламентное задание заведено
// и выключено. Это то, что раньше проверялось внешним скриптом по XML,
// а теперь спрашивается у самой платформы - источник достовернее.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьСерверныйТест("ОбъектыРешенияНаМесте")
		.ДобавитьСерверныйТест("ОбщиеМодулиРешенияДоступны")
		.ДобавитьСерверныйТест("ВсеОбъектыВключеныВПодсистему")
		.ДобавитьСерверныйТест("РолиРаздаютПрава")
		.ДобавитьСерверныйТест("РегламентноеЗаданиеЗаведеноИВыключено")
		.ДобавитьСерверныйТест("МакетыШаблоновПубликацииНаМесте")
		.ДобавитьСерверныйТест("РасширениеПрименено");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ОбъектыРешенияНаМесте() Экспорт

	ЮТест.ОжидаетЧто(Метаданные.Справочники.Найти("пм_ИсточникиПакетов") <> Неопределено,
		"справочник источников").Равно(Истина);

	ЮТест.ОжидаетЧто(Метаданные.Перечисления.Найти("пм_Провайдеры") <> Неопределено,
		"перечисление провайдеров").Равно(Истина);

	ЮТест.ОжидаетЧто(Метаданные.РегистрыСведений.Найти("пм_УстановленныеПакеты") <> Неопределено,
		"регистр установленных пакетов").Равно(Истина);

	ЮТест.ОжидаетЧто(Метаданные.Обработки.Найти("пм_МенеджерПакетов") <> Неопределено,
		"основная обработка").Равно(Истина);

	ЮТест.ОжидаетЧто(Метаданные.Обработки.Найти("пм_ГенераторШаблоновПубликации") <> Неопределено,
		"генератор шаблонов").Равно(Истина);

КонецПроцедуры

Процедура ОбщиеМодулиРешенияДоступны() Экспорт

	// Отсутствие модуля здесь означает, что объект пропал из
	// Configuration.xml и молча выпал из расширения.
	Модули = СтрРазделить(
		"пм_МенеджерПакетов,пм_МенеджерПакетовКлиентСервер,пм_ВерсииПакетов,"
		+ "пм_ПровайдерыПакетов,пм_ПровайдерGitLab,пм_ПровайдерGitHub,пм_ПроверкаОбновлений,"
		+ "пм_УстановщикРасширений,пм_УстановщикВнешнихФайлов,пм_ШаблоныПубликацииПакетов",
		",");

	Для Каждого ИмяМодуля Из Модули Цикл
		ЮТест.ОжидаетЧто(Метаданные.ОбщиеМодули.Найти(ИмяМодуля) <> Неопределено,
			"общий модуль " + ИмяМодуля).Равно(Истина);
	КонецЦикла;

КонецПроцедуры

Процедура ВсеОбъектыВключеныВПодсистему() Экспорт

	Подсистема = Метаданные.Подсистемы.Найти("пм_МенеджерПакетов");
	ЮТест.ОжидаетЧто(Подсистема <> Неопределено, "подсистема существует").Равно(Истина);

	Состав = Новый Соответствие;
	Для Каждого Объект Из Подсистема.Состав Цикл
		Состав.Вставить(Объект.ПолноеИмя(), Истина);
	КонецЦикла;

	// Объект вне подсистемы не попадает в командный интерфейс и в права,
	// поэтому проверяется каждый значимый для пользователя объект.
	Ожидаемые = СтрРазделить(
		"Справочник.пм_ИсточникиПакетов,Перечисление.пм_Провайдеры,"
		+ "РегистрСведений.пм_УстановленныеПакеты,Обработка.пм_МенеджерПакетов,"
		+ "Обработка.пм_ГенераторШаблоновПубликации,"
		+ "РегламентноеЗадание.пм_ПроверкаОбновленийПакетов",
		",");

	Для Каждого ПолноеИмя Из Ожидаемые Цикл
		ЮТест.ОжидаетЧто(Состав.Получить(ПолноеИмя) <> Неопределено,
			ПолноеИмя + " включен в подсистему").Равно(Истина);
	КонецЦикла;

КонецПроцедуры

Процедура РолиРаздаютПрава() Экспорт

	Справочник = Метаданные.Справочники.пм_ИсточникиПакетов;
	Регистр = Метаданные.РегистрыСведений.пм_УстановленныеПакеты;

	Работа = Метаданные.Роли.Найти("пм_РаботаСМенеджеромПакетов");
	ЮТест.ОжидаетЧто(Работа <> Неопределено, "роль работы с менеджером").Равно(Истина);

	// Пустая роль - типичная ошибка: объект есть, а работать под ней нельзя.
	ЮТест.ОжидаетЧто(ПравоДоступа("Чтение", Справочник, Работа),
		"роль работы дает чтение источников").Равно(Истина);
	ЮТест.ОжидаетЧто(ПравоДоступа("Изменение", Регистр, Работа),
		"роль работы дает изменение регистра").Равно(Истина);

	Чтение = Метаданные.Роли.Найти("пм_ЧтениеИсточниковПакетов");
	ЮТест.ОжидаетЧто(Чтение <> Неопределено, "роль чтения источников").Равно(Истина);
	ЮТест.ОжидаетЧто(ПравоДоступа("Чтение", Справочник, Чтение),
		"роль чтения дает чтение").Равно(Истина);
	ЮТест.ОжидаетЧто(ПравоДоступа("Изменение", Справочник, Чтение),
		"роль чтения не дает изменение").Равно(Ложь);

	Изменение = Метаданные.Роли.Найти("пм_ДобавлениеИзменениеИсточниковПакетов");
	ЮТест.ОжидаетЧто(Изменение <> Неопределено, "роль изменения источников").Равно(Истина);
	ЮТест.ОжидаетЧто(ПравоДоступа("Изменение", Справочник, Изменение),
		"роль изменения дает изменение").Равно(Истина);

	// Интерактивное удаление не выдается ни одной ролью: источники
	// помечаются на удаление, а не удаляются сразу.
	ЮТест.ОжидаетЧто(ПравоДоступа("ИнтерактивноеУдаление", Справочник, Изменение),
		"интерактивное удаление не выдано").Равно(Ложь);

КонецПроцедуры
	// В метаданных путь пишется как CommonModule.<Модуль>.<Метод>,
	// а платформа отдает его уже без префикса вида объекта.

Процедура РегламентноеЗаданиеЗаведеноИВыключено() Экспорт

	Задание = Метаданные.РегламентныеЗадания.Найти("пм_ПроверкаОбновленийПакетов");
	ЮТест.ОжидаетЧто(Задание <> Неопределено, "регламентное задание заведено").Равно(Истина);

	// В метаданных путь пишется как CommonModule.<Модуль>.<Метод>,
	// а платформа отдает его уже без префикса вида объекта.
	ЮТест.ОжидаетЧто(Задание.ИмяМетода,
		"обработчик задания").Равно("пм_ПроверкаОбновлений.ВыполнитьПроверкуПоРасписанию");

	// По умолчанию задание выключено: фоновая проверка включается
	// администратором осознанно.
	ЮТест.ОжидаетЧто(Задание.Использование,
		"расписание выключено по умолчанию").Равно(Ложь);

КонецПроцедуры

Процедура МакетыШаблоновПубликацииНаМесте() Экспорт

	Макеты = СтрРазделить(
		"пм_ШаблонПубликацииGitLab,пм_ШаблонПубликацииJenkins,"
		+ "пм_ШаблонПубликацииGitHub,пм_СкриптПубликацииGitLab", ",");

	Для Каждого ИмяМакета Из Макеты Цикл
		ЮТест.ОжидаетЧто(Метаданные.ОбщиеМакеты.Найти(ИмяМакета) <> Неопределено,
			"макет " + ИмяМакета).Равно(Истина);

		ЮТест.ОжидаетЧто(ПолучитьОбщийМакет(ИмяМакета).ПолучитьТекст(),
			"текст макета " + ИмяМакета).Заполнено();
	КонецЦикла;

КонецПроцедуры

Процедура РасширениеПрименено() Экспорт

	ИмяРасширения = пм_МенеджерПакетовКлиентСервер.ИмяРасширенияМенеджера();

	Найдено = Ложь;
	Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
		Если Расширение.Имя = ИмяРасширения Тогда
			Найдено = Расширение.Активно;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	ЮТест.ОжидаетЧто(Найдено,
		"расширение " + ИмяРасширения + " применено и активно").Равно(Истина);

КонецПроцедуры

#КонецОбласти
