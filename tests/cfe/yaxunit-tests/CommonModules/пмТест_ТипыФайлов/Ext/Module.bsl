// Тесты определения типа файла пакета, выбора установщика и кодирования
// пути проекта. Проверяются общие модули пм_МенеджерПакетов,
// пм_ПровайдерыПакетов и пм_УстановщикРасширений.
//
// Модуль серверный: оба проверяемых модуля серверные, и на клиенте
// обращение к ним не скомпилировалось бы.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьСерверныйТест("ТипФайлаОпределяетсяПоРасширению")
		.ДобавитьСерверныйТест("ТипФайлаНеЗависитОтРегистра")
		.ДобавитьСерверныйТест("НеизвестныйТипФайлаПустой")
		.ДобавитьСерверныйТест("ПоддерживаемыеТипыФайлов")
		.ДобавитьСерверныйТест("КодированиеПутиПроекта")
		.ДобавитьСерверныйТест("ФайлВерсииВыбираетсяПоИмениИзКаталога")
		.ДобавитьСерверныйТест("ФайлВерсииВыбираетсяПоИмениПакета")
		.ДобавитьСерверныйТест("ИмяПакетаИзИмениФайла")
		.ДобавитьСерверныйТест("ФайлВерсииБезИмениТолькоОдин")
		.ДобавитьСерверныйТест("НесколькоФайловБезИмениНеВыбираются")
		.ДобавитьСерверныйТест("СопроводительныйФайлВерсииНеМешаетВыбору")
		.ДобавитьСерверныйТест("ФайлВерсииВыбираетEpfСредиСопроводительных")
		.ДобавитьСерверныйТест("НеподдерживаемыйФайлПакетаНеУстанавливается")
		.ДобавитьСерверныйТест("РезультатУстановкиРасширенияСодержитЗамечания");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ТипФайлаОпределяетсяПоРасширению() Экспорт

	ЮТест.ОжидаетЧто(пм_МенеджерПакетов.ТипФайлаПакета("solution.cfe"),
		"расширение конфигурации").Равно("cfe");

	ЮТест.ОжидаетЧто(пм_МенеджерПакетов.ТипФайлаПакета("report.epf"),
		"внешняя обработка").Равно("epf");

	ЮТест.ОжидаетЧто(пм_МенеджерПакетов.ТипФайлаПакета("analytics.erf"),
		"внешний отчет").Равно("erf");

КонецПроцедуры

Процедура ТипФайлаНеЗависитОтРегистра() Экспорт

	ЮТест.ОжидаетЧто(пм_МенеджерПакетов.ТипФайлаПакета("SOLUTION.CFE"),
		"верхний регистр").Равно("cfe");

	ЮТест.ОжидаетЧто(пм_МенеджерПакетов.ТипФайлаПакета("  solution.Cfe  "),
		"смешанный регистр и пробелы").Равно("cfe");

КонецПроцедуры

Процедура НеизвестныйТипФайлаПустой() Экспорт

	ЮТест.ОжидаетЧто(пм_МенеджерПакетов.ТипФайлаПакета("readme.md"),
		"неподдерживаемое расширение").Равно("");

	ЮТест.ОжидаетЧто(пм_МенеджерПакетов.ТипФайлаПакета("archive.zip"),
		"архив").Равно("");

	ЮТест.ОжидаетЧто(пм_МенеджерПакетов.ТипФайлаПакета(""),
		"пустое имя").Равно("");

	// Имя без расширения, но с подстрокой cfe внутри, типом не считается.
	ЮТест.ОжидаетЧто(пм_МенеджерПакетов.ТипФайлаПакета("cfe-builder"),
		"подстрока не расширение").Равно("");

КонецПроцедуры

Процедура ПоддерживаемыеТипыФайлов() Экспорт

	Типы = пм_МенеджерПакетов.ПоддерживаемыеТипыФайлов();

	ЮТест.ОжидаетЧто(Типы.Количество(), "поддерживается три типа файлов").Равно(3);

	// Найти возвращает индекс, а у первого элемента он равен нулю,
	// поэтому проверяется именно отличие от Неопределено.
	ЮТест.ОжидаетЧто(Типы.Найти(пм_МенеджерПакетов.ТипФайлаРасширение()) <> Неопределено,
		"cfe в списке").Равно(Истина);
	ЮТест.ОжидаетЧто(Типы.Найти(пм_МенеджерПакетов.ТипФайлаОбработка()) <> Неопределено,
		"epf в списке").Равно(Истина);
	ЮТест.ОжидаетЧто(Типы.Найти(пм_МенеджерПакетов.ТипФайлаОтчет()) <> Неопределено,
		"erf в списке").Равно(Истина);

КонецПроцедуры

Процедура КодированиеПутиПроекта() Экспорт

	// Путь подставляется в адрес API одним сегментом, поэтому слеши
	// должны быть закодированы. Функция живет в серверном модуле:
	// КодироватьСтроку на тонком клиенте недоступна.
	Кодированный = пм_ПровайдерыПакетов.КодированныйПутьПроекта("group/project");

	ЮТест.ОжидаетЧто(СтрНайти(Кодированный, "/"),
		"слешей в кодированном пути нет").Равно(0);

	ЮТест.ОжидаетЧто(Кодированный, "путь закодирован").Заполнено();

	// Нормализация выполняется до кодирования.
	ЮТест.ОжидаетЧто(пм_ПровайдерыПакетов.КодированныйПутьПроекта("/group/project/"),
		"обрамляющие слеши убраны до кодирования").Равно(Кодированный);

КонецПроцедуры

Процедура ФайлВерсииВыбираетсяПоИмениИзКаталога() Экспорт

	Файлы = Новый Массив;
	Файлы.Добавить(ОписаниеФайлаВерсии("_ДемоПустоеРасширение.cfe"));
	Файлы.Добавить(ОписаниеФайлаВерсии("_ДемоРасширение.cfe"));

	Выбранный = пм_МенеджерПакетов.ВыбратьФайлВерсии(Файлы, "_ДемоПустоеРасширение.cfe");

	ЮТест.ОжидаетЧто(Выбранный, "файл выбран по file_name").Заполнено();
	ЮТест.ОжидаетЧто(Выбранный.Получить("file_name"),
		"выбран указанный файл").Равно("_ДемоПустоеРасширение.cfe");

КонецПроцедуры

Процедура ФайлВерсииВыбираетсяПоИмениПакета() Экспорт

	Файлы = Новый Массив;
	Файлы.Добавить(ОписаниеФайлаВерсии("alpha.cfe"));
	Файлы.Добавить(ОписаниеФайлаВерсии("beta.epf"));

	Выбранный = пм_МенеджерПакетов.ВыбратьФайлВерсии(Файлы, "alpha");

	ЮТест.ОжидаетЧто(Выбранный, "файл выбран по имени пакета").Заполнено();
	ЮТест.ОжидаетЧто(Выбранный.Получить("file_name"),
		"выбран файл с этим именем без расширения").Равно("alpha.cfe");

КонецПроцедуры

Процедура ИмяПакетаИзИмениФайла() Экспорт

	ЮТест.ОжидаетЧто(пм_МенеджерПакетов.ИмяПакетаИзИмениФайла("solution.cfe"),
		"имя из cfe").Равно("solution");

	ЮТест.ОжидаетЧто(пм_МенеджерПакетов.ИмяПакетаИзИмениФайла("report.EPF"),
		"регистр расширения не важен").Равно("report");

	ЮТест.ОжидаетЧто(пм_МенеджерПакетов.ИмяПакетаИзИмениФайла("readme.md"),
		"неподдерживаемый тип").Равно("");

КонецПроцедуры

Процедура ФайлВерсииБезИмениТолькоОдин() Экспорт

	Файлы = Новый Массив;
	Файлы.Добавить(ОписаниеФайлаВерсии("_ДемоПустоеРасширение.cfe"));

	Выбранный = пм_МенеджерПакетов.ВыбратьФайлВерсии(Файлы, "");

	ЮТест.ОжидаетЧто(Выбранный.Получить("file_name"),
		"единственный файл берется без file_name").Равно("_ДемоПустоеРасширение.cfe");

КонецПроцедуры

Процедура НесколькоФайловБезИмениНеВыбираются() Экспорт

	Файлы = Новый Массив;
	Файлы.Добавить(ОписаниеФайлаВерсии("_ДемоПустоеРасширение.cfe"));
	Файлы.Добавить(ОписаниеФайлаВерсии("_ДемоРасширение.cfe"));

	ЮТест.ОжидаетЧто(пм_МенеджерПакетов.ВыбратьФайлВерсии(Файлы, ""),
		"без file_name несколько файлов неоднозначны").Равно(Неопределено);

КонецПроцедуры

Процедура СопроводительныйФайлВерсииНеМешаетВыбору() Экспорт

	Файлы = Новый Массив;
	Файлы.Добавить(ОписаниеФайлаВерсии("solution.cfe"));
	Файлы.Добавить(ОписаниеФайлаВерсии("solution.srcsha"));

	Выбранный = пм_МенеджерПакетов.ВыбратьФайлВерсии(Файлы, "");

	ЮТест.ОжидаетЧто(Выбранный, "устанавливаемый файл один").Заполнено();
	ЮТест.ОжидаетЧто(Выбранный.Получить("file_name"),
		".srcsha не считается файлом пакета").Равно("solution.cfe");

КонецПроцедуры

Процедура ФайлВерсииВыбираетEpfСредиСопроводительных() Экспорт

	Файлы = Новый Массив;
	Файлы.Добавить(ОписаниеФайлаВерсии("report.srcsha"));
	Файлы.Добавить(ОписаниеФайлаВерсии("report.epf"));

	Выбранный = пм_МенеджерПакетов.ВыбратьФайлВерсии(Файлы, "");

	ЮТест.ОжидаетЧто(Выбранный.Получить("file_name"),
		"единственная обработка среди сопроводительных").Равно("report.epf");

КонецПроцедуры

// Установщик выбирается по типу файла. Неизвестный тип не доходит
// ни до расширений, ни до внешних файлов.
Процедура НеподдерживаемыйФайлПакетаНеУстанавливается() Экспорт

	Результат = пм_МенеджерПакетов.УстановитьФайлПакета(
		ПолучитьДвоичныеДанныеИзСтроки("не пакет"), "readme.md");

	ЮТест.ОжидаетЧто(Результат.Успешно, "неизвестный тип не устанавливается").Равно(Ложь);
	ЮТест.ОжидаетЧто(Результат.ТекстОшибки, "текст ошибки заполнен").Заполнено();
	ЮТест.ОжидаетЧто(Результат.ТребуетсяПерезапуск, "перезапуск не нужен").Равно(Ложь);

КонецПроцедуры

// Замечания проверки применимости идут отдельно от текста ошибки:
// установку они не отменяют.
Процедура РезультатУстановкиРасширенияСодержитЗамечания() Экспорт

	Результат = пм_УстановщикРасширений.НовыйРезультатУстановки();

	Для Каждого ИмяПоля Из СтрРазделить("Успешно,ТекстОшибки,ТребуетсяПерезапуск,Замечания", ",") Цикл
		ЮТест.ОжидаетЧто(Результат.Свойство(ИмяПоля),
			"результат установки содержит поле " + ИмяПоля).Равно(Истина);
	КонецЦикла;

	ЮТест.ОжидаетЧто(пм_УстановщикРасширений.УстановитьИзДвоичныхДанных("не двоичные данные").Успешно,
		"не двоичные данные не устанавливаются").Равно(Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОписаниеФайлаВерсии(ИмяФайла)

	Файл = Новый Соответствие;
	Файл.Вставить("file_name", ИмяФайла);

	Возврат Файл;

КонецФункции

#КонецОбласти
