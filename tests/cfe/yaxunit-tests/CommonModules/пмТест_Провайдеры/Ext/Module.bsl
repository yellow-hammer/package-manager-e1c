Процедура ПояснениеGitHubЛимитБезТокена() Экспорт

	Источник = Справочники.пм_ИсточникиПакетов.НовоеОписаниеИсточника();
	Ответ = ОтветПровайдера(403);
	Ответ.Заголовки.Вставить("X-RateLimit-Remaining", "0");

	Пояснение = пм_ПровайдерGitHub.ПояснениеОшибкиОтвета(Источник, Ответ);

	ЮТест.ОжидаетЧто(СтрНайти(НРег(Пояснение), "лимит") > 0,
		"403 с нулевым remaining - это лимит").Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(НРег(Пояснение), "приват") > 0,
		"лимит не называется приватным репозиторием").Равно(Ложь);
	ЮТест.ОжидаетЧто(СтрНайти(НРег(Пояснение), "токен") > 0,
		"без токена советуем его указать").Равно(Истина);

