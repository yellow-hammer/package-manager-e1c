Процедура АдресСкачиванияGitHubНеРазбираетПодпись() Экспорт

	Адрес = "https://release-assets.githubusercontent.com/github-production-release-asset/"
		+ "123/456?X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Credential=AKIA%2F20260825"
		+ "&response-content-disposition=attachment%3B%20filename%3Dprometheus_client.cfe";

	Состав = пм_ПровайдерGitHub.РазобратьАдресСкачивания(Адрес);

	ЮТест.ОжидаетЧто(Состав.Хост, "хост CDN").Равно("release-assets.githubusercontent.com");
	ЮТест.ОжидаетЧто(Состав.Порт, "порт https").Равно(443);
	ЮТест.ОжидаетЧто(Состав.Защищенное, "https").Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(Состав.Ресурс, "X-Amz-Algorithm=AWS4-HMAC-SHA256") > 0,
		"ключ с дефисом остается в query").Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(Состав.Ресурс, "AKIA%2F20260825") > 0,
		"кодировка подписи не меняется").Равно(Истина);

	Относительный = пм_ПровайдерGitHub.РазобратьАдресСкачивания(
		"//cdn.example.com/file.cfe?X-Amz-Date=20260825T120000Z");

	ЮТест.ОжидаетЧто(Относительный.Хост, "схема подставляется").Равно("cdn.example.com");
	ЮТест.ОжидаетЧто(СтрНайти(Относительный.Ресурс, "X-Amz-Date=20260825T120000Z") > 0,
		"query относительного адреса сохраняется").Равно(Истина);

