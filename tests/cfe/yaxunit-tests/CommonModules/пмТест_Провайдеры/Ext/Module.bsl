Процедура МодульПровайдераВозвращаетсяДляGitHub() Экспорт

	Провайдер = пм_ПровайдерыПакетов.МодульПровайдера(Перечисления.пм_Провайдеры.GitHub);
	ПроверитьКонтрактБезСети(Провайдер, "https://github.com");

	Источник = Справочники.пм_ИсточникиПакетов.НовоеОписаниеИсточника();
	Источник.URLСервера = "https://github.com";
	Источник.ПутьПроекта = "owner/repo/extra";

	Результат = Провайдер.ПроверитьИсточник(Источник);

	ЮТест.ОжидаетЧто(Результат.Успешно,
		"путь длиннее owner/repo не проходит проверку").Равно(Ложь);
	ЮТест.ОжидаетЧто(Результат.ТекстОшибки, "текст ошибки заполнен").Заполнено();

