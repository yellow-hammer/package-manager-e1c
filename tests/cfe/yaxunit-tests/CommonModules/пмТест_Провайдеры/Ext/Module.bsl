Процедура ВерсииПакетаИзРелизовGitHub() Экспорт

	Релизы = Новый Массив;
	Релизы.Добавить(РелизGitHub(10, "v1.2.0", Ложь, "alpha.cfe"));
	Релизы.Добавить(РелизGitHub(11, "v1.2.0-rc1", Ложь, "alpha.cfe"));
	Релизы.Добавить(РелизGitHub(12, "v1.1.0", Ложь, "beta.epf"));
	Релизы.Добавить(РелизGitHub(13, "v0.9.0", Истина, "alpha.cfe"));

	Версии = пм_ПровайдерGitHub.ВерсииПакетаИзРелизов(
		Релизы, "alpha", пм_ВерсииПакетов.ТипРелизаСтабильный(), 0);

	ЮТест.ОжидаетЧто(Версии.Количество(), "только стабильные alpha").Равно(1);
	ЮТест.ОжидаетЧто(Версии[0].Получить("version"), "версия без v").Равно("1.2.0");
	ЮТест.ОжидаетЧто(Версии[0].Получить("id"), "id релиза").Равно(10);
	ЮТест.ОжидаетЧто(Версии[0].Получить("file_name"),
		"имя файла уже известно из ассета").Равно("alpha.cfe");

	Файлы = пм_ПровайдерGitHub.ФайлыРелиза(Релизы[0]);
	ЮТест.ОжидаетЧто(Файлы.Количество(), "файлы релиза").Равно(1);
	ЮТест.ОжидаетЧто(Файлы[0].Получить("file_name"), "имя ассета").Равно("alpha.cfe");

