// Тесты клиент-серверных хелперов адреса источника.
// Проверяется общий модуль пм_МенеджерПакетовКлиентСервер.
//
// Каждый тест зарегистрирован дважды: на сервере и на клиенте. Это не
// дублирование ради полноты - модуль объявлен клиент-серверным, значит
// компилируется в обоих контекстах, и серверное имя внутри него ломает
// только клиентскую компиляцию. Серверный прогон такую ошибку не видит.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьСерверныйТест("НормализацияURLУбираетХвостовойСлеш")
		.ДобавитьКлиентскийТест("НормализацияURLУбираетХвостовойСлеш")
		.ДобавитьСерверныйТест("НормализацияURLНеМеняетСхему")
		.ДобавитьКлиентскийТест("НормализацияURLНеМеняетСхему")
		.ДобавитьСерверныйТест("НормализацияПутиПроекта")
		.ДобавитьКлиентскийТест("НормализацияПутиПроекта")
		.ДобавитьСерверныйТест("ЗначенияПоУмолчанию")
		.ДобавитьКлиентскийТест("ЗначенияПоУмолчанию");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура НормализацияURLУбираетХвостовойСлеш() Экспорт

	ЮТест.ОжидаетЧто(
		пм_МенеджерПакетовКлиентСервер.НормализованныйURL("https://gitlab.example.com/"),
		"один слеш").Равно("https://gitlab.example.com");

	ЮТест.ОжидаетЧто(
		пм_МенеджерПакетовКлиентСервер.НормализованныйURL("https://gitlab.example.com///"),
		"несколько слешей").Равно("https://gitlab.example.com");

	ЮТест.ОжидаетЧто(
		пм_МенеджерПакетовКлиентСервер.НормализованныйURL("  https://gitlab.example.com  "),
		"обрамляющие пробелы").Равно("https://gitlab.example.com");

	ЮТест.ОжидаетЧто(
		пм_МенеджерПакетовКлиентСервер.НормализованныйURL(""),
		"пустая строка").Равно("");

КонецПроцедуры

Процедура НормализацияURLНеМеняетСхему() Экспорт

	// Схема не подставляется намеренно: иначе http-источник молча стал бы https.
	ЮТест.ОжидаетЧто(
		пм_МенеджерПакетовКлиентСервер.НормализованныйURL("http://gitlab.local"),
		"http сохраняется").Равно("http://gitlab.local");

	ЮТест.ОжидаетЧто(
		пм_МенеджерПакетовКлиентСервер.НормализованныйURL("gitlab.local"),
		"адрес без схемы не дополняется").Равно("gitlab.local");

КонецПроцедуры

Процедура НормализацияПутиПроекта() Экспорт

	ЮТест.ОжидаетЧто(
		пм_МенеджерПакетовКлиентСервер.НормализованныйПутьПроекта("/group/project/"),
		"обрамляющие слеши").Равно("group/project");

	ЮТест.ОжидаетЧто(
		пм_МенеджерПакетовКлиентСервер.НормализованныйПутьПроекта("group/subgroup/project"),
		"вложенная группа сохраняется").Равно("group/subgroup/project");

	ЮТест.ОжидаетЧто(
		пм_МенеджерПакетовКлиентСервер.НормализованныйПутьПроекта("  group/project  "),
		"обрамляющие пробелы").Равно("group/project");

	ЮТест.ОжидаетЧто(
		пм_МенеджерПакетовКлиентСервер.НормализованныйПутьПроекта(""),
		"пустая строка").Равно("");

КонецПроцедуры

Процедура ЗначенияПоУмолчанию() Экспорт

	ЮТест.ОжидаетЧто(пм_МенеджерПакетовКлиентСервер.ИмяРасширенияМенеджера(),
		"имя расширения менеджера").Равно("package-manager");

КонецПроцедуры

#КонецОбласти
