	Источник = СоздатьИсточник("Тест сверки без имени файла");
	ЗаписатьПакет(Источник, "пм_неизвестный_пакет", "1.0.0", "");

	пм_МенеджерПакетов.СверитьУстановленныеПакеты();

	Сведения = РегистрыСведений.пм_УстановленныеПакеты.ВерсииПакетов(
