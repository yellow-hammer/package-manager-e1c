	Сведения = РегистрыСведений.пм_УстановленныеПакеты.ВерсииПакетов("solution", Источник);

	ЮТест.ОжидаетЧто(Сведения.Количество(),
		"расширения с таким именем нет, запись снята").Равно(0);

КонецПроцедуры

Процедура ПрисутствиеПроверяетсяПоИмениРасширения() Экспорт

	ИмяМенеджера = пм_МенеджерПакетовКлиентСервер.ИмяРасширенияМенеджера();

	ЮТест.ОжидаетЧто(
		пм_МенеджерПакетов.ПакетПрисутствуетВИнформационнойБазе(
			"PaketnyyMenedzher", "PaketnyyMenedzher.cfe", ИмяМенеджера),
