// Тесты регистра сведений установленных пакетов.
// Прогон идет в транзакции, записи в базе не остаются.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьСерверныйТест("СтруктураЗаписиСодержитВсеПоля")
		.ДобавитьСерверныйТест("ЗаписьИЧтениеСведений")
		.ДобавитьСерверныйТест("ДатаУстановкиЗаполняетсяАвтоматически")
		.ДобавитьСерверныйТест("ПовторнаяЗаписьОбновляетВерсию")
		.ДобавитьСерверныйТест("ОдинПакетИзРазныхИсточниковНеСмешивается")
		.ДобавитьСерверныйТест("ОтборПоИсточнику")
		.ДобавитьСерверныйТест("ОтборПоИменамПакетов")
		.ДобавитьСерверныйТест("АвтообновлениеСохраняетсяПриПовторнойЗаписи")
		.ДобавитьСерверныйТест("УстановитьАвтообновлениеМеняетТолькоГалку")
		.ДобавитьСерверныйТест("УдалитьСведенияУбираетЗапись")
		.ДобавитьСерверныйТест("ПрисутствиеНаходитСтоящееРасширение")
		.ДобавитьСерверныйТест("ПрисутствиеНеНаходитСнятоеРасширение")
		.ДобавитьСерверныйТест("ПрисутствиеВнешнегоФайлаНеПроверяется")
		.ДобавитьСерверныйТест("СверкаСнимаетОтсутствующееРасширение")
		.ДобавитьСерверныйТест("СверкаОставляетСтоящееРасширение")
		.ДобавитьСерверныйТест("СверкаНеТрогаетВнешнююОбработку")
		.ДобавитьСерверныйТест("СверкаНеТрогаетПакетБезИмениФайла")
		.ДобавитьСерверныйТест("СверкаОставляетПакетСДругимИменемРасширения")
		.ДобавитьСерверныйТест("СверкаСнимаетПакетСНеизвестнымИменемРасширения")
		.ДобавитьСерверныйТест("ПрисутствиеПроверяетсяПоИмениРасширения");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура СтруктураЗаписиСодержитВсеПоля() Экспорт

	Структура = РегистрыСведений.пм_УстановленныеПакеты.СтруктураЗаписи();

	ПоляЗаписи = "Источник,Пакет,Версия,ИмяФайла,ИмяРасширения,ДатаУстановки,"
		+ "ТекстОшибки,ДоступнаяВерсия,ДатаПроверки,Автообновление";

	Для Каждого ИмяПоля Из СтрРазделить(ПоляЗаписи, ",") Цикл
		ЮТест.ОжидаетЧто(Структура.Свойство(ИмяПоля),
			"структура содержит поле " + ИмяПоля).Равно(Истина);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаписьИЧтениеСведений() Экспорт

	Источник = СоздатьИсточник("Тест записи");

	ЗаписатьПакет(Источник, "solution", "1.0.0", "solution.cfe");

	Сведения = РегистрыСведений.пм_УстановленныеПакеты.ВерсииПакетов("solution", Источник);

	ЮТест.ОжидаетЧто(Сведения.Количество(), "найдена одна запись").Равно(1);
	ЮТест.ОжидаетЧто(Сведения[0].Версия, "версия").Равно("1.0.0");
	ЮТест.ОжидаетЧто(Сведения[0].ИмяФайла, "имя файла").Равно("solution.cfe");
	ЮТест.ОжидаетЧто(Сведения[0].Источник, "источник").Равно(Источник);

КонецПроцедуры

Процедура ДатаУстановкиЗаполняетсяАвтоматически() Экспорт

	Источник = СоздатьИсточник("Тест даты");

	ЗаписатьПакет(Источник, "solution", "1.0.0", "solution.cfe");

	Сведения = РегистрыСведений.пм_УстановленныеПакеты.ВерсииПакетов("solution", Источник);

	ЮТест.ОжидаетЧто(Сведения[0].ДатаУстановки,
		"дата установки проставлена без явного указания").Заполнено();

КонецПроцедуры

Процедура ПовторнаяЗаписьОбновляетВерсию() Экспорт

	Источник = СоздатьИсточник("Тест обновления");

	ЗаписатьПакет(Источник, "solution", "1.0.0", "solution.cfe");
	ЗаписатьПакет(Источник, "solution", "2.0.0", "solution.cfe");

	Сведения = РегистрыСведений.пм_УстановленныеПакеты.ВерсииПакетов("solution", Источник);

	ЮТест.ОжидаетЧто(Сведения.Количество(),
		"запись не задвоилась").Равно(1);
	ЮТест.ОжидаетЧто(Сведения[0].Версия, "версия обновлена").Равно("2.0.0");

КонецПроцедуры

Процедура ОдинПакетИзРазныхИсточниковНеСмешивается() Экспорт

	Первый = СоздатьИсточник("Первый источник");
	Второй = СоздатьИсточник("Второй источник");

	ЗаписатьПакет(Первый, "solution", "1.0.0", "solution.cfe");
	ЗаписатьПакет(Второй, "solution", "3.0.0", "solution.cfe");

	// Источник входит в ключ записи: одно и то же имя пакета,
	// пришедшее из разных источников, - это разные записи.
	СведенияПервого = РегистрыСведений.пм_УстановленныеПакеты.ВерсииПакетов("solution", Первый);
	СведенияВторого = РегистрыСведений.пм_УстановленныеПакеты.ВерсииПакетов("solution", Второй);

	ЮТест.ОжидаетЧто(СведенияПервого.Количество(), "запись первого источника").Равно(1);
	ЮТест.ОжидаетЧто(СведенияВторого.Количество(), "запись второго источника").Равно(1);
	ЮТест.ОжидаетЧто(СведенияПервого[0].Версия, "версия из первого источника").Равно("1.0.0");
	ЮТест.ОжидаетЧто(СведенияВторого[0].Версия, "версия из второго источника").Равно("3.0.0");

КонецПроцедуры

Процедура ОтборПоИсточнику() Экспорт

	Первый = СоздатьИсточник("Источник для отбора 1");
	Второй = СоздатьИсточник("Источник для отбора 2");

	ЗаписатьПакет(Первый, "alpha", "1.0.0", "alpha.cfe");
	ЗаписатьПакет(Первый, "beta", "1.0.0", "beta.cfe");
	ЗаписатьПакет(Второй, "gamma", "1.0.0", "gamma.cfe");

	Сведения = РегистрыСведений.пм_УстановленныеПакеты.ВерсииПакетов(, Первый);

	ЮТест.ОжидаетЧто(Сведения.Количество(),
		"отобраны только пакеты первого источника").Равно(2);

КонецПроцедуры

Процедура ОтборПоИменамПакетов() Экспорт

	Источник = СоздатьИсточник("Источник для отбора по именам");

	ЗаписатьПакет(Источник, "alpha", "1.0.0", "alpha.cfe");
	ЗаписатьПакет(Источник, "beta", "1.0.0", "beta.cfe");
	ЗаписатьПакет(Источник, "gamma", "1.0.0", "gamma.cfe");

	ИменаПакетов = Новый Массив;
	ИменаПакетов.Добавить("alpha");
	ИменаПакетов.Добавить("gamma");

	Сведения = РегистрыСведений.пм_УстановленныеПакеты.ВерсииПакетов(ИменаПакетов, Источник);

	ЮТест.ОжидаетЧто(Сведения.Количество(), "отобраны два пакета из трех").Равно(2);

КонецПроцедуры

Процедура АвтообновлениеСохраняетсяПриПовторнойЗаписи() Экспорт

	Источник = СоздатьИсточник("Тест сохранения автообновления");

	Сведения = РегистрыСведений.пм_УстановленныеПакеты.СтруктураЗаписи();
	Сведения.Источник = Источник;
	Сведения.Пакет = "solution";
	Сведения.Версия = "1.0.0";
	Сведения.ИмяФайла = "solution.cfe";
	Сведения.Автообновление = Истина;
	РегистрыСведений.пм_УстановленныеПакеты.ОбновитьСведения(Сведения);

	Повторно = РегистрыСведений.пм_УстановленныеПакеты.СтруктураЗаписи();
	Повторно.Источник = Источник;
	Повторно.Пакет = "solution";
	Повторно.Версия = "1.1.0";
	Повторно.ИмяФайла = "solution.cfe";
	РегистрыСведений.пм_УстановленныеПакеты.ОбновитьСведения(Повторно);

	Прочитанные = РегистрыСведений.пм_УстановленныеПакеты.ВерсииПакетов("solution", Источник);

	ЮТест.ОжидаетЧто(Прочитанные[0].Версия, "версия обновлена").Равно("1.1.0");
	ЮТест.ОжидаетЧто(Прочитанные[0].Автообновление,
		"галка не стерлась без явного значения").Равно(Истина);

КонецПроцедуры

Процедура УстановитьАвтообновлениеМеняетТолькоГалку() Экспорт

	Источник = СоздатьИсточник("Тест галки автообновления");
	ЗаписатьПакет(Источник, "solution", "1.0.0", "solution.cfe");

	ЮТест.ОжидаетЧто(
		РегистрыСведений.пм_УстановленныеПакеты.УстановитьАвтообновление(
			Источник, "solution", Истина),
		"галка записана").Равно(Истина);

	Сведения = РегистрыСведений.пм_УстановленныеПакеты.ВерсииПакетов("solution", Источник);

	ЮТест.ОжидаетЧто(Сведения[0].Автообновление, "автообновление включено").Равно(Истина);
	ЮТест.ОжидаетЧто(Сведения[0].Версия, "версия не изменилась").Равно("1.0.0");

	ЮТест.ОжидаетЧто(
		РегистрыСведений.пм_УстановленныеПакеты.УстановитьАвтообновление(
			Источник, "missing", Истина),
		"нет записи - галку поставить нельзя").Равно(Ложь);

КонецПроцедуры

