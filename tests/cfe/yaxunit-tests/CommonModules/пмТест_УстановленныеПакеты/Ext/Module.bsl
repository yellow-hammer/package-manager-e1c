		"имя пакета совпадает, но расширения с таким именем нет").Равно(Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсточник(Наименование)

	Объект = Справочники.пм_ИсточникиПакетов.СоздатьЭлемент();
	Объект.Заполнить(Неопределено);
	Объект.Наименование = Наименование;
	Объект.URLСервера = "https://gitlab.example.com";
	Объект.ПутьПроекта = "group/" + СтрЗаменить(НРег(Наименование), " ", "-");
	Объект.Записать();

	Возврат Объект.Ссылка;

КонецФункции

Процедура ЗаписатьПакет(Источник, ИмяПакета, Версия, ИмяФайла, ИмяРасширения = "")

	Сведения = РегистрыСведений.пм_УстановленныеПакеты.СтруктураЗаписи();
	Сведения.Источник = Источник;
	Сведения.Пакет = ИмяПакета;
	Сведения.Версия = Версия;
	Сведения.ИмяФайла = ИмяФайла;
	Сведения.ИмяРасширения = ИмяРасширения;
	Сведения.ТекстОшибки = "";

	РегистрыСведений.пм_УстановленныеПакеты.ОбновитьСведения(Сведения);

КонецПроцедуры

#КонецОбласти
