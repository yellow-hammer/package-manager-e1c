КонецПроцедуры

// Имя пакета в реестре и имя расширения в базе не совпадают: GitLab
// требует ASCII, и пайплайн транслитерирует имя. Сверка идет по имени
// расширения, иначе она снимала бы запись сразу после установки.
Процедура СверкаОставляетПакетСДругимИменемРасширения() Экспорт

	Источник = СоздатьИсточник("Тест сверки по имени расширения");
	ИмяМенеджера = пм_МенеджерПакетовКлиентСервер.ИмяРасширенияМенеджера();

	ЗаписатьПакет(Источник, "PaketnyyMenedzher", "0.1.0", "PaketnyyMenedzher.cfe", ИмяМенеджера);

	пм_МенеджерПакетов.СверитьУстановленныеПакеты();

	Сведения = РегистрыСведений.пм_УстановленныеПакеты.ВерсииПакетов("PaketnyyMenedzher", Источник);

	ЮТест.ОжидаетЧто(Сведения.Количество(),
		"имя пакета другое, но расширение стоит").Равно(1);
	ЮТест.ОжидаетЧто(Сведения[0].ИмяРасширения,
		"имя расширения сохранено").Равно(ИмяМенеджера);

КонецПроцедуры

Процедура СверкаСнимаетПакетСНеизвестнымИменемРасширения() Экспорт

	Источник = СоздатьИсточник("Тест сверки снятого по имени расширения");

