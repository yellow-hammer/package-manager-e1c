// Тесты разбора, сравнения и сортировки версий пакетов.
// Проверяется общий модуль пм_ВерсииПакетов расширения package-manager.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	// Модуль пм_ВерсииПакетов клиент-серверный, поэтому каждый тест
	// регистрируется в обоих контекстах: серверный прогон не увидел бы
	// имени, недоступного на тонком клиенте.
	ЮТТесты
		.ДобавитьСерверныйТест("РазборСтабильнойВерсии")
		.ДобавитьКлиентскийТест("РазборСтабильнойВерсии")
		.ДобавитьСерверныйТест("РазборПререлиза")
		.ДобавитьКлиентскийТест("РазборПререлиза")
		.ДобавитьСерверныйТест("РазборОтбрасываетМетаданныеСборки")
		.ДобавитьКлиентскийТест("РазборОтбрасываетМетаданныеСборки")
		.ДобавитьСерверныйТест("НесемантическиеВерсииРаспознаются")
		.ДобавитьКлиентскийТест("НесемантическиеВерсииРаспознаются")
		.ДобавитьСерверныйТест("ЧисловыеЧастиСравниваютсяЧисленно")
		.ДобавитьКлиентскийТест("ЧисловыеЧастиСравниваютсяЧисленно")
		.ДобавитьСерверныйТест("РелизСтаршеПререлиза")
		.ДобавитьКлиентскийТест("РелизСтаршеПререлиза")
		.ДобавитьСерверныйТест("НомерПререлизаСравниваетсяЧисленно")
		.ДобавитьКлиентскийТест("НомерПререлизаСравниваетсяЧисленно")
		.ДобавитьСерверныйТест("ПререлизСБольшимЧисломИдентификаторовСтарше")
		.ДобавитьКлиентскийТест("ПререлизСБольшимЧисломИдентификаторовСтарше")
		.ДобавитьСерверныйТест("ЧисловойИдентификаторМладшеБуквенного")
		.ДобавитьКлиентскийТест("ЧисловойИдентификаторМладшеБуквенного")
		.ДобавитьСерверныйТест("ФильтрПоТипуРелиза")
		.ДобавитьКлиентскийТест("ФильтрПоТипуРелиза")
		.ДобавитьСерверныйТест("ПустойФильтрПропускаетВсе")
		.ДобавитьКлиентскийТест("ПустойФильтрПропускаетВсе");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура РазборСтабильнойВерсии() Экспорт

	Версия = пм_ВерсииПакетов.РазобратьВерсию("1.2.3");

	ЮТест.ОжидаетЧто(Версия.Семантическая, "признак semver").Равно(Истина);
	ЮТест.ОжидаетЧто(Версия.Мажорная, "мажорная").Равно(1);
	ЮТест.ОжидаетЧто(Версия.Минорная, "минорная").Равно(2);
	ЮТест.ОжидаетЧто(Версия.Патч, "патч").Равно(3);
	ЮТест.ОжидаетЧто(Версия.Пререлиз, "пререлиз").Равно("");
	ЮТест.ОжидаетЧто(Версия.ТипРелиза, "тип релиза").Равно("stable");

КонецПроцедуры

Процедура РазборПререлиза() Экспорт

	ЮТест.ОжидаетЧто(пм_ВерсииПакетов.РазобратьВерсию("1.0.0-rc1").ТипРелиза,
		"rc определяется по префиксу").Равно("rc");

	ЮТест.ОжидаетЧто(пм_ВерсииПакетов.РазобратьВерсию("1.0.0-dev.5").ТипРелиза,
		"dev определяется по префиксу").Равно("dev");

	ЮТест.ОжидаетЧто(пм_ВерсииПакетов.РазобратьВерсию("1.0.0-alpha").ТипРелиза,
		"незнакомый пререлиз - other").Равно("other");

	ЮТест.ОжидаетЧто(пм_ВерсииПакетов.РазобратьВерсию("1.0.0-rc1").Пререлиз,
		"текст пререлиза").Равно("rc1");

КонецПроцедуры

Процедура РазборОтбрасываетМетаданныеСборки() Экспорт

	// По semver часть после плюса на сравнение версий не влияет.
	Версия = пм_ВерсииПакетов.РазобратьВерсию("1.2.3+build.77");

	ЮТест.ОжидаетЧто(Версия.Семантическая, "версия с метаданными сборки semver").Равно(Истина);
	ЮТест.ОжидаетЧто(Версия.Патч, "патч разобран").Равно(3);
	ЮТест.ОжидаетЧто(
		пм_ВерсииПакетов.СравнитьВерсии("1.2.3+build.77", "1.2.3"),
		"метаданные сборки не влияют на сравнение").Равно(0);

КонецПроцедуры

Процедура НесемантическиеВерсииРаспознаются() Экспорт

	ЮТест.ОжидаетЧто(пм_ВерсииПакетов.ЭтоНесемантическаяВерсия("package-manager-v0.1.3"),
		"тег с именем пакета").Равно(Истина);

	ЮТест.ОжидаетЧто(пм_ВерсииПакетов.ЭтоНесемантическаяВерсия("latest"),
		"строка latest").Равно(Истина);

	ЮТест.ОжидаетЧто(пм_ВерсииПакетов.ЭтоНесемантическаяВерсия("1.2"),
		"две части вместо трех").Равно(Истина);

	ЮТест.ОжидаетЧто(пм_ВерсииПакетов.ЭтоНесемантическаяВерсия("1.2.3"),
		"корректная версия").Равно(Ложь);

КонецПроцедуры

Процедура ЧисловыеЧастиСравниваютсяЧисленно() Экспорт

	// Лексически "1.0.10" младше "1.0.9". Численно - старше.
	ЮТест.ОжидаетЧто(пм_ВерсииПакетов.СравнитьВерсии("1.0.10", "1.0.9"),
		"1.0.10 старше 1.0.9").Равно(1);

	ЮТест.ОжидаетЧто(пм_ВерсииПакетов.СравнитьВерсии("1.0.9", "1.0.10"),
		"обратный порядок").Равно(-1);

	ЮТест.ОжидаетЧто(пм_ВерсииПакетов.СравнитьВерсии("2.0.0", "2.0.0"),
		"равные версии").Равно(0);

	ЮТест.ОжидаетЧто(пм_ВерсииПакетов.СравнитьВерсии("2.0.0", "1.99.99"),
		"мажорная важнее остальных").Равно(1);

КонецПроцедуры

Процедура РелизСтаршеПререлиза() Экспорт

	ЮТест.ОжидаетЧто(пм_ВерсииПакетов.СравнитьВерсии("1.0.0", "1.0.0-rc1"),
		"релиз старше своего пререлиза").Равно(1);

	ЮТест.ОжидаетЧто(пм_ВерсииПакетов.СравнитьВерсии("1.0.0-rc1", "1.0.0"),
		"обратный порядок").Равно(-1);

КонецПроцедуры

Процедура НомерПререлизаСравниваетсяЧисленно() Экспорт

	// Осознанное отступление от строгого semver: по спецификации идентификатор
	// с буквами сравнивается лексически, то есть "rc10" оказался бы младше "rc9".
	// Схема версий проекта использует запись "-rc1" без точки, поэтому числовой
	// хвост выделяется и сравнивается численно.
	ЮТест.ОжидаетЧто(пм_ВерсииПакетов.СравнитьВерсии("1.0.0-rc10", "1.0.0-rc9"),
		"rc10 старше rc9").Равно(1);

	// Запись с точкой - обычный числовой идентификатор semver.
	ЮТест.ОжидаетЧто(пм_ВерсииПакетов.СравнитьВерсии("1.0.0-dev.10", "1.0.0-dev.5"),
		"dev.10 старше dev.5").Равно(1);

КонецПроцедуры

Процедура ПререлизСБольшимЧисломИдентификаторовСтарше() Экспорт

	// По semver при равном начале более длинный набор идентификаторов старше.
	ЮТест.ОжидаетЧто(пм_ВерсииПакетов.СравнитьВерсии("1.0.0-rc1.1", "1.0.0-rc1"),
		"rc1.1 старше rc1").Равно(1);

КонецПроцедуры

Процедура ЧисловойИдентификаторМладшеБуквенного() Экспорт

	// Правило semver: числовые идентификаторы всегда младше буквенных.
	ЮТест.ОжидаетЧто(пм_ВерсииПакетов.СравнитьВерсии("1.0.0-1", "1.0.0-alpha"),
		"числовой пререлиз младше буквенного").Равно(-1);

КонецПроцедуры

Процедура ФильтрПоТипуРелиза() Экспорт

	ЮТест.ОжидаетЧто(пм_ВерсииПакетов.ВерсияПодходитПодФильтр("1.0.0", "stable"),
		"релиз проходит фильтр stable").Равно(Истина);

	ЮТест.ОжидаетЧто(пм_ВерсииПакетов.ВерсияПодходитПодФильтр("1.0.0-rc1", "stable"),
		"пререлиз не проходит фильтр stable").Равно(Ложь);

	ЮТест.ОжидаетЧто(пм_ВерсииПакетов.ВерсияПодходитПодФильтр("1.0.0-rc1", "rc"),
		"пререлиз проходит фильтр rc").Равно(Истина);

	ЮТест.ОжидаетЧто(пм_ВерсииПакетов.ВерсияПодходитПодФильтр("1.0.0-dev.1", "dev"),
		"dev проходит фильтр dev").Равно(Истина);

КонецПроцедуры

Процедура ПустойФильтрПропускаетВсе() Экспорт

	ЮТест.ОжидаетЧто(пм_ВерсииПакетов.ВерсияПодходитПодФильтр("1.0.0-rc1", ""),
		"пустой фильтр пропускает пререлиз").Равно(Истина);

	ЮТест.ОжидаетЧто(пм_ВерсииПакетов.ВерсияПодходитПодФильтр("latest", ""),
		"пустой фильтр пропускает несемантическую версию").Равно(Истина);

КонецПроцедуры

#КонецОбласти
