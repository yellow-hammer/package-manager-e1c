// Тесты каталога формы менеджера пакетов.
// Без сети: источники читаются из справочника, пакеты собираются
// из готовых описаний.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьСерверныйТест("ПустойИсточникКаталогаВозвращаетВсе")
		.ДобавитьСерверныйТест("ЗаполненныйИсточникКаталогаВозвращаетОдин")
		.ДобавитьСерверныйТест("ПомеченныйИсточникВКаталогНеВходит")
		.ДобавитьСерверныйТест("ПакетБезВерсийОстаетсяВСписке")
		.ДобавитьСерверныйТест("ВыбраннаяВерсияЭтоПоследняя")
		.ДобавитьСерверныйТест("ИмяФайлаБеретсяИзОписанияВерсии")
		.ДобавитьСерверныйТест("ПустоеОписаниеНеПодменяетсяИменем")
		.ДобавитьСерверныйТест("ВыбраннаяВерсияИщетсяБезФильтраТипаРелиза")
		.ДобавитьСерверныйТест("БезВыбраннойВерсииФильтрТипаРелизаСохраняется")
		.ДобавитьСерверныйТест("ИмяПакетаПовторяетТранслитерациюПайплайна")
		.ДобавитьСерверныйТест("ЛатинскоеИмяРасширенияОстаетсяКакЕсть")
		.ДобавитьСерверныйТест("РасширениеПакетаНаходитМенеджера")
		.ДобавитьСерверныйТест("РасширениеПакетаНеНаходитЧужоеИмя");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ПустойИсточникКаталогаВозвращаетВсе() Экспорт

	Первый = СоздатьИсточник("Каталог A");
	Второй = СоздатьИсточник("Каталог B");

	ПараметрыКоманды = Новый Структура;
	Источники = Обработки.пм_МенеджерПакетов.ИсточникиКаталога(ПараметрыКоманды);

	ЮТест.ОжидаетЧто(Источники.Найти(Первый) <> Неопределено,
		"первый источник в каталоге").Равно(Истина);
	ЮТест.ОжидаетЧто(Источники.Найти(Второй) <> Неопределено,
		"второй источник в каталоге").Равно(Истина);

КонецПроцедуры

Процедура ЗаполненныйИсточникКаталогаВозвращаетОдин() Экспорт

	Первый = СоздатьИсточник("Только этот");
	СоздатьИсточник("Другой");

	ПараметрыКоманды = Новый Структура("Источник", Первый);
	Источники = Обработки.пм_МенеджерПакетов.ИсточникиКаталога(ПараметрыКоманды);

	ЮТест.ОжидаетЧто(Источники.Количество(), "только выбранный источник").Равно(1);
	ЮТест.ОжидаетЧто(Источники[0], "это выбранный источник").Равно(Первый);

КонецПроцедуры

Процедура ПомеченныйИсточникВКаталогНеВходит() Экспорт

	Источник = СоздатьИсточник("На удаление");
	Объект = Источник.ПолучитьОбъект();
	Объект.ПометкаУдаления = Истина;
	Объект.Записать();

	Источники = Обработки.пм_МенеджерПакетов.ИсточникиКаталога(Новый Структура);

	ЮТест.ОжидаетЧто(Источники.Найти(Источник) = Неопределено,
		"помеченный источник отброшен").Равно(Истина);

КонецПроцедуры

Процедура ПакетБезВерсийОстаетсяВСписке() Экспорт

	Описания = Новый Массив;
	Описания.Добавить(ОписаниеПакета("orphan", "без версий"));

	Каталог = Обработки.пм_МенеджерПакетов.КаталогИзОписаний(Описания);

	ЮТест.ОжидаетЧто(Каталог.Пакеты.Количество(), "строка пакета осталась").Равно(1);
	ЮТест.ОжидаетЧто(Каталог.Пакеты[0].Имя, "имя пакета").Равно("orphan");
	ЮТест.ОжидаетЧто(Каталог.Версии.Количество(), "версий нет").Равно(0);
	ЮТест.ОжидаетЧто(Каталог.Пакеты[0].ВыбраннаяВерсия,
		"выбранная версия пустая").Равно("");

КонецПроцедуры

Процедура ВыбраннаяВерсияЭтоПоследняя() Экспорт

	Описания = Новый Массив;
	Описания.Добавить(ОписаниеПакета("demo", "демо"));

	ВерсииПакета = Новый Массив;
	ВерсииПакета.Добавить(ОписаниеВерсии("1.0.0", "demo.cfe"));
	ВерсииПакета.Добавить(ОписаниеВерсии("1.0.10", "demo.cfe"));
	ВерсииПакета.Добавить(ОписаниеВерсии("1.0.9", "demo.cfe"));

	ВерсииПоПакетам = Новый Соответствие;
	ВерсииПоПакетам.Вставить("demo", ВерсииПакета);

	Каталог = Обработки.пм_МенеджерПакетов.КаталогИзОписаний(Описания, ВерсииПоПакетам);

	ЮТест.ОжидаетЧто(Каталог.Пакеты[0].ВыбраннаяВерсия,
		"предвыбор - последняя semver").Равно("1.0.10");
	ЮТест.ОжидаетЧто(Каталог.Версии.Количество(), "все версии на месте").Равно(3);

КонецПроцедуры

Процедура ИмяФайлаБеретсяИзОписанияВерсии() Экспорт

	Описания = Новый Массив;
	Описания.Добавить(ОписаниеПакета("alpha", ""));

	ВерсияСИменем = ОписаниеВерсии("1.2.0", "alpha.epf");
	ВерсияБезИмени = Новый Соответствие;
	ВерсияБезИмени.Вставить("id", "2");
	ВерсияБезИмени.Вставить("version", "1.1.0");

	ВерсииПакета = Новый Массив;
	ВерсииПакета.Добавить(ВерсияСИменем);
	ВерсииПакета.Добавить(ВерсияБезИмени);

	ВерсииПоПакетам = Новый Соответствие;
	ВерсииПоПакетам.Вставить("alpha", ВерсииПакета);

	Каталог = Обработки.пм_МенеджерПакетов.КаталогИзОписаний(Описания, ВерсииПоПакетам);

	ЮТест.ОжидаетЧто(Каталог.Пакеты[0].ИмяФайла,
		"файл последней версии из описания").Равно("alpha.epf");

	ФайлБезИмени = "";
	Для Каждого СтрокаВерсии Из Каталог.Версии Цикл
		Если СтрокаВерсии.Номер = "1.1.0" Тогда
			ФайлБезИмени = СтрокаВерсии.ИмяФайла;
		КонецЕсли;
	КонецЦикла;

	ЮТест.ОжидаетЧто(ФайлБезИмени,
		"без file_name расширение не угадываем").Равно("");

КонецПроцедуры

Процедура ПустоеОписаниеНеПодменяетсяИменем() Экспорт

	Описания = Новый Массив;
	Описания.Добавить(ОписаниеПакета("orphan", ""));

	Каталог = Обработки.пм_МенеджерПакетов.КаталогИзОписаний(Описания);

	ЮТест.ОжидаетЧто(Каталог.Пакеты[0].Описание,
		"пустое описание не копируется из имени").Равно("");

КонецПроцедуры

// Список формы показывает версии всех типов, а параметры установки
// по умолчанию просят stable. Для явно выбранной версии фильтр снимается,
// иначе rc, dev и несемантические версии установить нельзя.
Процедура ВыбраннаяВерсияИщетсяБезФильтраТипаРелиза() Экспорт

	Стабильный = пм_ВерсииПакетов.ТипРелизаСтабильный();

	ЮТест.ОжидаетЧто(
		Обработки.пм_МенеджерПакетов.ФильтрТипаРелизаДляПоиска(Стабильный, "1.0.0-rc1"),
		"для rc-версии фильтр снят").Равно("");

	ЮТест.ОжидаетЧто(
		Обработки.пм_МенеджерПакетов.ФильтрТипаРелизаДляПоиска(Стабильный, "1.0.0.5"),
		"для несемантической версии фильтр снят").Равно("");

	ЮТест.ОжидаетЧто(
		Обработки.пм_МенеджерПакетов.ФильтрТипаРелизаДляПоиска(Стабильный, "1.0.0"),
		"для стабильной версии фильтр тоже не нужен").Равно("");

КонецПроцедуры

Процедура БезВыбраннойВерсииФильтрТипаРелизаСохраняется() Экспорт

	Стабильный = пм_ВерсииПакетов.ТипРелизаСтабильный();

	ЮТест.ОжидаетЧто(
		Обработки.пм_МенеджерПакетов.ФильтрТипаРелизаДляПоиска(Стабильный, ""),
		"последняя версия ищется среди stable").Равно(Стабильный);

	ЮТест.ОжидаетЧто(
		Обработки.пм_МенеджерПакетов.ФильтрТипаРелизаДляПоиска("", ""),
		"пустой фильтр остается пустым").Равно("");

КонецПроцедуры

// Пакет в реестре GitLab называется не так, как расширение: имя обязано
// быть ASCII, и пайплайн его транслитерирует. Проверяется тем же примером,
// на котором это вылезло: BITAdapterIntegratsiyaProektnyy.
Процедура ИмяПакетаПовторяетТранслитерациюПайплайна() Экспорт

	ЮТест.ОжидаетЧто(
		пм_МенеджерПакетовКлиентСервер.ИмяПакетаПоИмениРасширения("БИТАдаптерИнтеграцияПроектный"),
		"имя пакета из кириллического имени расширения").Равно("BITAdapterIntegratsiyaProektnyy");

	ЮТест.ОжидаетЧто(
		пм_МенеджерПакетовКлиентСервер.ИмяПакетаПоИмениРасширения("БИТАдаптер"),
		"второе расширение того же проекта").Равно("BITAdapter");

	ЮТест.ОжидаетЧто(
		пм_МенеджерПакетовКлиентСервер.ИмяПакетаПоИмениРасширения("Модуль"),
		"мягкий знак замены не имеет и отбрасывается").Равно("Modul");

	ЮТест.ОжидаетЧто(
		пм_МенеджерПакетовКлиентСервер.ИмяПакетаПоИмениРасширения("ЁжикЩи"),
		"многобуквенные замены сохраняют регистр").Равно("YozhikSchi");

КонецПроцедуры

Процедура ЛатинскоеИмяРасширенияОстаетсяКакЕсть() Экспорт

	ИмяМенеджера = пм_МенеджерПакетовКлиентСервер.ИмяРасширенияМенеджера();

	ЮТест.ОжидаетЧто(
		пм_МенеджерПакетовКлиентСервер.ИмяПакетаПоИмениРасширения(ИмяМенеджера),
		"дефис разрешен, транслитерация не нужна").Равно(ИмяМенеджера);

	ЮТест.ОжидаетЧто(
		пм_МенеджерПакетовКлиентСервер.ИмяПакетаПоИмениРасширения(""),
		"пустое имя дает пустое").Равно("");

КонецПроцедуры

Процедура РасширениеПакетаНаходитМенеджера() Экспорт

	ИмяМенеджера = пм_МенеджерПакетовКлиентСервер.ИмяРасширенияМенеджера();
	Расширение = пм_ОбщегоНазначения.НайтиРасширение(ИмяМенеджера);

	Сведения = пм_МенеджерПакетов.РасширениеПакета(ИмяМенеджера);

	ЮТест.ОжидаетЧто(Сведения <> Неопределено,
		"менеджер найден среди расширений базы").Равно(Истина);
	ЮТест.ОжидаетЧто(Сведения.Имя, "имя расширения").Равно(ИмяМенеджера);
	ЮТест.ОжидаетЧто(Сведения.Версия,
		"версия берется из свойств расширения").Равно(Строка(Расширение.Версия));

КонецПроцедуры

Процедура РасширениеПакетаНеНаходитЧужоеИмя() Экспорт

	ЮТест.ОжидаетЧто(
		пм_МенеджерПакетов.РасширениеПакета("пм_нет_такого_расширения") = Неопределено,
		"чужого имени в базе нет").Равно(Истина);

	ЮТест.ОжидаетЧто(
		пм_МенеджерПакетов.РасширениеПакета("") = Неопределено,
		"пустое имя ничего не находит").Равно(Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсточник(Наименование)

	Объект = Справочники.пм_ИсточникиПакетов.СоздатьЭлемент();
	Объект.Заполнить(Неопределено);
	Объект.Наименование = Наименование;
	Объект.URLСервера = "https://gitlab.example.com";
	Объект.ПутьПроекта = "group/" + СтрЗаменить(НРег(Наименование), " ", "-");
	Объект.Записать();

	Возврат Объект.Ссылка;

КонецФункции

Функция ОписаниеПакета(Имя, Описание)

	Пакет = Новый Соответствие;
	Пакет.Вставить("name", Имя);
	Пакет.Вставить("description", Описание);

	Возврат Пакет;

КонецФункции

Функция ОписаниеВерсии(Номер, ИмяФайла)

	Версия = Новый Соответствие;
	Версия.Вставить("id", Номер);
	Версия.Вставить("version", Номер);
	Версия.Вставить("file_name", ИмяФайла);
	Версия.Вставить("created_at", "2024-01-01T00:00:00Z");

	Возврат Версия;

КонецФункции

#КонецОбласти
