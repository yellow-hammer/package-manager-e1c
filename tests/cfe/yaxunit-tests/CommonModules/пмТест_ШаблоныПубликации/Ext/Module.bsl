Процедура ШаблоныПодтягиваютСабмодулиИНеПерезаписываютЧужойХеш() Экспорт

	GitLab = ТекстШаблона(пм_ШаблоныПубликацииПакетов.СистемаGitLab());
	GitHub = ТекстШаблона(пм_ШаблоныПубликацииПакетов.СистемаGitHub());
	Jenkins = ТекстШаблона(пм_ШаблоныПубликацииПакетов.СистемаJenkins());

	ЮТест.ОжидаетЧто(СтрНайти(GitLab, "GIT_SUBMODULE_STRATEGY: recursive") > 0,
		"GitLab клонирует сабмодули").Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(GitHub, "submodules: recursive") > 0,
		"GitHub клонирует сабмодули").Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(Jenkins, "git submodule update --init --recursive") > 0,
		"Jenkins подтягивает сабмодули").Равно(Истина);

	ЮТест.ОжидаетЧто(СтрНайти(GitLab, ".srcsha") > 0,
		"GitLab сравнивает git tree SHA").Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(GitLab, "Bump Version") > 0,
		"GitLab падает, если версия та же, а исходники другие").Равно(Истина);

	ЮТест.ОжидаетЧто(СтрНайти(GitHub, "Bump Version") > 0,
		"GitHub падает, если версия та же, а исходники другие").Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(Jenkins, "Bump Version") > 0,
		"Jenkins падает, если версия та же, а исходники другие").Равно(Истина);

