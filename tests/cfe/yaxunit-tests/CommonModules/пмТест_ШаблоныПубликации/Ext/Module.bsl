// Тег - это релиз, поэтому публикуется только тег ветки релиза.
// Проверка живет в OneScript: оболочки Windows- и Linux-раннеров разные.
Процедура ШаблонGitLabПубликуетТолькоТегВеткиРелиза() Экспорт

	Шаблон = пм_ШаблоныПубликацииПакетов.СформироватьШаблон(
		пм_ШаблоныПубликацииПакетов.СистемаGitLab());
	Скрипт = ТекстСкриптаGitLab();

	ЮТест.ОжидаетЧто(СтрНайти(Шаблон, "$CI_COMMIT_TAG") > 0,
		"задания идут только на тег").Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(Шаблон, "GIT_DEPTH") > 0,
		"полная история нужна для проверки ветки").Равно(Истина);

	ЮТест.ОжидаетЧто(СтрНайти(Скрипт, "merge-base") > 0,
		"скрипт проверяет, что коммит тега в ветке релиза").Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(Скрипт, "PM_RELEASE_BRANCH") > 0,
		"ветка релиза настраивается переменной").Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(Скрипт, """main""") > 0,
		"по умолчанию ветка релиза main").Равно(Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстШаблона(СистемаCI)

	Текст = пм_ШаблоныПубликацииПакетов.СформироватьШаблон(СистемаCI);
	Скрипт = пм_ШаблоныПубликацииПакетов.СформироватьСкриптПубликации(СистемаCI);
	Если ЗначениеЗаполнено(Скрипт) Тогда
		Возврат Текст + Символы.ПС + Скрипт;
	КонецЕсли;

	Возврат Текст;

КонецФункции

Функция ТекстСкриптаGitLab()

	Возврат пм_ШаблоныПубликацииПакетов.СформироватьСкриптПубликации(
		пм_ШаблоныПубликацииПакетов.СистемаGitLab());

КонецФункции

#КонецОбласти
