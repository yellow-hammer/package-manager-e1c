// Модульные проверки подготовки источников. Сценарий @Init
// заводит те же карточки через форму, этот модуль его не вызывает.
// Прогон YAxUnit идет в транзакции, созданные здесь элементы в базе не остаются.
// Сети нет: живые адреса только в описаниях, запросы к провайдеру не идут.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьСерверныйТест("ОписанияТестовыхИсточниковПолные")
		.ДобавитьСерверныйТест("ОбеспечитьИсточникСоздает")
		.ДобавитьСерверныйТест("ОбеспечитьИсточникИдемпотентен")
		.ДобавитьСерверныйТест("ОбеспечитьИсточникНормализуетАдрес")
		.ДобавитьСерверныйТест("ОбеспечитьИсточникСохраняетПровайдер")
		.ДобавитьСерверныйТест("ОбеспечитьИсточникНеПишетТокен")
		.ДобавитьСерверныйТест("ОбеспечитьИсточникНеЗатираетСуществующий")
		.ДобавитьСерверныйТест("ОбеспечитьИсточникПустоеИмя")
		.ДобавитьСерверныйТест("ОбеспечитьТестовыеИсточникиСоздаетОба");

КонецПроцедуры

// Описания источников для локальной базы. Токен в структуру не входит.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Наименование - Строка
//   * Провайдер - ПеречислениеСсылка.пм_Провайдеры
//   * URLСервера - Строка
//   * ПутьПроекта - Строка
//
Функция ОписанияТестовыхИсточников() Экспорт

	Список = Новый Массив;

	Описание = НовоеОписаниеИсточника();
	Описание.Наименование = "GitLab example";
	Описание.Провайдер = Перечисления.пм_Провайдеры.GitLab;
	Описание.URLСервера = "https://gitlab.com";
	Описание.ПутьПроекта = "example/packages";
	Список.Добавить(Описание);

	Описание = НовоеОписаниеИсточника();
	Описание.Наименование = "prometheus-e1c";
	Описание.Провайдер = Перечисления.пм_Провайдеры.GitHub;
	Описание.URLСервера = "https://github.com";
	Описание.ПутьПроекта = "yellow-hammer/prometheus-e1c";
	Список.Добавить(Описание);

	Возврат Список;

КонецФункции

// Создает источник, если элемента с таким наименованием еще нет.
// Существующую карточку не меняет: токен и правки пользователя сохраняются.
//
// Параметры:
//  Наименование - Строка
//  Провайдер - ПеречислениеСсылка.пм_Провайдеры
//  URLСервера - Строка
//  ПутьПроекта - Строка
//
// Возвращаемое значение:
//  СправочникСсылка.пм_ИсточникиПакетов
//
Функция ОбеспечитьИсточник(Наименование, Провайдер, URLСервера, ПутьПроекта) Экспорт

	Наименование = СокрЛП(Наименование);
	Если Не ЗначениеЗаполнено(Наименование) Тогда
		ВызватьИсключение НСтр("ru = 'Наименование источника не заполнено.'");
	КонецЕсли;

	Ссылка = Справочники.пм_ИсточникиПакетов.НайтиПоНаименованию(Наименование, Истина);
	Если Не Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;

	Объект = Справочники.пм_ИсточникиПакетов.СоздатьЭлемент();
	Объект.Заполнить(Неопределено);
	Объект.Наименование = Наименование;
	Объект.Провайдер = Провайдер;
	Объект.URLСервера = URLСервера;
	Объект.ПутьПроекта = ПутьПроекта;
	Объект.Записать();

	Возврат Объект.Ссылка;

КонецФункции

// Заводит оба тестовых источника. Повторный вызов те же элементы не дублирует.
Процедура ОбеспечитьТестовыеИсточники() Экспорт

	Для Каждого Описание Из ОписанияТестовыхИсточников() Цикл
		ОбеспечитьИсточник(
			Описание.Наименование,
			Описание.Провайдер,
			Описание.URLСервера,
			Описание.ПутьПроекта);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ОписанияТестовыхИсточниковПолные() Экспорт

	Описания = ОписанияТестовыхИсточников();

	ЮТест.ОжидаетЧто(Описания.Количество(), "два тестовых источника").Равно(2);

	Имена = Новый Соответствие;
	Провайдеры = Новый Соответствие;

	Для Каждого Описание Из Описания Цикл

		ЮТест.ОжидаетЧто(Описание.Наименование, "наименование заполнено").Заполнено();
		ЮТест.ОжидаетЧто(Описание.Провайдер, "провайдер заполнен").Заполнено();
		ЮТест.ОжидаетЧто(Описание.URLСервера, "адрес сервера заполнен").Заполнено();
		ЮТест.ОжидаетЧто(Описание.ПутьПроекта, "путь проекта заполнен").Заполнено();
		ЮТест.ОжидаетЧто(Описание.Свойство("Токен"),
			"токен в описание не входит").Равно(Ложь);
		ЮТест.ОжидаетЧто(Описание.Свойство("ТокенДоступа"),
			"токен доступа в описание не входит").Равно(Ложь);

		Имена.Вставить(Описание.Наименование, Истина);
		Провайдеры.Вставить(Описание.Провайдер, Истина);

	КонецЦикла;

	ЮТест.ОжидаетЧто(Имена.Получить("GitLab example") = Истина,
		"есть источник GitLab example").Равно(Истина);
	ЮТест.ОжидаетЧто(Имена.Получить("prometheus-e1c") = Истина,
		"есть источник prometheus-e1c").Равно(Истина);
	ЮТест.ОжидаетЧто(Провайдеры.Получить(Перечисления.пм_Провайдеры.GitLab) = Истина,
		"есть источник GitLab").Равно(Истина);
	ЮТест.ОжидаетЧто(Провайдеры.Получить(Перечисления.пм_Провайдеры.GitHub) = Истина,
		"есть источник GitHub").Равно(Истина);

КонецПроцедуры

Процедура ОбеспечитьИсточникСоздает() Экспорт

	Ссылка = ОбеспечитьИсточник("Тест init создать",
		Перечисления.пм_Провайдеры.GitLab,
		"https://gitlab.example.com",
		"group/project");

	ЮТест.ОжидаетЧто(Ссылка.Пустая(), "источник создан").Равно(Ложь);

	Реквизиты = пм_ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка,
		"Наименование, Провайдер, URLСервера, ПутьПроекта, ТокенДоступа");

	ЮТест.ОжидаетЧто(Реквизиты.Наименование).Равно("Тест init создать");
	ЮТест.ОжидаетЧто(Реквизиты.Провайдер).Равно(Перечисления.пм_Провайдеры.GitLab);
	ЮТест.ОжидаетЧто(Реквизиты.URLСервера).Равно("https://gitlab.example.com");
	ЮТест.ОжидаетЧто(Реквизиты.ПутьПроекта).Равно("group/project");
	ЮТест.ОжидаетЧто(Реквизиты.ТокенДоступа, "токен не записан").НеЗаполнено();

КонецПроцедуры

Процедура ОбеспечитьИсточникИдемпотентен() Экспорт

	Первая = ОбеспечитьИсточник("Тест init повтор",
		Перечисления.пм_Провайдеры.GitLab,
		"https://gitlab.example.com",
		"group/project");
	Вторая = ОбеспечитьИсточник("Тест init повтор",
		Перечисления.пм_Провайдеры.GitHub,
		"https://github.com",
		"other/project");

	ЮТест.ОжидаетЧто(Вторая, "повтор возвращает ту же ссылку").Равно(Первая);
	ЮТест.ОжидаетЧто(КоличествоПоНаименованию("Тест init повтор"),
		"дубликат не создан").Равно(1);

	Реквизиты = пм_ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Первая,
		"Провайдер, URLСервера, ПутьПроекта");
	ЮТест.ОжидаетЧто(Реквизиты.Провайдер,
		"существующий провайдер не перезаписан").Равно(Перечисления.пм_Провайдеры.GitLab);
	ЮТест.ОжидаетЧто(Реквизиты.URLСервера,
		"существующий адрес не перезаписан").Равно("https://gitlab.example.com");
	ЮТест.ОжидаетЧто(Реквизиты.ПутьПроекта,
		"существующий путь не перезаписан").Равно("group/project");

КонецПроцедуры

Процедура ОбеспечитьИсточникНормализуетАдрес() Экспорт

	Ссылка = ОбеспечитьИсточник("Тест init нормализация",
		Перечисления.пм_Провайдеры.GitLab,
		"https://gitlab.example.com/",
		"/group/project/");

	Реквизиты = пм_ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "URLСервера, ПутьПроекта");

	ЮТест.ОжидаетЧто(Реквизиты.URLСервера, "хвостовой слеш убран").Равно("https://gitlab.example.com");
	ЮТест.ОжидаетЧто(Реквизиты.ПутьПроекта, "обрамляющие слеши убраны").Равно("group/project");

КонецПроцедуры

Процедура ОбеспечитьИсточникСохраняетПровайдер() Экспорт

	Ссылка = ОбеспечитьИсточник("Тест init github",
		Перечисления.пм_Провайдеры.GitHub,
		"https://github.com",
		"owner/repo");

	ЮТест.ОжидаетЧто(
		пм_ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "Провайдер").Провайдер,
		"провайдер GitHub не подменен умолчанием").Равно(Перечисления.пм_Провайдеры.GitHub);

КонецПроцедуры

Процедура ОбеспечитьИсточникНеПишетТокен() Экспорт

	Ссылка = ОбеспечитьИсточник("Тест init без токена",
		Перечисления.пм_Провайдеры.GitLab,
		"https://gitlab.example.com",
		"group/project");

	ЮТест.ОжидаетЧто(
		пм_ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "ТокенДоступа").ТокенДоступа,
		"карточка создается без токена").НеЗаполнено();

КонецПроцедуры

Процедура ОбеспечитьИсточникНеЗатираетСуществующий() Экспорт

	Объект = Справочники.пм_ИсточникиПакетов.СоздатьЭлемент();
	Объект.Заполнить(Неопределено);
	Объект.Наименование = "Тест init сохранить токен";
	Объект.Провайдер = Перечисления.пм_Провайдеры.GitLab;
	Объект.URLСервера = "https://gitlab.example.com";
	Объект.ПутьПроекта = "group/project";
	Объект.ТокенДоступа = "already-set";
	Объект.Записать();

	Ссылка = ОбеспечитьИсточник("Тест init сохранить токен",
		Перечисления.пм_Провайдеры.GitHub,
		"https://github.com",
		"other/repo");

	Реквизиты = пм_ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка,
		"ТокенДоступа, Провайдер, URLСервера, ПутьПроекта");

	ЮТест.ОжидаетЧто(Ссылка, "найдена существующая карточка").Равно(Объект.Ссылка);
	ЮТест.ОжидаетЧто(Реквизиты.ТокенДоступа, "токен не затерт").Равно("already-set");
	ЮТест.ОжидаетЧто(Реквизиты.Провайдер,
		"провайдер не затерт").Равно(Перечисления.пм_Провайдеры.GitLab);
	ЮТест.ОжидаетЧто(Реквизиты.URLСервера,
		"адрес не затерт").Равно("https://gitlab.example.com");
	ЮТест.ОжидаетЧто(Реквизиты.ПутьПроекта,
		"путь не затерт").Равно("group/project");

КонецПроцедуры

Процедура ОбеспечитьИсточникПустоеИмя() Экспорт

	ВызваноИсключение = Ложь;

	Попытка
		ОбеспечитьИсточник("  ",
			Перечисления.пм_Провайдеры.GitLab,
			"https://gitlab.example.com",
			"group/project");
	Исключение
		ВызваноИсключение = Истина;
	КонецПопытки;

	ЮТест.ОжидаетЧто(ВызваноИсключение,
		"пустое наименование нельзя обеспечить").Равно(Истина);

КонецПроцедуры

Процедура ОбеспечитьТестовыеИсточникиСоздаетОба() Экспорт

	БылиДо = Новый Соответствие;
	Для Каждого Описание Из ОписанияТестовыхИсточников() Цикл
		БылиДо.Вставить(Описание.Наименование,
			Не Справочники.пм_ИсточникиПакетов.НайтиПоНаименованию(
				Описание.Наименование, Истина).Пустая());
	КонецЦикла;

	ОбеспечитьТестовыеИсточники();
	ОбеспечитьТестовыеИсточники();

	Для Каждого Описание Из ОписанияТестовыхИсточников() Цикл

		ЮТест.ОжидаетЧто(КоличествоПоНаименованию(Описание.Наименование),
			"источник " + Описание.Наименование + " без дубликата").Равно(1);

		Если БылиДо.Получить(Описание.Наименование) = Истина Тогда
			Продолжить;
		КонецЕсли;

		Ссылка = Справочники.пм_ИсточникиПакетов.НайтиПоНаименованию(Описание.Наименование, Истина);
		Реквизиты = пм_ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка,
			"Провайдер, URLСервера, ПутьПроекта, ТокенДоступа");

		ЮТест.ОжидаетЧто(Реквизиты.Провайдер).Равно(Описание.Провайдер);
		ЮТест.ОжидаетЧто(Реквизиты.URLСервера).Равно(Описание.URLСервера);
		ЮТест.ОжидаетЧто(Реквизиты.ПутьПроекта).Равно(Описание.ПутьПроекта);
		ЮТест.ОжидаетЧто(Реквизиты.ТокенДоступа,
			"токен в тестовый источник не пишется").НеЗаполнено();

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовоеОписаниеИсточника()

	Описание = Новый Структура;
	Описание.Вставить("Наименование", "");
	Описание.Вставить("Провайдер", Перечисления.пм_Провайдеры.ПустаяСсылка());
	Описание.Вставить("URLСервера", "");
	Описание.Вставить("ПутьПроекта", "");

	Возврат Описание;

КонецФункции

Функция КоличествоПоНаименованию(Наименование)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(Источники.Ссылка) КАК Количество
		|ИЗ
		|	Справочник.пм_ИсточникиПакетов КАК Источники
		|ГДЕ
		|	Источники.Наименование = &Наименование";
	Запрос.УстановитьПараметр("Наименование", Наименование);

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Количество;

КонецФункции

#КонецОбласти
