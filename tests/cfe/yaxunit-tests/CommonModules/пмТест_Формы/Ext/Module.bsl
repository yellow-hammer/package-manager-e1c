// Тесты открытия форм расширения.
//
// Модуль клиентский: ПолучитьФорму работает только на клиенте, а ошибка
// в ПриСозданииНаСервере проявляется именно при построении формы.
// Синтакс-контроль такие ошибки не видит - имя параметра условного
// оформления проверяется в момент выполнения, а не компиляции.
//
// Поймано так: несуществующий параметр "ТекстПодсказки" в условном
// оформлении основной формы валил ее открытие целиком.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьКлиентскийТест("ОсновнаяФормаОткрывается")
		.ДобавитьКлиентскийТест("ФормаГенератораОткрывается")
		.ДобавитьКлиентскийТест("ФормаНастроекОткрывается")
		.ДобавитьКлиентскийТест("ФормаСообщенийОбОшибкахОткрывается")
		.ДобавитьКлиентскийТест("ФормаДлительнойОперацииОткрывается");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ОсновнаяФормаОткрывается() Экспорт

	ПроверитьФорму("Обработка.пм_МенеджерПакетов.Форма.Форма", Неопределено);

КонецПроцедуры

Процедура ФормаГенератораОткрывается() Экспорт

	ПроверитьФорму("Обработка.пм_ГенераторШаблоновПубликации.Форма.Форма", Неопределено);

КонецПроцедуры

Процедура ФормаНастроекОткрывается() Экспорт

	Параметры = Новый Структура("ЛимитВерсий", 20);
	ПроверитьФорму("Обработка.пм_МенеджерПакетов.Форма.Настройки", Параметры);

КонецПроцедуры

Процедура ФормаСообщенийОбОшибкахОткрывается() Экспорт

	Параметры = Новый Структура("Текст", "проверка");
	ПроверитьФорму("Обработка.пм_МенеджерПакетов.Форма.СообщенияОбОшибках", Параметры);

КонецПроцедуры

Процедура ФормаДлительнойОперацииОткрывается() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("ТекстСообщения", "проверка");
	Параметры.Вставить("Заголовок", "Проверка");
	ПроверитьФорму("ОбщаяФорма.пм_ДлительнаяОперация", Параметры);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// ПолучитьФорму строит форму целиком, включая ПриСозданииНаСервере,
// но не показывает ее: тест не оставляет за собой открытых окон.
Процедура ПроверитьФорму(ИмяФормы, ПараметрыФормы)

	Форма = ПолучитьФорму(ИмяФормы, ПараметрыФормы);

	ЮТест.ОжидаетЧто(Форма <> Неопределено, ИмяФормы + " построена").Равно(Истина);
	ЮТест.ОжидаетЧто(Форма.ИмяФормы, "имя построенной формы").Равно(ИмяФормы);

КонецПроцедуры

#КонецОбласти
