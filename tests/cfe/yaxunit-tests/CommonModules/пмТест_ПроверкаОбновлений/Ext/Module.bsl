// Тесты ограничений фоновой установки. Сеть не используется:
// ПакетДопускаетФоновуюУстановку смотрит только на сведения.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьСерверныйТест("БезГалкиФонНеСтавит")
		.ДобавитьСерверныйТест("МенеджерФонНеСтавит")
		.ДобавитьСерверныйТест("БезНовойВерсииФонНеСтавит")
		.ДобавитьСерверныйТест("СГалкойИНовойВерсиейФонСтавит")
		.ДобавитьСерверныйТест("ФлагРасписанияПоУмолчаниюВыключен");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура БезГалкиФонНеСтавит() Экспорт

	Сведения = СведенияПакета("demo", "1.0.0", "1.1.0", Ложь);

	ЮТест.ОжидаетЧто(пм_ПроверкаОбновлений.ПакетДопускаетФоновуюУстановку(Сведения),
		"без галки фон пропускает").Равно(Ложь);

КонецПроцедуры

Процедура МенеджерФонНеСтавит() Экспорт

	ИмяМенеджера = пм_МенеджерПакетовКлиентСервер.ИмяРасширенияМенеджера();
	Сведения = СведенияПакета(ИмяМенеджера, "1.0.0", "1.1.0", Истина);

	ЮТест.ОжидаетЧто(пм_ПроверкаОбновлений.ПакетДопускаетФоновуюУстановку(Сведения),
		"менеджер фон не ставит даже с галкой").Равно(Ложь);

КонецПроцедуры

Процедура БезНовойВерсииФонНеСтавит() Экспорт

	Сведения = СведенияПакета("demo", "1.0.0", "1.0.0", Истина);

	ЮТест.ОжидаетЧто(пм_ПроверкаОбновлений.ПакетДопускаетФоновуюУстановку(Сведения),
		"актуальная версия не ставится").Равно(Ложь);

	Сведения.ДоступнаяВерсия = "";
	ЮТест.ОжидаетЧто(пм_ПроверкаОбновлений.ПакетДопускаетФоновуюУстановку(Сведения),
		"нет доступной версии").Равно(Ложь);

КонецПроцедуры

Процедура СГалкойИНовойВерсиейФонСтавит() Экспорт

	Сведения = СведенияПакета("demo", "1.0.0", "1.1.0", Истина);

	ЮТест.ОжидаетЧто(пм_ПроверкаОбновлений.ПакетДопускаетФоновуюУстановку(Сведения),
		"пакет с галкой и новой версией ставится").Равно(Истина);

КонецПроцедуры

Процедура ФлагРасписанияПоУмолчаниюВыключен() Экспорт

	Было = пм_ПроверкаОбновлений.ОбновлятьОтмеченныеПоРасписанию();
	пм_ПроверкаОбновлений.УстановитьОбновлятьОтмеченныеПоРасписанию(Ложь);

	Попытка
		ЮТест.ОжидаетЧто(пм_ПроверкаОбновлений.ОбновлятьОтмеченныеПоРасписанию(),
			"по умолчанию фон не ставит").Равно(Ложь);

		пм_ПроверкаОбновлений.УстановитьОбновлятьОтмеченныеПоРасписанию(Истина);
		ЮТест.ОжидаетЧто(пм_ПроверкаОбновлений.ОбновлятьОтмеченныеПоРасписанию(),
			"флаг включается").Равно(Истина);
	Исключение
		пм_ПроверкаОбновлений.УстановитьОбновлятьОтмеченныеПоРасписанию(Было);
		ВызватьИсключение;
	КонецПопытки;

	пм_ПроверкаОбновлений.УстановитьОбновлятьОтмеченныеПоРасписанию(Было);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СведенияПакета(ИмяПакета, Версия, ДоступнаяВерсия, Автообновление)

	Сведения = Новый Структура;
	Сведения.Вставить("Пакет", ИмяПакета);
	Сведения.Вставить("Версия", Версия);
	Сведения.Вставить("ДоступнаяВерсия", ДоступнаяВерсия);
	Сведения.Вставить("Автообновление", Автообновление);

	Возврат Сведения;

КонецФункции

#КонецОбласти
