// Тесты справочника источников пакетов.
// Прогон идет в транзакции (см. tools/yaxunit.json), поэтому созданные
// здесь элементы в базе не остаются.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьСерверныйТест("ЗаполнениеПоУмолчанию")
		.ДобавитьСерверныйТест("НормализацияПриЗаписи")
		.ДобавитьСерверныйТест("ОписаниеИсточникаСобираетРеквизиты")
		.ДобавитьСерверныйТест("РежимОдногоПакетаБезФайлаКаталога")
		.ДобавитьСерверныйТест("КэшIDПроектаСбрасываетсяПриСменеПроекта")
		.ДобавитьСерверныйТест("КэшIDПроектаСохраняетсяПриПравкеПрочего")
		.ДобавитьСерверныйТест("ЗапоминаниеIDПроекта")
		.ДобавитьСерверныйТест("ЗапоминаниеОшибки")
		.ДобавитьСерверныйТест("ОписаниеПустогоИсточникаВызываетИсключение");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ЗаполнениеПоУмолчанию() Экспорт

	Объект = Справочники.пм_ИсточникиПакетов.СоздатьЭлемент();
	Объект.Заполнить(Неопределено);

	ЮТест.ОжидаетЧто(Объект.Провайдер, "провайдер по умолчанию")
		.Равно(Перечисления.пм_Провайдеры.GitLab);
	ЮТест.ОжидаетЧто(Объект.ФайлКаталога, "файл каталога по умолчанию").Равно("packages.json");
	ЮТест.ОжидаетЧто(Объект.ВеткаКаталога, "ветка каталога по умолчанию").Равно("main");

КонецПроцедуры

Процедура НормализацияПриЗаписи() Экспорт

	Источник = СоздатьИсточник("Тест нормализации",
		"https://gitlab.example.com/", "/group/project/");

	Реквизиты = пм_ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, "URLСервера, ПутьПроекта");

	ЮТест.ОжидаетЧто(Реквизиты.URLСервера, "хвостовой слеш убран при записи")
		.Равно("https://gitlab.example.com");
	ЮТест.ОжидаетЧто(Реквизиты.ПутьПроекта, "обрамляющие слеши убраны при записи")
		.Равно("group/project");

КонецПроцедуры

Процедура ОписаниеИсточникаСобираетРеквизиты() Экспорт

	Источник = СоздатьИсточник("Тест описания",
		"https://gitlab.example.com", "group/project");

	Описание = Справочники.пм_ИсточникиПакетов.ОписаниеИсточника(Источник);

	ЮТест.ОжидаетЧто(Описание.Ссылка, "ссылка на источник").Равно(Источник);
	ЮТест.ОжидаетЧто(Описание.Наименование, "наименование").Равно("Тест описания");
	ЮТест.ОжидаетЧто(Описание.URLСервера, "адрес сервера").Равно("https://gitlab.example.com");
	ЮТест.ОжидаетЧто(Описание.ПутьПроекта, "путь проекта").Равно("group/project");
	ЮТест.ОжидаетЧто(Описание.Провайдер, "провайдер")
		.Равно(Перечисления.пм_Провайдеры.GitLab);
	ЮТест.ОжидаетЧто(Описание.РежимОдногоПакета, "режим каталога, а не одного пакета").Равно(Ложь);

КонецПроцедуры

Процедура РежимОдногоПакетаБезФайлаКаталога() Экспорт

	Объект = Справочники.пм_ИсточникиПакетов.СоздатьЭлемент();
	Объект.Заполнить(Неопределено);
	Объект.Наименование = "Тест одного пакета";
	Объект.URLСервера = "https://gitlab.example.com";
	Объект.ПутьПроекта = "group/project";
	Объект.ФайлКаталога = "";
	Объект.ИмяПакета = "solution";
	Объект.Записать();

	Описание = Справочники.пм_ИсточникиПакетов.ОписаниеИсточника(Объект.Ссылка);

	ЮТест.ОжидаетЧто(Описание.РежимОдногоПакета,
		"без файла каталога источник работает в режиме одного пакета").Равно(Истина);
	ЮТест.ОжидаетЧто(Описание.ИмяПакета, "имя пакета").Равно("solution");

КонецПроцедуры

Процедура КэшIDПроектаСбрасываетсяПриСменеПроекта() Экспорт

	Источник = СоздатьИсточник("Тест сброса кэша",
		"https://gitlab.example.com", "group/project");

	Справочники.пм_ИсточникиПакетов.ЗапомнитьIDПроекта(Источник, "884");

	// Кэш идентификатора верен только для пары сервер + путь,
	// для которой он получен.
	Объект = Источник.ПолучитьОбъект();
	Объект.ПутьПроекта = "group/other-project";
	Объект.Записать();

	Описание = Справочники.пм_ИсточникиПакетов.ОписаниеИсточника(Источник);

	ЮТест.ОжидаетЧто(Описание.IDПроекта,
		"кэш сброшен после смены пути проекта").НеЗаполнено();

КонецПроцедуры

Процедура КэшIDПроектаСохраняетсяПриПравкеПрочего() Экспорт

	Источник = СоздатьИсточник("Тест сохранения кэша",
		"https://gitlab.example.com", "group/project");

	Справочники.пм_ИсточникиПакетов.ЗапомнитьIDПроекта(Источник, "884");

	// Правка реквизита, не влияющего на адрес проекта, кэш сбрасывать не должна.
	Объект = Источник.ПолучитьОбъект();
	Объект.ВеткаКаталога = "develop";
	Объект.Записать();

	Описание = Справочники.пм_ИсточникиПакетов.ОписаниеИсточника(Источник);

	ЮТест.ОжидаетЧто(Описание.IDПроекта, "кэш сохранен").Равно("884");

КонецПроцедуры

Процедура ЗапоминаниеIDПроекта() Экспорт

	Источник = СоздатьИсточник("Тест запоминания ид",
		"https://gitlab.example.com", "group/project");

	Справочники.пм_ИсточникиПакетов.ЗапомнитьIDПроекта(Источник, "12345");

	ЮТест.ОжидаетЧто(
		пм_ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, "IDПроекта").IDПроекта,
		"идентификатор проекта записан").Равно("12345");

	// Повторная запись того же значения ничего не меняет и не должна падать.
	Справочники.пм_ИсточникиПакетов.ЗапомнитьIDПроекта(Источник, "12345");

	ЮТест.ОжидаетЧто(
		пм_ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, "IDПроекта").IDПроекта,
		"идентификатор не изменился").Равно("12345");

КонецПроцедуры

Процедура ЗапоминаниеОшибки() Экспорт

	Источник = СоздатьИсточник("Тест ошибки",
		"https://gitlab.example.com", "group/project");

	Справочники.пм_ИсточникиПакетов.ЗапомнитьОшибку(Источник, "Проект не найден");

	ЮТест.ОжидаетЧто(
		пм_ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, "ТекстОшибки").ТекстОшибки,
		"текст ошибки записан").Равно("Проект не найден");

	// Успешное обращение очищает ошибку.
	Справочники.пм_ИсточникиПакетов.ЗапомнитьОшибку(Источник, "");

	ЮТест.ОжидаетЧто(
		пм_ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, "ТекстОшибки").ТекстОшибки,
		"ошибка очищена").НеЗаполнено();

КонецПроцедуры

Процедура ОписаниеПустогоИсточникаВызываетИсключение() Экспорт

	ВызваноИсключение = Ложь;

	Попытка
		Справочники.пм_ИсточникиПакетов.ОписаниеИсточника(
			Справочники.пм_ИсточникиПакетов.ПустаяСсылка());
	Исключение
		ВызваноИсключение = Истина;
	КонецПопытки;

	ЮТест.ОжидаетЧто(ВызваноИсключение,
		"описание пустого источника получить нельзя").Равно(Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсточник(Наименование, URLСервера, ПутьПроекта)

	Объект = Справочники.пм_ИсточникиПакетов.СоздатьЭлемент();
	Объект.Заполнить(Неопределено);
	Объект.Наименование = Наименование;
	Объект.URLСервера = URLСервера;
	Объект.ПутьПроекта = ПутьПроекта;
	Объект.Записать();

	Возврат Объект.Ссылка;

КонецФункции

#КонецОбласти
