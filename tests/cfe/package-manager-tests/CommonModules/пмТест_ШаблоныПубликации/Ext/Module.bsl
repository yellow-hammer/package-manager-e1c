// Тесты генерации шаблонов публикации пакетов.
// Проверяется общий модуль пм_ШаблоныПубликацииПакетов и содержимое
// общих макетов, синхронизированных из templates/ci.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьСерверныйТест("ПоддерживаютсяТриСистемыCI")
		.ДобавитьСерверныйТест("ПодстановкиЗаменяютсяВоВсехШаблонах")
		.ДобавитьСерверныйТест("ПлейсхолдеровПослеПодстановкиНеОстается")
		.ДобавитьСерверныйТест("ВыраженияGitHubActionsНеЛомаются")
		.ДобавитьСерверныйТест("НеизвестнаяСистемаВызываетИсключение")
		.ДобавитьСерверныйТест("ИменаФайловРазличаютсяПоСистемам")
		.ДобавитьСерверныйТест("ПодсказкаЗаполненаДляКаждойСистемы")
		.ДобавитьСерверныйТест("ВШаблонахНетСекретов")
		.ДобавитьСерверныйТест("ШаблонGitLabСобираетРасширениеИзИсходников")
		.ДобавитьСерверныйТест("ШаблонGitLabТранслитерируетНеASCIIИмяПакета");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ПоддерживаютсяТриСистемыCI() Экспорт

	Системы = пм_ШаблоныПубликацииПакетов.СистемыCI();

	ЮТест.ОжидаетЧто(Системы.Количество(), "поддерживается три системы CI").Равно(3);

	Для Каждого ЭлементСписка Из Системы Цикл
		ЮТест.ОжидаетЧто(ЭлементСписка.Значение,
			"у системы есть идентификатор").Заполнено();
		ЮТест.ОжидаетЧто(ЭлементСписка.Представление,
			"у системы есть представление").Заполнено();
	КонецЦикла;

КонецПроцедуры

Процедура ПодстановкиЗаменяютсяВоВсехШаблонах() Экспорт

	Параметры = ТестовыеПараметры();

	Для Каждого ЭлементСписка Из пм_ШаблоныПубликацииПакетов.СистемыCI() Цикл

		Текст = пм_ШаблоныПубликацииПакетов.СформироватьШаблон(ЭлементСписка.Значение, Параметры);

		ЮТест.ОжидаетЧто(Текст, "шаблон " + ЭлементСписка.Значение + " не пустой").Заполнено();

		ЮТест.ОжидаетЧто(СтрНайти(Текст, Параметры.PACKAGE_NAME) > 0,
			"имя пакета подставлено в " + ЭлементСписка.Значение).Равно(Истина);
		ЮТест.ОжидаетЧто(СтрНайти(Текст, Параметры.CFE_NAME) > 0,
			"имя файла подставлено в " + ЭлементСписка.Значение).Равно(Истина);
		ЮТест.ОжидаетЧто(СтрНайти(Текст, Параметры.CFE_PATH) > 0,
			"путь к файлу подставлен в " + ЭлементСписка.Значение).Равно(Истина);

	КонецЦикла;

КонецПроцедуры

Процедура ПлейсхолдеровПослеПодстановкиНеОстается() Экспорт

	Параметры = ТестовыеПараметры();

	Для Каждого ЭлементСписка Из пм_ШаблоныПубликацииПакетов.СистемыCI() Цикл

		Текст = пм_ШаблоныПубликацииПакетов.СформироватьШаблон(ЭлементСписка.Значение, Параметры);

		Для Каждого Плейсхолдер Из СтрРазделить("@PACKAGE_NAME@,@CFE_NAME@,@CFE_PATH@", ",") Цикл
			ЮТест.ОжидаетЧто(СтрНайти(Текст, Плейсхолдер),
				Плейсхолдер + " заменен в " + ЭлементСписка.Значение).Равно(0);
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

Процедура ВыраженияGitHubActionsНеЛомаются() Экспорт

	// Разделитель подстановок @...@ выбран так, чтобы не конфликтовать
	// с выражениями GitHub Actions вида ${{ env.CFE_NAME }}.
	Текст = пм_ШаблоныПубликацииПакетов.СформироватьШаблон(
		пм_ШаблоныПубликацииПакетов.СистемаGitHub(), ТестовыеПараметры());

	ЮТест.ОжидаетЧто(СтрНайти(Текст, "${{ env.CFE_NAME }}") > 0,
		"выражение GitHub Actions осталось нетронутым").Равно(Истина);

КонецПроцедуры

Процедура НеизвестнаяСистемаВызываетИсключение() Экспорт

	ВызваноИсключение = Ложь;

	Попытка
		пм_ШаблоныПубликацииПакетов.СформироватьШаблон("TeamCity", ТестовыеПараметры());
	Исключение
		ВызваноИсключение = Истина;
	КонецПопытки;

	ЮТест.ОжидаетЧто(ВызваноИсключение,
		"неизвестная система CI приводит к исключению").Равно(Истина);

КонецПроцедуры

Процедура ИменаФайловРазличаютсяПоСистемам() Экспорт

	ЮТест.ОжидаетЧто(
		пм_ШаблоныПубликацииПакетов.ИмяФайлаШаблона(пм_ШаблоныПубликацииПакетов.СистемаGitLab()),
		"имя файла GitLab").Равно("ci/package.gitlab-ci.yml");

	ЮТест.ОжидаетЧто(
		пм_ШаблоныПубликацииПакетов.ИмяФайлаШаблона(пм_ШаблоныПубликацииПакетов.СистемаJenkins()),
		"имя файла Jenkins").Равно("Jenkinsfile");

КонецПроцедуры

Процедура ПодсказкаЗаполненаДляКаждойСистемы() Экспорт

	Для Каждого ЭлементСписка Из пм_ШаблоныПубликацииПакетов.СистемыCI() Цикл
		ЮТест.ОжидаетЧто(
			пм_ШаблоныПубликацииПакетов.ПодсказкаПоНастройке(ЭлементСписка.Значение),
			"подсказка для " + ЭлементСписка.Значение).Заполнено();
	КонецЦикла;

КонецПроцедуры

Процедура ВШаблонахНетСекретов() Экспорт

	// Требование: шаблоны содержат только имена переменных CI,
	// но не сами токены. Проверяем, что в текстах нет присвоений
	// с похожими на реальный секрет значениями.
	Параметры = ТестовыеПараметры();

	Для Каждого ЭлементСписка Из пм_ШаблоныПубликацииПакетов.СистемыCI() Цикл

		Текст = пм_ШаблоныПубликацииПакетов.СформироватьШаблон(ЭлементСписка.Значение, Параметры);

		// Токены GitLab начинаются с glpat-, GitHub - с ghp_.
		ЮТест.ОжидаетЧто(СтрНайти(Текст, "glpat-"),
			"в шаблоне " + ЭлементСписка.Значение + " нет токена GitLab").Равно(0);
		ЮТест.ОжидаетЧто(СтрНайти(Текст, "ghp_"),
			"в шаблоне " + ЭлементСписка.Значение + " нет токена GitHub").Равно(0);

	КонецЦикла;

КонецПроцедуры

Процедура ШаблонGitLabСобираетРасширениеИзИсходников() Экспорт

	// Сборка: Name из Configuration.xml, файл build/out/cfe/<Name>.cfe.
	Текст = пм_ШаблоныПубликацииПакетов.СформироватьШаблон(
		пм_ШаблоныПубликацииПакетов.СистемаGitLab(), ТестовыеПараметры());

	ЮТест.ОжидаетЧто(СтрНайти(Текст, "compileexttocfe") > 0,
		"шаблон вызывает compileexttocfe").Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(Текст, "src/cfe") > 0,
		"исходники берутся из src/cfe").Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(Текст, "build/out/cfe/") > 0,
		"сборка кладется в build/out/cfe").Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(Текст, "test -f") = 0,
		"шаблон больше не проверяет готовый файл вместо сборки").Равно(Истина);

КонецПроцедуры

Процедура ШаблонGitLabТранслитерируетНеASCIIИмяПакета() Экспорт

	// GitLab Generic не принимает кириллицу. Ключ реестра считается
	// из Name, без списка алиасов в пайплайне.
	Текст = пм_ШаблоныПубликацииПакетов.СформироватьШаблон(
		пм_ШаблоныПубликацииПакетов.СистемаGitLab(), ТестовыеПараметры());

	ЮТест.ОжидаетЧто(СтрНайти(Текст, "ConvertTo-GitLabPackageName") > 0,
		"шаблон транслитерирует Name в ASCII-ключ реестра").Равно(Истина);
	ЮТест.ОжидаетЧто(СтрНайти(Текст, "demo-empty"),
		"в шаблоне нет зашитого алиаса demo-empty").Равно(0);
	ЮТест.ОжидаетЧто(СтрНайти(Текст, "demo-extension"),
		"в шаблоне нет зашитого алиаса demo-extension").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТестовыеПараметры()

	Параметры = пм_ШаблоныПубликацииПакетов.НовыеПараметрыШаблона();
	Параметры.PACKAGE_NAME = "my-package";
	Параметры.CFE_NAME = "my-extension.cfe";
	Параметры.CFE_PATH = "build/out/cfe/my-extension.cfe";

	Возврат Параметры;

КонецФункции

#КонецОбласти
