// Тесты сортировки версий пакетов.
//
// Модуль серверный: сортировка работает с ТаблицейЗначений, а этот тип
// на тонком клиенте недоступен. Разбор и сравнение версий проверяются
// в обоих контекстах - см. пмТест_ВерсииПакетов.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьСерверныйТест("СортировкаОтНовыхКСтарым")
		.ДобавитьСерверныйТест("НесемантическиеУходятВКонецПоДате");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура СортировкаОтНовыхКСтарым() Экспорт

	Таблица = НоваяТаблицаВерсий();
	ДобавитьВерсию(Таблица, "1.0.0", '20240101');
	ДобавитьВерсию(Таблица, "2.0.0", '20240102');
	ДобавитьВерсию(Таблица, "1.0.10", '20240103');
	ДобавитьВерсию(Таблица, "1.0.9", '20240104');
	ДобавитьВерсию(Таблица, "1.0.0-rc1", '20240105');

	пм_ВерсииПакетов.ОтсортироватьВерсии(Таблица);

	ЮТест.ОжидаетЧто(Таблица[0].Номер, "первая - самая новая").Равно("2.0.0");
	ЮТест.ОжидаетЧто(Таблица[1].Номер, "вторая").Равно("1.0.10");
	ЮТест.ОжидаетЧто(Таблица[2].Номер, "третья").Равно("1.0.9");
	ЮТест.ОжидаетЧто(Таблица[3].Номер, "четвертая").Равно("1.0.0");
	ЮТест.ОжидаетЧто(Таблица[4].Номер, "пререлиз младше своего релиза").Равно("1.0.0-rc1");

	// Служебная колонка сортировки не должна остаться в результате.
	ЮТест.ОжидаетЧто(Таблица.Колонки.Найти("пм_КлючСортировки"),
		"служебная колонка удалена").Равно(Неопределено);

КонецПроцедуры

Процедура НесемантическиеУходятВКонецПоДате() Экспорт

	Таблица = НоваяТаблицаВерсий();
	ДобавитьВерсию(Таблица, "latest", '20240101');
	ДобавитьВерсию(Таблица, "1.0.0", '20240102');
	ДобавитьВерсию(Таблица, "package-manager-v0.1.3", '20240103');

	пм_ВерсииПакетов.ОтсортироватьВерсии(Таблица);

	ЮТест.ОжидаетЧто(Таблица[0].Номер, "семантическая версия первая").Равно("1.0.0");

	// Между собой несемантические упорядочены по дате публикации: новее выше.
	ЮТест.ОжидаетЧто(Таблица[1].Номер, "несемантическая новее").Равно("package-manager-v0.1.3");
	ЮТест.ОжидаетЧто(Таблица[2].Номер, "несемантическая старее").Равно("latest");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НоваяТаблицаВерсий()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ДатаСоздания", Новый ОписаниеТипов("Дата"));

	Возврат Таблица;

КонецФункции

Процедура ДобавитьВерсию(Таблица, Номер, ДатаСоздания)

	Строка = Таблица.Добавить();
	Строка.Номер = Номер;
	Строка.ДатаСоздания = ДатаСоздания;

КонецПроцедуры

#КонецОбласти
