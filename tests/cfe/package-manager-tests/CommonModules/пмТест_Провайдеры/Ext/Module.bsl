КонецПроцедуры

Процедура ИменаПакетовИзРелизовGitHub() Экспорт

	Релизы = Новый Массив;
	Релизы.Добавить(РелизGitHub(1, "v1.0.0", Ложь, "alpha.cfe,readme.md"));
	Релизы.Добавить(РелизGitHub(2, "v1.1.0", Ложь, "alpha.cfe,beta.epf"));
	Релизы.Добавить(РелизGitHub(3, "v9.9.9", Истина, "draft.cfe"));
	Релизы.Добавить(РелизGitHub(4, "v1.2.0", Ложь, "ALPHA.CFE"));

	Имена = пм_ПровайдерGitHub.УникальныеИменаПакетовИзРелизов(Релизы);

	ЮТест.ОжидаетЧто(Имена.Количество(), "черновики и повторы отброшены").Равно(2);
	ЮТест.ОжидаетЧто(Имена[0], "первое имя").Равно("alpha");
	ЮТест.ОжидаетЧто(Имена[1], "второе имя").Равно("beta");

	ЮТест.ОжидаетЧто(пм_ПровайдерGitHub.УникальныеИменаПакетовИзРелизов(Неопределено).Количество(),
		"пустой ответ релизов").Равно(0);

КонецПроцедуры

Процедура ВерсииПакетаИзРелизовGitHub() Экспорт

	Релизы = Новый Массив;
	Релизы.Добавить(РелизGitHub(10, "v1.2.0", Ложь, "alpha.cfe"));
	Релизы.Добавить(РелизGitHub(11, "v1.2.0-rc1", Ложь, "alpha.cfe"));
	Релизы.Добавить(РелизGitHub(12, "v1.1.0", Ложь, "beta.epf"));
	Релизы.Добавить(РелизGitHub(13, "v0.9.0", Истина, "alpha.cfe"));

	Версии = пм_ПровайдерGitHub.ВерсииПакетаИзРелизов(
		Релизы, "alpha", пм_ВерсииПакетов.ТипРелизаСтабильный(), 0);

	ЮТест.ОжидаетЧто(Версии.Количество(), "только стабильные alpha").Равно(1);
	ЮТест.ОжидаетЧто(Версии[0].Получить("version"), "версия без v").Равно("1.2.0");
	ЮТест.ОжидаетЧто(Версии[0].Получить("id"), "id релиза").Равно(10);

	Файлы = пм_ПровайдерGitHub.ФайлыРелиза(Релизы[0]);
	ЮТест.ОжидаетЧто(Файлы.Количество(), "файлы релиза").Равно(1);
	ЮТест.ОжидаетЧто(Файлы[0].Получить("file_name"), "имя ассета").Равно("alpha.cfe");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьКонтрактБезСети(Провайдер, URLСервера)

	ЮТест.ОжидаетЧто(Провайдер <> Неопределено,
		"модуль провайдера получен").Равно(Истина);

	// Источник намеренно без пути проекта: проверка отсеет его до обращения
	// к сети. Хождение в сеть в модульном тесте недопустимо.
	Источник = Справочники.пм_ИсточникиПакетов.НовоеОписаниеИсточника();
	Источник.URLСервера = URLСервера;

	Результат = Провайдер.ПроверитьИсточник(Источник);

	ЮТест.ОжидаетЧто(Результат.Свойство("Успешно"),
		"результат содержит признак успеха").Равно(Истина);
	ЮТест.ОжидаетЧто(Результат.Свойство("ТекстОшибки"),
		"результат содержит текст ошибки").Равно(Истина);
	ЮТест.ОжидаетЧто(Результат.Свойство("IDПроекта"),
		"результат содержит идентификатор проекта").Равно(Истина);

	ЮТест.ОжидаетЧто(Результат.Успешно, "источник без пути проекта не проходит проверку").Равно(Ложь);
	ЮТест.ОжидаетЧто(Результат.ТекстОшибки, "текст ошибки заполнен").Заполнено();

КонецПроцедуры

Функция ЗаписьРеестра(ИмяПакета)

	Запись = Новый Соответствие;
	Запись.Вставить("name", ИмяПакета);

	Возврат Запись;

КонецФункции

Функция РелизGitHub(Идентификатор, Тег, Черновик, ИменаАссетов)

	Ассеты = Новый Массив;
	Для Каждого ИмяФайла Из СтрРазделить(ИменаАссетов, ",", Ложь) Цикл
		Ассет = Новый Соответствие;
		Ассет.Вставить("id", Идентификатор * 100 + Ассеты.Количество());
		Ассет.Вставить("name", ИмяФайла);
		Ассеты.Добавить(Ассет);
	КонецЦикла;

	Релиз = Новый Соответствие;
	Релиз.Вставить("id", Идентификатор);
	Релиз.Вставить("tag_name", Тег);
	Релиз.Вставить("draft", Черновик);
	Релиз.Вставить("created_at", "2024-01-01T00:00:00Z");
	Релиз.Вставить("assets", Ассеты);

	Возврат Релиз;

КонецФункции

#КонецОбласти
