КонецПроцедуры

Процедура МодульПровайдераВозвращаетсяДляGitLab() Экспорт

	ПроверитьКонтрактБезСети(
		пм_ПровайдерыПакетов.МодульПровайдера(Перечисления.пм_Провайдеры.GitLab),
		"https://gitlab.example.com");

КонецПроцедуры

Процедура МодульПровайдераВозвращаетсяДляGitHub() Экспорт

	Провайдер = пм_ПровайдерыПакетов.МодульПровайдера(Перечисления.пм_Провайдеры.GitHub);
	ПроверитьКонтрактБезСети(Провайдер, "https://github.com");

	Источник = Справочники.пм_ИсточникиПакетов.НовоеОписаниеИсточника();
	Источник.URLСервера = "https://github.com";
	Источник.ПутьПроекта = "owner/repo/extra";

	Результат = Провайдер.ПроверитьИсточник(Источник);

	ЮТест.ОжидаетЧто(Результат.Успешно,
		"путь длиннее owner/repo не проходит проверку").Равно(Ложь);
	ЮТест.ОжидаетЧто(Результат.ТекстОшибки, "текст ошибки заполнен").Заполнено();

КонецПроцедуры

Процедура МодульНереализованногоПровайдераВызываетИсключение() Экспорт

	ВызваноИсключение = Ложь;

	Попытка
		пм_ПровайдерыПакетов.МодульПровайдера(Перечисления.пм_Провайдеры.ПустаяСсылка());
	Исключение
		ВызваноИсключение = Истина;
	КонецПопытки;

	ЮТест.ОжидаетЧто(ВызваноИсключение,
		"запрос модуля нереализованного провайдера падает").Равно(Истина);

КонецПроцедуры

Процедура ТаймаутЗапросаЗадан() Экспорт

	ЮТест.ОжидаетЧто(пм_ПровайдерыПакетов.ТаймаутЗапроса(),
		"таймаут запроса к провайдеру").Равно(60);

КонецПроцедуры

Процедура ИменаПакетовИзРеестраБезПовторов() Экспорт

	Записи = Новый Массив;
	Записи.Добавить(ЗаписьРеестра("alpha"));
	Записи.Добавить(ЗаписьРеестра("beta"));
	Записи.Добавить(ЗаписьРеестра("alpha"));
	Записи.Добавить(ЗаписьРеестра(""));

	Имена = пм_ПровайдерGitLab.УникальныеИменаПакетов(Записи);

	ЮТест.ОжидаетЧто(Имена.Количество(), "пустые и повторы отброшены").Равно(2);
	ЮТест.ОжидаетЧто(Имена[0], "первое имя").Равно("alpha");
	ЮТест.ОжидаетЧто(Имена[1], "второе имя").Равно("beta");

	ЮТест.ОжидаетЧто(пм_ПровайдерGitLab.УникальныеИменаПакетов(Неопределено).Количество(),
		"пустой ответ реестра").Равно(0);

КонецПроцедуры

Процедура АдресПрограммногоИнтерфейсаGitHub() Экспорт

	ЮТест.ОжидаетЧто(пм_ПровайдерGitHub.АдресПрограммногоИнтерфейса("https://github.com"),
		"github.com").Равно("https://api.github.com");

	ЮТест.ОжидаетЧто(пм_ПровайдерGitHub.АдресПрограммногоИнтерфейса("https://www.github.com"),
		"www.github.com").Равно("https://api.github.com");

	ЮТест.ОжидаетЧто(пм_ПровайдерGitHub.АдресПрограммногоИнтерфейса("https://api.github.com"),
		"api.github.com").Равно("https://api.github.com");

	ЮТест.ОжидаетЧто(пм_ПровайдерGitHub.АдресПрограммногоИнтерфейса("https://ghe.example.com"),
		"свой хост").Равно("https://ghe.example.com/api/v3");

	ЮТест.ОжидаетЧто(пм_ПровайдерGitHub.АдресПрограммногоИнтерфейса("https://ghe.example.com/api/v3"),
		"уже адрес API").Равно("https://ghe.example.com/api/v3");

КонецПроцедуры

Процедура СегментыПутиРепозиторияGitHub() Экспорт

