#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьСерверныйТест("ПровайдерПоУмолчаниюGitLab")
		.ДобавитьСерверныйТест("GitLabРеализован")
		.ДобавитьСерверныйТест("GitHubРеализован")
		.ДобавитьСерверныйТест("ПустойПровайдерНеРеализован")
		.ДобавитьСерверныйТест("МодульПровайдераВозвращаетсяДляGitLab")
		.ДобавитьСерверныйТест("МодульПровайдераВозвращаетсяДляGitHub")
		.ДобавитьСерверныйТест("МодульНереализованногоПровайдераВызываетИсключение")
		.ДобавитьСерверныйТест("ТаймаутЗапросаЗадан")
		.ДобавитьСерверныйТест("ИменаПакетовИзРеестраБезПовторов")
		.ДобавитьСерверныйТест("АдресПрограммногоИнтерфейсаGitHub")
		.ДобавитьСерверныйТест("СегментыПутиРепозиторияGitHub")
		.ДобавитьСерверныйТест("НомерВерсииИзТегаGitHub")
		.ДобавитьСерверныйТест("ИменаПакетовИзРелизовGitHub")
