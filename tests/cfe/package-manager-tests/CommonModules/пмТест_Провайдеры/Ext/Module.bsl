	ЮТест.ОжидаетЧто(Сегменты.Количество(), "два сегмента").Равно(2);
	ЮТест.ОжидаетЧто(Сегменты[0], "владелец").Равно("owner");
	ЮТест.ОжидаетЧто(Сегменты[1], "репозиторий без .git").Равно("repo");

