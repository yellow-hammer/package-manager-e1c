// Тесты диспетчеризации провайдеров пакетов.
// Проверяется общий модуль пм_ПровайдерыПакетов и контракт пм_ПровайдерGitLab.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьСерверныйТест("ПровайдерПоУмолчаниюGitLab")
		.ДобавитьСерверныйТест("GitLabРеализован")
		.ДобавитьСерверныйТест("GitHubИGiteaПокаНеРеализованы")
		.ДобавитьСерверныйТест("МодульПровайдераВозвращаетсяДляGitLab")
		.ДобавитьСерверныйТест("МодульНереализованногоПровайдераВызываетИсключение")
		.ДобавитьСерверныйТест("ТаймаутЗапросаЗадан");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ПровайдерПоУмолчаниюGitLab() Экспорт

	ЮТест.ОжидаетЧто(пм_ПровайдерыПакетов.ПровайдерПоУмолчанию(),
		"провайдер нового источника").Равно(Перечисления.пм_Провайдеры.GitLab);

КонецПроцедуры

Процедура GitLabРеализован() Экспорт

	ЮТест.ОжидаетЧто(
		пм_ПровайдерыПакетов.ПровайдерРеализован(Перечисления.пм_Провайдеры.GitLab),
		"GitLab реализован").Равно(Истина);

КонецПроцедуры

Процедура GitHubИGiteaПокаНеРеализованы() Экспорт

	// Значения заведены в перечислении, чтобы контракт был зафиксирован,
	// но модулей под них еще нет. Тест фиксирует текущее состояние:
	// при появлении провайдера его нужно будет обновить.
	ЮТест.ОжидаетЧто(
		пм_ПровайдерыПакетов.ПровайдерРеализован(Перечисления.пм_Провайдеры.GitHub),
		"GitHub пока не реализован").Равно(Ложь);

	ЮТест.ОжидаетЧто(
		пм_ПровайдерыПакетов.ПровайдерРеализован(Перечисления.пм_Провайдеры.Gitea),
		"Gitea пока не реализован").Равно(Ложь);

	ЮТест.ОжидаетЧто(
		пм_ПровайдерыПакетов.ПровайдерРеализован(Перечисления.пм_Провайдеры.ПустаяСсылка()),
		"пустой провайдер не реализован").Равно(Ложь);

КонецПроцедуры

Процедура МодульПровайдераВозвращаетсяДляGitLab() Экспорт

	Провайдер = пм_ПровайдерыПакетов.МодульПровайдера(Перечисления.пм_Провайдеры.GitLab);

	// ЗначениеЗаполнено к общему модулю неприменима, поэтому сравниваем
	// с Неопределено: именно его вернул бы неудачный поиск модуля.
	ЮТест.ОжидаетЧто(Провайдер <> Неопределено,
		"модуль провайдера получен").Равно(Истина);

	// Контракт провайдера: модуль должен уметь проверить источник.
	// Обращение к несуществующему методу упало бы здесь.
	//
	// Источник намеренно без пути проекта: проверка отсеет его до обращения
	// к сети. Хождение в сеть в модульном тесте недопустимо - прогон стал бы
	// зависеть от доступности внешнего сервиса и упирался бы в таймауты.
	Источник = Справочники.пм_ИсточникиПакетов.НовоеОписаниеИсточника();
	Источник.URLСервера = "https://gitlab.example.com";

	Результат = Провайдер.ПроверитьИсточник(Источник);

	ЮТест.ОжидаетЧто(Результат.Свойство("Успешно"),
		"результат содержит признак успеха").Равно(Истина);
	ЮТест.ОжидаетЧто(Результат.Свойство("ТекстОшибки"),
		"результат содержит текст ошибки").Равно(Истина);
	ЮТест.ОжидаетЧто(Результат.Свойство("IDПроекта"),
		"результат содержит идентификатор проекта").Равно(Истина);

	// Незаполненный источник обязан вернуть неуспех,
	// а не выбросить исключение наружу.
	ЮТест.ОжидаетЧто(Результат.Успешно, "источник без пути проекта не проходит проверку").Равно(Ложь);
	ЮТест.ОжидаетЧто(Результат.ТекстОшибки, "текст ошибки заполнен").Заполнено();

КонецПроцедуры

Процедура МодульНереализованногоПровайдераВызываетИсключение() Экспорт

	ВызваноИсключение = Ложь;

	Попытка
		пм_ПровайдерыПакетов.МодульПровайдера(Перечисления.пм_Провайдеры.GitHub);
	Исключение
		ВызваноИсключение = Истина;
	КонецПопытки;

	ЮТест.ОжидаетЧто(ВызваноИсключение,
		"запрос модуля нереализованного провайдера падает").Равно(Истина);

КонецПроцедуры

Процедура ТаймаутЗапросаЗадан() Экспорт

	// Таймаут описан в требованиях: 60 секунд.
	ЮТест.ОжидаетЧто(пм_ПровайдерыПакетов.ТаймаутЗапроса(),
		"таймаут запроса к провайдеру").Равно(60);

КонецПроцедуры

#КонецОбласти
