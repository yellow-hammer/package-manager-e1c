{
    "$schema": "https://raw.githubusercontent.com/vanessa-opensource/vanessa-runner/develop/xunit-schema.json",
    "Отладка": false,
    "ДелатьЛогВыполненияСценариевВТекстовыйФайл": true,
    "ИмяФайлаЛогВыполненияСценариев": "./build/out/xunit/log.txt",
    "smoke": {
        "Используется": true,
        "СтрогийПорядокВыполнения": true,
        "ОткрываемФормыНаКлиентеТестирования": true,
        "ОтборПоПрефиксу": true,
        "Префикс": "пм_",
        "Документы": false,
        "Отчеты": false,
        "БизнесПроцессы": false,
        "Справочники": {
            "ЗначенияРеквизитовНовых": {
                "пм_ИсточникиПакетов": {
                    "URLСервера": "https://gitlab.example.com",
                    "ПутьПроекта": "group/project"
                }
            }
        },
        "Обработки": [
            "пм_МенеджерПакетов.Форма.Настройки",
            "пм_МенеджерПакетов.Форма.СообщенияОбОшибках"
        ]
    },
    "CommandInterface": {
        "Используется": false
    }
}
